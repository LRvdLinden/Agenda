{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض Weekdot الأحداث في تقويماتك وينشئها ويعدّلها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Weekdot mostra, crea i edita els esdeveniments dels teus calendaris."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot zobrazuje, vytváří a upravuje události ve vašich kalendářích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot viser, opretter og redigerer begivenhederne i dine kalendere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot zeigt, erstellt und bearbeitet die Ereignisse in deinen Kalendern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Weekdot εμφανίζει, δημιουργεί και επεξεργάζεται τα συμβάντα στα ημερολόγιά σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot shows, creates and edits the events in your calendars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot muestra, crea y edita los eventos de tus calendarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot näyttää, luo ja muokkaa kalentereidesi tapahtumia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot affiche, crée et modifie les événements de vos calendriers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot מציג, יוצר ועורך את האירועים בלוחות השנה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot आपके कैलेंडर में इवेंट दिखाता, बनाता और संपादित करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot prikazuje, stvara i uređuje događaje u vašim kalendarima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Weekdot megjeleníti, létrehozza és szerkeszti a naptáraiban lévő eseményeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot menampilkan, membuat, dan mengedit acara di kalender Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot mostra, crea e modifica gli eventi nei tuoi calendari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdotはカレンダー内のイベントを表示、作成、編集します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot은 캘린더의 이벤트를 표시, 생성 및 편집합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot menunjukkan, mencipta dan mengedit acara dalam kalendar anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot viser, oppretter og redigerer hendelsene i kalenderne dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot toont, maakt en wijzigt de activiteiten in je agenda's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot pokazuje, tworzy i edytuje wydarzenia w Twoich kalendarzach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Weekdot mostra, cria e edita os eventos nos seus calendários."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Weekdot mostra, cria e edita os eventos dos seus calendários."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot afișează, creează și editează evenimentele din calendarele dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot показывает, создает и изменяет события в ваших календарях."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot zobrazuje, vytvára a upravuje udalosti vo vašich kalendároch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot visar, skapar och redigerar händelserna i dina kalendrar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot แสดง สร้าง และแก้ไขเหตุการณ์ในปฏิทินของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot, takvimlerinizdeki etkinlikleri gösterir, oluşturur ve düzenler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot показує, створює й редагує події у ваших календарях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot hiển thị, tạo và sửa các sự kiện trong lịch của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot 会显示、创建和编辑你日历中的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot 會顯示、建立和編輯你行事曆中的行程。"
          }
        }
      }
    },
