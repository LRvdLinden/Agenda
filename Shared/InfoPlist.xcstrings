    "NSLocationUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot uses your location to show the weather forecast above your days and the travel time and directions to your events."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot uses your location to show the weather forecast above your days and the travel time and directions to your events."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot shows your reminders with a due date in the calendar."
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot shows your reminders with a due date in the calendar."
          }
        }
      }
    }
  },
  "version": "1.0"
