    "Your saved templates will appear here. Weekdot does not include preloaded templates.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر قوالبك المحفوظة هنا. لا يتضمن Weekdot قوالب محمّلة مسبقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantilles que desis apareixeran aquí. El Weekdot no inclou plantilles predefinides."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde se zobrazí vaše uložené šablony. Weekdot neobsahuje žádné předinstalované šablony."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine gemte skabeloner vises her. Weekdot indeholder ingen forudinstallerede skabeloner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Vorlagen erscheinen hier. Weekdot enthält keine vorinstallierten Vorlagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αποθηκευμένα πρότυπά σας θα εμφανίζονται εδώ. Το Weekdot δεν περιλαμβάνει προφορτωμένα πρότυπα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus plantillas guardadas aparecerán aquí. Weekdot no incluye plantillas predefinidas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentamasi pohjat näkyvät tässä. Weekdot ei sisällä valmiita pohjia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modèles enregistrés apparaîtront ici. Weekdot ne comprend aucun modèle prédéfini."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התבניות ששמרת יופיעו כאן. Weekdot אינו כולל תבניות מוכנות מראש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सहेजे गए टेम्पलेट यहाँ दिखाई देंगे। Weekdot में पहले से लोड किए गए टेम्पलेट शामिल नहीं हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovdje će se pojaviti vaši spremljeni predlošci. Weekdot ne sadrži unaprijed učitane predloške."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt jelennek meg a mentett sablonjai. A Weekdot nem tartalmaz előre telepített sablonokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat yang Anda simpan akan muncul di sini. Weekdot tidak menyertakan templat bawaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi modelli salvati appariranno qui. Weekdot non include modelli preimpostati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したテンプレートがここに表示されます。Weekdotにはあらかじめ用意されたテンプレートはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 템플릿이 여기에 표시됩니다. Weekdot에는 미리 로드된 템플릿이 포함되어 있지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat yang anda simpan akan muncul di sini. Weekdot tidak menyertakan templat pramuat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De arkiverte malene dine vises her. Weekdot inneholder ingen forhåndsinstallerte maler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen sjablonen verschijnen hier. Weekdot bevat geen vooraf ingevulde sjablonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawią się Twoje zachowane szablony. Weekdot nie zawiera gotowych szablonów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus modelos salvos aparecerão aqui. O Weekdot não inclui modelos predefinidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus modelos guardados aparecerão aqui. O Weekdot não inclui modelos predefinidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șabloanele salvate vor apărea aici. Weekdot nu include șabloane predefinite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появятся ваши сохраненные шаблоны. В Weekdot нет предустановленных шаблонов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sa zobrazia vaše uložené šablóny. Weekdot neobsahuje žiadne predinštalované šablóny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina sparade mallar visas här. Weekdot innehåller inga förinstallerade mallar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม่แบบที่คุณบันทึกไว้จะแสดงที่นี่ Weekdot ไม่มีแม่แบบที่โหลดไว้ล่วงหน้า"
          }
