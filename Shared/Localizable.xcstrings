          }
        }
      }
    },
    "Weekdot works with the calendars you already use in the Calendar app: iCloud, Google, Outlook, Exchange and subscriptions. Everything stays in sync through your accounts and iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Weekdot مع التقويمات التي تستخدمها بالفعل في تطبيق التقويم: iCloud وGoogle وOutlook وExchange والاشتراكات. يبقى كل شيء متزامنًا عبر حساباتك وiCloud."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Weekdot funciona amb els calendaris que ja utilitzes a l’app Calendari: iCloud, Google, Outlook, Exchange i subscripcions. Tot es manté sincronitzat amb els teus comptes i iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot funguje s kalendáři, které už používáte v aplikaci Kalendář: iCloud, Google, Outlook, Exchange a odběry. Vše zůstává synchronizované přes vaše účty a iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot fungerer med de kalendere, du allerede bruger i appen Kalender: iCloud, Google, Outlook, Exchange og abonnementer. Alt holdes synkroniseret via dine konti og iCloud."
          }
        },
        "de": {
