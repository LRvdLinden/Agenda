    "Remove this subscription and its Apple Calendar calendar?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إزالة هذا الاشتراك وتقويمه في تقويم Apple؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vols eliminar aquesta subscripció i el seu calendari del Calendari d’Apple?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranit tento odběr a jeho kalendář v Kalendáři Apple?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du fjerne dette abonnement og den tilhørende kalender i Apple Kalender?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Abo und den zugehörigen Kalender in Apple Kalender entfernen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση αυτής της συνδρομής και του ημερολογίου της στο Ημερολόγιο Apple;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta suscripción y su calendario de Calendario de Apple?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko tämä tilaus ja sen kalenteri Applen Kalenterista?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cet abonnement et son calendrier dans Calendrier d’Apple ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להסיר את המינוי הזה ואת לוח השנה שלו בלוח השנה של Apple?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सब्सक्रिप्शन और इसका Apple कैलेंडर हटाएँ?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloniti ovu pretplatu i njezin kalendar u Apple Kalendaru?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja ezt az előfizetést és a hozzá tartozó Apple Naptár-naptárt?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus langganan ini beserta kalendernya di Kalender Apple?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere questa iscrizione e il relativo calendario in Calendario di Apple?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この照会と、そのAppleカレンダーのカレンダーを削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구독과 해당 Apple 캘린더를 제거하겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alih keluar langganan ini dan kalendarnya dalam Kalendar Apple?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du fjerne dette abonnementet og tilhørende kalender i Apple Kalender?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit abonnement en de bijbehorende Apple-agenda verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć tę subskrypcję i jej kalendarz w Kalendarzu Apple?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover esta assinatura e o calendário correspondente no Calendário da Apple?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover esta subscrição e o respetivo calendário no Calendário da Apple?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminați acest abonament și calendarul său din Calendarul Apple?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить эту подписку и ее календарь в Календаре Apple?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstrániť tento odber a jeho kalendár v Kalendári Apple?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du ta bort den här prenumerationen och dess kalender i Apple Kalender?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาการสมัครรับนี้และปฏิทินในปฏิทิน Apple ออกหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu abonelik ve Apple Takvim’deki takvimi kaldırılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучити цю підписку та її календар у Календарі Apple?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa đăng ký này và lịch tương ứng trong Lịch Apple?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除此订阅及其 Apple 日历中的日历吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除此訂閱及其 Apple 行事曆中的行事曆嗎？"
          }
        }
      }
    },
