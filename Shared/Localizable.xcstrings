    "Sevn follows the language of your device. Choose another language in System Settings › General › Language & Region › Applications.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع Sevn لغة جهازك. اختر لغة أخرى من إعدادات النظام › عام › اللغة والمنطقة › التطبيقات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Sevn segueix l’idioma del dispositiu. Tria un altre idioma a Configuració del Sistema › General › Idioma i regió › Aplicacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn používá jazyk vašeho zařízení. Jiný jazyk vyberete v Nastavení systému › Obecné › Jazyk a oblast › Aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn følger sproget på din enhed. Vælg et andet sprog i Systemindstillinger › Generelt › Sprog og område › Apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn verwendet die Sprache deines Geräts. Wähle eine andere Sprache in „Systemeinstellungen“ › „Allgemein“ › „Sprache & Region“ › „Programme“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sevn ακολουθεί τη γλώσσα της συσκευής σας. Επιλέξτε άλλη γλώσσα στις Ρυθμίσεις συστήματος › Γενικά › Γλώσσα και περιοχή › Εφαρμογές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn usa el idioma de tu dispositivo. Elige otro idioma en Ajustes del Sistema › General › Idioma y región › Aplicaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn noudattaa laitteesi kieltä. Valitse toinen kieli kohdassa Järjestelmäasetukset › Yleiset › Kieli ja alue › Apit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn suit la langue de votre appareil. Choisissez une autre langue dans Réglages Système › Général › Langue et région › Applications."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn משתמש בשפת המכשיר שלך. ניתן לבחור שפה אחרת ב״הגדרות המערכת״ › ״כללי״ › ״שפה ואזור״ › ״אפליקציות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn आपके डिवाइस की भाषा का पालन करता है। सिस्टम सेटिंग्ज़ › सामान्य › भाषा और क्षेत्र › ऐप्लिकेशन में कोई दूसरी भाषा चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn prati jezik vašeg uređaja. Drugi jezik odaberite u Postavkama sustava › Općenito › Jezik i regija › Aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sevn az eszköze nyelvét használja. Másik nyelvet a Rendszerbeállítások › Általános › Nyelv és régió › Alkalmazások menüpontban választhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn mengikuti bahasa perangkat Anda. Pilih bahasa lain di Pengaturan Sistem › Umum › Bahasa & Wilayah › Aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn segue la lingua del tuo dispositivo. Scegli un’altra lingua in Impostazioni di Sistema › Generali › Lingua e Zona › Applicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevnはデバイスの言語に従います。ほかの言語は「システム設定」›「一般」›「言語と地域」›「アプリケーション」で選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn은 기기의 언어를 따릅니다. 시스템 설정 › 일반 › 언어 및 지역 › 응용 프로그램에서 다른 언어를 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn mengikut bahasa peranti anda. Pilih bahasa lain dalam Seting Sistem › Umum › Bahasa & Rantau › Aplikasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn følger språket på enheten din. Velg et annet språk i Systeminnstillinger › Generelt › Språk og område › Apper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn volgt de taal van je apparaat. Kies een andere taal in Systeeminstellingen › Algemeen › Taal en regio › Apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn używa języka Twojego urządzenia. Wybierz inny język w Ustawieniach systemowych › Ogólne › Język i region › Aplikacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sevn segue o idioma do seu dispositivo. Escolha outro idioma em Ajustes do Sistema › Geral › Idioma e Região › Aplicativos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sevn segue o idioma do seu dispositivo. Escolha outro idioma em Definições do Sistema › Geral › Idioma e região › Aplicações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn folosește limba dispozitivului dvs. Alegeți altă limbă în Configurări sistem › General › Limbă și regiune › Aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn использует язык вашего устройства. Выберите другой язык в меню «Системные настройки» › «Основные» › «Язык и регион» › «Приложения»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn používa jazyk vášho zariadenia. Iný jazyk vyberiete v Systémových nastaveniach › Všeobecné › Jazyk a oblasť › Aplikácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn följer språket på din enhet. Välj ett annat språk i Systeminställningar › Allmänt › Språk och region › Appar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn ใช้ภาษาตามอุปกรณ์ของคุณ เลือกภาษาอื่นได้ในการตั้งค่าระบบ › ทั่วไป › ภาษาและภูมิภาค › แอปพลิเคชัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn aygıtınızın dilini kullanır. Sistem Ayarları › Genel › Dil ve Bölge › Uygulamalar bölümünden başka bir dil seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn використовує мову вашого пристрою. Виберіть іншу мову в меню «Системні параметри» › «Загальні» › «Мова й регіон» › «Програми»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn dùng ngôn ngữ của thiết bị. Chọn ngôn ngữ khác trong Cài đặt hệ thống › Cài đặt chung › Ngôn ngữ & Vùng › Ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn 跟随设备的语言。请在“系统设置” › 通用 › 语言与地区 › App 中选择其他语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn 會跟隨裝置的語言。請在「系統設定」› 一般 › 語言與地區 › App 中選擇其他語言。"
          }
        }
      }
    },
    "Sevn follows the language of your device. You can pick another language for Sevn only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع Sevn لغة جهازك. يمكنك اختيار لغة أخرى لـ Sevn فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Sevn segueix l’idioma del dispositiu. Pots triar un altre idioma només per al Sevn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn používá jazyk vašeho zařízení. Můžete zvolit jiný jazyk jen pro Sevn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn følger sproget på din enhed. Du kan vælge et andet sprog kun til Sevn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn verwendet die Sprache deines Geräts. Du kannst eine andere Sprache nur für Sevn wählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sevn ακολουθεί τη γλώσσα της συσκευής σας. Μπορείτε να επιλέξετε άλλη γλώσσα μόνο για το Sevn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn usa el idioma de tu dispositivo. Puedes elegir otro idioma solo para Sevn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn noudattaa laitteesi kieltä. Voit valita toisen kielen pelkästään Sevnille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn suit la langue de votre appareil. Vous pouvez choisir une autre langue pour Sevn uniquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn משתמש בשפת המכשיר שלך. ניתן לבחור שפה אחרת עבור Sevn בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn आपके डिवाइस की भाषा का पालन करता है। आप केवल Sevn के लिए कोई दूसरी भाषा चुन सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn prati jezik vašeg uređaja. Možete odabrati drugi jezik samo za Sevn."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sevn az eszköze nyelvét használja. Választhat másik nyelvet csak a Sevn számára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn mengikuti bahasa perangkat Anda. Anda dapat memilih bahasa lain khusus untuk Sevn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn segue la lingua del tuo dispositivo. Puoi scegliere un’altra lingua solo per Sevn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevnはデバイスの言語に従います。Sevnだけに別の言語を選択することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn은 기기의 언어를 따릅니다. Sevn에만 다른 언어를 선택할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn mengikut bahasa peranti anda. Anda boleh memilih bahasa lain untuk Sevn sahaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn følger språket på enheten din. Du kan velge et annet språk bare for Sevn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn volgt de taal van je apparaat. Je kunt een andere taal kiezen alleen voor Sevn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn używa języka Twojego urządzenia. Możesz wybrać inny język tylko dla Sevn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sevn segue o idioma do seu dispositivo. Você pode escolher outro idioma apenas para o Sevn."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sevn segue o idioma do seu dispositivo. Pode escolher outro idioma apenas para o Sevn."
