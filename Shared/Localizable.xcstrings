    "Your events go only to your own Homey, through Homey's own connection. Weekdot does not keep a copy.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسل مواعيدك إلى جهاز Homey الخاص بك فقط عبر اتصال Homey نفسه. لا يحتفظ Weekdot بأي نسخة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els teus esdeveniments només van al teu Homey, per la connexió de Homey. Weekdot no en guarda cap còpia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Události jdou jen do tvého Homey, přes vlastní připojení Homey. Weekdot si kopii nenechává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine begivenheder sendes kun til din egen Homey via Homeys egen forbindelse. Weekdot gemmer ingen kopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Termine gehen nur an deinen eigenen Homey, über Homeys eigene Verbindung. Weekdot behält keine Kopie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα γεγονότα σου πηγαίνουν μόνο στο δικό σου Homey, μέσω της σύνδεσης του Homey. Το Weekdot δεν κρατά αντίγραφο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus eventos solo van a tu propio Homey, a través de la conexión de Homey. Weekdot no guarda ninguna copia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtumasi menevät vain omaan Homeyhisi Homeyn oman yhteyden kautta. Weekdot ei säilytä kopiota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos événements vont uniquement à votre Homey, via la connexion propre de Homey. Weekdot n'en garde aucune copie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האירועים שלך נשלחים רק ל-Homey שלך, דרך החיבור של Homey עצמו. Weekdot לא שומר עותק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके इवेंट सिर्फ़ आपके अपने Homey पर, Homey के अपने कनेक्शन से जाते हैं। Weekdot कोई कॉपी नहीं रखता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Događaji idu samo na tvoj Homey, preko vlastite veze Homeyja. Weekdot ne čuva kopiju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az események csak a saját Homeydra kerülnek, a Homey saját kapcsolatán keresztül. A Weekdot nem tart meg másolatot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara Anda hanya dikirim ke Homey Anda sendiri melalui koneksi Homey. Weekdot tidak menyimpan salinan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi eventi vanno solo al tuo Homey, tramite la connessione di Homey. Weekdot non ne conserva copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定はHomey独自の接続を通じて、あなたのHomeyにだけ送られます。Weekdotはコピーを保持しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정은 Homey 자체 연결을 통해 내 Homey로만 전송됩니다. Weekdot은 사본을 보관하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara anda hanya dihantar ke Homey anda sendiri melalui sambungan Homey. Weekdot tidak menyimpan salinan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avtalene dine går bare til din egen Homey, via Homeys egen tilkobling. Weekdot beholder ingen kopi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je afspraken gaan alleen naar je eigen Homey, via de eigen verbinding van Homey. Weekdot houdt geen kopie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzenia trafiają tylko do Twojego Homey, przez własne połączenie Homey. Weekdot nie przechowuje kopii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus eventos vão só para o seu Homey, pela conexão do próprio Homey. O Weekdot não guarda cópia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus eventos vão apenas para o seu Homey, pela ligação do próprio Homey. O Weekdot não guarda cópia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evenimentele tale ajung doar la propriul Homey, prin conexiunea Homey. Weekdot nu păstrează nicio copie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События отправляются только на ваш Homey через собственное подключение Homey. Weekdot не хранит копию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udalosti idú len do tvojho Homey, cez vlastné pripojenie Homey. Weekdot si kópiu nenecháva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina händelser skickas bara till din egen Homey, via Homeys egen anslutning. Weekdot sparar ingen kopia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมของคุณจะถูกส่งไปยัง Homey ของคุณเองเท่านั้น ผ่านการเชื่อมต่อของ Homey Weekdot ไม่เก็บสำเนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinliklerin yalnızca kendi Homey'ine, Homey'nin kendi bağlantısıyla gider. Weekdot kopya tutmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Події надсилаються лише на ваш Homey через власне підключення Homey. Weekdot не зберігає копію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện chỉ được gửi đến Homey của bạn, qua kết nối riêng của Homey. Weekdot không giữ bản sao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的日程只会通过 Homey 自己的连接发送到你自己的 Homey。Weekdot 不保留副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的行程只會透過 Homey 本身的連線傳送到你自己的 Homey。Weekdot 不保留副本。"
          }
        }
      }
    },
