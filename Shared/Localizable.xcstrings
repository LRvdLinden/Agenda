          "stringUnit": {
            "state": "translated",
            "value": "Weekdot dùng ngôn ngữ của thiết bị. Bạn có thể chọn ngôn ngữ khác chỉ cho Weekdot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot 跟随设备的语言。你可以仅为 Weekdot 选择其他语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot 會跟隨裝置的語言。你可以只為 Weekdot 選擇其他語言。"
          }
        }
      }
    },
