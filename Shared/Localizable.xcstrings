    "Allow access to your calendars to see your events.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى التقويمات لرؤية أحداثك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet l’accés als calendaris per veure els teus esdeveniments."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup ke kalendářům, abyste viděli své události."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv adgang til dine kalendere for at se dine begivenheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf deine Kalender, um deine Ereignisse zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε την πρόσβαση στα ημερολόγιά σας για να βλέπετε τα συμβάντα σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a tus calendarios para ver tus eventos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli kalentereiden käyttö, jotta näet tapahtumasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à vos calendriers pour voir vos événements."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאפשר גישה ללוחות השנה כדי לראות את האירועים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने इवेंट देखने के लिए अपने कैलेंडर तक ऐक्सेस की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite pristup kalendarima kako biste vidjeli svoje događaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a hozzáférést a naptáraihoz az események megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses ke kalender Anda untuk melihat acara Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso ai tuoi calendari per vedere i tuoi eventi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントを表示するには、カレンダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트를 보려면 캘린더에 대한 접근을 허용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan akses kepada kalendar anda untuk melihat acara anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang til kalenderne dine for å se hendelsene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang tot je agenda's om je activiteiten te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do kalendarzy, aby widzieć swoje wydarzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos seus calendários para ver seus eventos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos seus calendários para ver os seus eventos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți accesul la calendare pentru a vă vedea evenimentele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к календарям, чтобы видеть свои события."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte prístup ku kalendárom, aby ste videli svoje udalosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst till dina kalendrar för att se dina händelser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้เข้าถึงปฏิทินของคุณเพื่อดูเหตุการณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinliklerinizi görmek için takvimlerinize erişime izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте доступ до календарів, щоб бачити свої події."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập lịch để xem các sự kiện của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问你的日历以查看日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許取用你的行事曆以查看行程。"
          }
        }
      }
    },
    "Allow full Calendar access in Settings to mirror subscriptions into Apple Calendar.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول الكامل إلى التقويم في الإعدادات لنسخ الاشتراكات إلى تقويم Apple."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet l’accés complet al calendari a Configuració per replicar les subscripcions al Calendari d’Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li zrcadlit odběry do Kalendáře Apple, povolte v Nastavení plný přístup ke Kalendáři."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv fuld adgang til Kalender i Indstillinger for at spejle abonnementer til Apple Kalender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube in den Einstellungen den vollen Kalenderzugriff, um Abos in Apple Kalender zu spiegeln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε την πλήρη πρόσβαση στο Ημερολόγιο στις Ρυθμίσεις για να αντιγράφονται οι συνδρομές στο Ημερολόγιο Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso completo al calendario en Ajustes para copiar las suscripciones en Calendario de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli täysi pääsy Kalenteriin Asetuksissa, jotta tilaukset voidaan peilata Applen Kalenteriin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès complet au calendrier dans Réglages pour copier les abonnements dans Calendrier d’Apple."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר גישה מלאה ללוח השנה בהגדרות כדי לשקף מינויים ללוח השנה של Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब्सक्रिप्शन को Apple कैलेंडर में मिरर करने के लिए सेटिंग्ज़ में कैलेंडर का पूरा ऐक्सेस दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite potpuni pristup Kalendaru u Postavkama kako bi se pretplate preslikale u Apple Kalendar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a teljes Naptár-hozzáférést a Beállításokban, hogy az előfizetések megjelenjenek az Apple Naptárban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses Kalender penuh di Pengaturan untuk menyalin langganan ke Kalender Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso completo al calendario in Impostazioni per copiare le iscrizioni in Calendario di Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照会をAppleカレンダーにミラーリングするには、設定でカレンダーへのフルアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독을 Apple 캘린더에 미러링하려면 설정에서 캘린더 전체 접근을 허용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan akses Kalendar penuh dalam Seting untuk menyalin langganan ke Kalendar Apple."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi full tilgang til Kalender i Innstillinger for å speile abonnementer til Apple Kalender."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta volledige agendatoegang toe in Instellingen om abonnementen naar Apple Agenda te kopiëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na pełny dostęp do Kalendarza w Ustawieniach, aby odzwierciedlać subskrypcje w Kalendarzu Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso total ao calendário em Ajustes para espelhar as assinaturas no Calendário da Apple."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso total ao calendário nas Definições para espelhar as subscrições no Calendário da Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți accesul complet la Calendar în Configurări pentru a copia abonamentele în Calendarul Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите полный доступ к Календарю в Настройках, чтобы копировать подписки в Календарь Apple."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete zrkadliť odbery do Kalendára Apple, povoľte v Nastaveniach plný prístup ku Kalendáru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge fullständig åtkomst till Kalender i Inställningar för att spegla prenumerationer till Apple Kalender."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงปฏิทินแบบเต็มในการตั้งค่าเพื่อคัดลอกการสมัครรับไปยังปฏิทิน Apple"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikleri Apple Takvim’e yansıtmak için Ayarlar’da Takvim’e tam erişim izni verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте повний доступ до Календаря в Параметрах, щоб копіювати підписки в Календар Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập toàn bộ Lịch trong Cài đặt để sao chép các đăng ký sang Lịch Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许完全访问日历，以便将订阅同步到 Apple 日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許完整取用行事曆，以將訂閱同步到 Apple 行事曆。"
          }
        }
      }
    },
