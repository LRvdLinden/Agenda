    "Tap a country to subscribe. Weather is shown in the week view when you turn it on in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على بلد للاشتراك. يظهر الطقس في عرض الأسبوع عند تشغيله في الإعدادات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un país per subscriure-t’hi. El temps es mostra a la vista de setmana quan l’actives a Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na zemi ji začnete odebírat. Počasí se zobrazí v zobrazení týdne, když ho zapnete v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et land for at abonnere. Vejret vises i ugeoversigten, når du slår det til i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Land, um es zu abonnieren. Das Wetter wird in der Wochenansicht angezeigt, wenn du es in den Einstellungen aktivierst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε μια χώρα για να εγγραφείτε. Ο καιρός εμφανίζεται στην προβολή εβδομάδας όταν τον ενεργοποιήσετε στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un país para suscribirte. El tiempo se muestra en la vista Semana si lo activas en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaa napauttamalla maata. Sää näkyy viikkonäkymässä, kun laitat sen päälle Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un pays pour vous abonner. La météo s’affiche dans la vue Semaine lorsque vous l’activez dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש/י על מדינה כדי להירשם. מזג האוויר מוצג בתצוגת שבוע כשמפעילים אותו ב״הגדרות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब्सक्राइब करने के लिए किसी देश पर टैप करें। सेटिंग्ज़ में चालू करने पर सप्ताह दृश्य में मौसम दिखाया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite državu za pretplatu. Vrijeme se prikazuje u prikazu tjedna kada ga uključite u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson egy országra a feliratkozáshoz. Az időjárás a heti nézetben jelenik meg, ha bekapcsolja a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk negara untuk berlangganan. Cuaca ditampilkan di tampilan minggu saat Anda menyalakannya di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un paese per iscriverti. Il meteo viene mostrato nella vista Settimana quando lo attivi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国または地域をタップして照会します。「設定」で天気をオンにすると、週表示に天気が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독하려면 국가를 탭하십시오. 설정에서 날씨를 켜면 주 보기에 날씨가 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik negara untuk melanggan. Cuaca ditunjukkan dalam paparan minggu apabila anda menghidupkannya dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et land for å abonnere. Været vises i ukevisningen når du slår det på i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een land om je te abonneren. Het weer wordt in de weekweergave getoond als je dit aanzet in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij kraj, aby go subskrybować. Pogoda jest pokazywana w widoku tygodnia, gdy włączysz ją w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um país para assinar. O clima aparece na visualização de semana quando você o ativa em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num país para subscrever. A meteorologia é mostrada na vista Semana quando a ativa nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați pe o țară pentru a vă abona. Vremea este afișată în vizualizarea săptămână când o activați în Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь страны, чтобы подписаться. Погода отображается в режиме «Неделя», если включить ее в Настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na krajinu ju začnete odoberať. Počasie sa zobrazí v zobrazení týždňa, keď ho zapnete v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ett land för att prenumerera. Vädret visas i veckovyn när du slår på det i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะประเทศเพื่อสมัครรับ สภาพอากาศจะแสดงในมุมมองสัปดาห์เมื่อคุณเปิดใช้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abone olmak için bir ülkeye dokunun. Ayarlar’da açtığınızda hava durumu hafta görüntüsünde gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться країни, щоб підписатися. Погода показується в режимі «Тиждень», якщо ввімкнути її в Параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một quốc gia để đăng ký. Thời tiết được hiển thị trong chế độ xem tuần khi bạn bật trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一个国家或地区以订阅。在“设置”中打开天气后，周视图中会显示天气。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下國家或地區來訂閱。在「設定」中開啟天氣後，週視圖會顯示天氣。"
          }
        }
      }
    },
    "Tap a time or day to paste “%@”": {
      "extractionState": "manual",
