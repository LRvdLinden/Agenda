    "Seven days at a glance.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبعة أيام في لمحة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Set dies d’un cop d’ull."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedm dní na první pohled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Syv dage på ét blik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieben Tage auf einen Blick."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επτά ημέρες με μια ματιά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siete días de un vistazo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitsemän päivää yhdellä silmäyksellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sept jours en un coup d’œil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שבעה ימים במבט אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नज़र में सात दिन।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedam dana na prvi pogled."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hét nap egy pillantással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tujuh hari dalam sekejap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sette giorni a colpo d’occhio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間をひと目で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일을 한눈에."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tujuh hari sepintas lalu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sju dager på et øyeblikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeven dagen in één oogopslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siedem dni w jednym rzucie oka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sete dias num relance."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sete dias num relance."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șapte zile dintr-o privire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семь дней с первого взгляда."
          }
        },
        "sk": {
          "stringUnit": {
