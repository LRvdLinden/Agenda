    "Nothing planned for this day.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء مخطط لهذا اليوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha res previst per a aquest dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tento den není nic naplánováno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet planlagt denne dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Tag ist nichts geplant."
          }
        },
