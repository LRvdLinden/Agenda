    "Nothing planned in the next 60 days.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء مخطط له في الأيام الـ 60 القادمة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha res previst en els propers 60 dies."
          }
        },
        "cs": {
