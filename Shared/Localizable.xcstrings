    "Delete this calendar and all its events?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف هذا التقويم وكل أحداثه؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vols eliminar aquest calendari i tots els seus esdeveniments?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat tento kalendář a všechny jeho události?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du slette denne kalender og alle dens begivenheder?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Kalender und alle Ereignisse löschen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγραφή αυτού του ημερολογίου και όλων των συμβάντων του;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este calendario y todos sus eventos?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko tämä kalenteri ja kaikki sen tapahtumat?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce calendrier et tous ses événements ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק את לוח השנה הזה ואת כל האירועים שבו?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कैलेंडर और इसके सभी इवेंट डिलीट करें?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrisati ovaj kalendar i sve njegove događaje?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli ezt a naptárat és minden eseményét?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus kalender ini dan semua acaranya?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questo calendario e tutti i suoi eventi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカレンダーとそのすべてのイベントを削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 캘린더와 모든 이벤트를 삭제하겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam kalendar ini dan semua acaranya?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du slette denne kalenderen og alle hendelsene i den?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze agenda en al zijn activiteiten verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć ten kalendarz i wszystkie jego wydarzenia?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar este calendário e todos os seus eventos?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar este calendário e todos os seus eventos?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergeți acest calendar și toate evenimentele sale?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить этот календарь и все его события?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymazať tento kalendár a všetky jeho udalosti?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du radera kalendern och alla dess händelser?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบปฏิทินนี้และเหตุการณ์ทั้งหมดหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu takvim ve tüm etkinlikleri silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цей календар і всі його події?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa lịch này và tất cả sự kiện của lịch?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除此日历及其所有日程吗？"
          }
        },
