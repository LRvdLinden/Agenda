    "Weekdot calendars sync through iCloud on all your devices with Weekdot.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة تقويمات Weekdot عبر iCloud على جميع أجهزتك التي عليها Weekdot."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els calendaris del Weekdot se sincronitzen amb l’iCloud a tots els teus dispositius amb el Weekdot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendáře Weekdot se synchronizují přes iCloud na všech vašich zařízeních s Weekdotem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot-kalendere synkroniseres via iCloud på alle dine enheder med Weekdot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot-Kalender werden über iCloud auf all deinen Geräten mit Weekdot synchronisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ημερολόγια Weekdot συγχρονίζονται μέσω iCloud σε όλες τις συσκευές σας με το Weekdot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los calendarios de Weekdot se sincronizan mediante iCloud en todos tus dispositivos con Weekdot."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot-kalenterit synkronoituvat iCloudin kautta kaikilla laitteillasi, joilla on Weekdot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calendriers Weekdot se synchronisent via iCloud sur tous vos appareils dotés de Weekdot."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוחות השנה של Weekdot מסתנכרנים דרך iCloud בכל המכשירים שלך שבהם מותקן Weekdot."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot कैलेंडर iCloud के ज़रिए आपके उन सभी डिवाइस पर सिंक होते हैं जिनमें Weekdot है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kalendari sinkroniziraju se putem iCloud-a na svim vašim uređajima s Weekdotom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Weekdot-naptárak az iCloudon keresztül szinkronizálódnak minden olyan eszközén, amelyen a Weekdot fut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender Weekdot diselaraskan melalui iCloud di semua perangkat Anda yang memiliki Weekdot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I calendari Weekdot si sincronizzano tramite iCloud su tutti i tuoi dispositivi con Weekdot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekdotのカレンダーはiCloud経由で、Weekdotを使用しているすべてのデバイスと同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot 캘린더는 iCloud를 통해 Weekdot을 사용하는 모든 기기에서 동기화됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar Weekdot diselaraskan melalui iCloud pada semua peranti anda yang mempunyai Weekdot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot-kalendere synkroniseres via iCloud på alle enhetene dine med Weekdot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot-agenda's synchroniseren via iCloud op al je apparaten met Weekdot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendarze Weekdot są synchronizowane przez iCloud na wszystkich Twoich urządzeniach z Weekdot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os calendários do Weekdot são sincronizados pelo iCloud em todos os seus dispositivos com o Weekdot."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os calendários Weekdot sincronizam através da iCloud em todos os seus dispositivos com o Weekdot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendarele Weekdot se sincronizează prin iCloud pe toate dispozitivele tale cu Weekdot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Календари Weekdot синхронизируются через iCloud на всех Ваших устройствах с Weekdot."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendáre Weekdot sa synchronizujú cez iCloud na všetkých vašich zariadeniach s Weekdotom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot-kalendrar synkroniseras via iCloud på alla dina enheter med Weekdot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทิน Weekdot จะซิงค์ผ่าน iCloud บนอุปกรณ์ทุกเครื่องของคุณที่มี Weekdot"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot takvimleri, Weekdot yüklü tüm aygıtlarınızda iCloud üzerinden eşzamanlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Календарі Weekdot синхронізуються через iCloud на всіх ваших пристроях із Weekdot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch Weekdot đồng bộ qua iCloud trên tất cả các thiết bị có Weekdot của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot日历通过iCloud在你所有装有Weekdot的设备上同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot行事曆會透過iCloud在你所有裝有Weekdot的裝置上同步。"
          }
        }
      }
    },
    "Weekdot copies the events to a separate writable Apple calendar. It checks for changes when opened and during background refresh opportunities, which iOS does not guarantee.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينسخ Weekdot الأحداث إلى تقويم Apple منفصل قابل للكتابة. يتحقق من التغييرات عند الفتح وخلال فرص التحديث في الخلفية التي لا يضمنها iOS."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Weekdot copia els esdeveniments a un calendari d’Apple separat i editable. Comprova si hi ha canvis en obrir-se i durant les oportunitats d’actualització en segon pla, que l’iOS no garanteix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopíruje události do samostatného zapisovatelného kalendáře Apple. Změny kontroluje při otevření a při příležitostech k obnovení na pozadí, které iOS nezaručuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopierer begivenhederne til en separat Apple-kalender med skriveadgang. Den tjekker for ændringer, når den åbnes, og når der er mulighed for baggrundsopdatering, hvilket iOS ikke garanterer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopiert die Ereignisse in einen separaten, beschreibbaren Apple-Kalender. Es prüft beim Öffnen und bei Gelegenheiten zur Hintergrundaktualisierung auf Änderungen, die iOS nicht garantiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Weekdot αντιγράφει τα συμβάντα σε ξεχωριστό εγγράψιμο ημερολόγιο Apple. Ελέγχει για αλλαγές κατά το άνοιγμα και κατά τις ευκαιρίες ανανέωσης στο παρασκήνιο, τις οποίες το iOS δεν εγγυάται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot copia los eventos en un calendario de Apple independiente y editable. Busca cambios al abrirse y durante las actualizaciones en segundo plano, que iOS no garantiza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopioi tapahtumat erilliseen kirjoitettavaan Apple-kalenteriin. Se tarkistaa muutokset avattaessa ja taustapäivitysten yhteydessä, joita iOS ei takaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot copie les événements dans un calendrier Apple distinct et modifiable. Il recherche les modifications à l’ouverture et lors des actualisations en arrière-plan, qu’iOS ne garantit pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot מעתיק את האירועים ללוח שנה נפרד של Apple עם הרשאת כתיבה. הוא בודק שינויים בעת הפתיחה ובהזדמנויות רענון ברקע, ש-iOS אינו מבטיח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot इवेंट को एक अलग, लिखने योग्य Apple कैलेंडर में कॉपी करता है। यह खोलने पर और बैकग्राउंड रीफ़्रेश के मौकों पर बदलावों की जाँच करता है, जिनकी iOS गारंटी नहीं देता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopira događaje u zaseban Apple kalendar s mogućnošću pisanja. Promjene provjerava pri otvaranju i tijekom osvježavanja u pozadini, koje iOS ne jamči."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Weekdot az eseményeket egy külön, írható Apple-naptárba másolja. A változásokat megnyitáskor és háttérfrissítési lehetőségek idején ellenőrzi, ezeket azonban az iOS nem garantálja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot menyalin acara ke kalender Apple terpisah yang dapat ditulis. Perubahan diperiksa saat dibuka dan saat ada kesempatan penyegaran di latar belakang, yang tidak dijamin oleh iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot copia gli eventi in un calendario Apple separato e modificabile. Controlla le modifiche all’apertura e durante gli aggiornamenti in background, che iOS non garantisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdotはイベントを書き込み可能な別のAppleカレンダーにコピーします。変更は、開いたときと、バックグラウンド更新の機会に確認されます（iOSはこの機会を保証しません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot은 이벤트를 쓰기 가능한 별도의 Apple 캘린더에 복사합니다. 앱을 열 때와 백그라운드 새로 고침 기회가 있을 때 변경 사항을 확인하며, iOS는 이러한 기회를 보장하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot menyalin acara ke kalendar Apple berasingan yang boleh ditulis. Perubahan disemak apabila dibuka dan semasa peluang penyegaran latar belakang, yang tidak dijamin oleh iOS."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopierer hendelsene til en egen Apple-kalender med skrivetilgang. Den ser etter endringer når den åpnes og når det er mulighet for bakgrunnsoppdatering, noe iOS ikke garanterer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopieert afspraken naar een eigen beschrijfbare Apple-agenda. Updates worden gecontroleerd bij het openen en tijdens toegestane achtergrondmomenten; iOS garandeert die momenten niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopiuje wydarzenia do osobnego kalendarza Apple z prawem zapisu. Sprawdza zmiany przy otwarciu oraz przy okazji odświeżania w tle, którego iOS nie gwarantuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Weekdot copia os eventos para um calendário da Apple separado e editável. Ele verifica alterações ao ser aberto e durante as oportunidades de atualização em segundo plano, que o iOS não garante."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Weekdot copia os eventos para um calendário da Apple separado e editável. Verifica se há alterações ao abrir e durante as oportunidades de atualização em segundo plano, que o iOS não garante."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot copiază evenimentele într-un calendar Apple separat, cu drept de scriere. Verifică modificările la deschidere și în timpul reîmprospătărilor în fundal, pe care iOS nu le garantează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot копирует события в отдельный календарь Apple с правом записи. Изменения проверяются при открытии и во время фонового обновления, которое iOS не гарантирует."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopíruje udalosti do samostatného zapisovateľného kalendára Apple. Zmeny kontroluje pri otvorení a pri príležitostiach na obnovenie na pozadí, ktoré iOS nezaručuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopierar händelserna till en separat Apple-kalender med skrivbehörighet. Den söker efter ändringar när den öppnas och vid tillfällen för bakgrundsuppdatering, vilket iOS inte garanterar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot คัดลอกเหตุการณ์ไปยังปฏิทิน Apple แยกต่างหากที่เขียนได้ โดยจะตรวจสอบการเปลี่ยนแปลงเมื่อเปิดแอปและเมื่อมีโอกาสรีเฟรชในเบื้องหลัง ซึ่ง iOS ไม่รับประกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot etkinlikleri ayrı, yazılabilir bir Apple takvimine kopyalar. Değişiklikleri açılışta ve iOS’un garanti etmediği arka plan yenileme fırsatlarında denetler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot копіює події в окремий календар Apple із правом запису. Зміни перевіряються під час відкриття та фонового оновлення, яке iOS не гарантує."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot sao chép các sự kiện vào một lịch Apple riêng có thể ghi. Ứng dụng kiểm tra thay đổi khi được mở và khi có cơ hội làm mới trong nền, điều mà iOS không đảm bảo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot 会将日程复制到一个单独的可写入 Apple 日历中。它会在打开时以及后台刷新机会出现时检查更改，但 iOS 不保证这些机会。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot 會將行程拷貝到另一個可寫入的 Apple 行事曆。它會在打開時以及有背景重新整理機會時檢查變更，但 iOS 不保證有這些機會。"
          }
        }
      }
    },
    "Weekdot follows the language of your device. Choose another language in System Settings › General › Language & Region › Applications.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع Weekdot لغة جهازك. اختر لغة أخرى من إعدادات النظام › عام › اللغة والمنطقة › التطبيقات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Weekdot segueix l’idioma del dispositiu. Tria un altre idioma a Configuració del Sistema › General › Idioma i regió › Aplicacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot používá jazyk vašeho zařízení. Jiný jazyk vyberete v Nastavení systému › Obecné › Jazyk a oblast › Aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot følger sproget på din enhed. Vælg et andet sprog i Systemindstillinger › Generelt › Sprog og område › Apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot verwendet die Sprache deines Geräts. Wähle eine andere Sprache in „Systemeinstellungen“ › „Allgemein“ › „Sprache & Region“ › „Programme“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Weekdot ακολουθεί τη γλώσσα της συσκευής σας. Επιλέξτε άλλη γλώσσα στις Ρυθμίσεις συστήματος › Γενικά › Γλώσσα και περιοχή › Εφαρμογές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot usa el idioma de tu dispositivo. Elige otro idioma en Ajustes del Sistema › General › Idioma y región › Aplicaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot noudattaa laitteesi kieltä. Valitse toinen kieli kohdassa Järjestelmäasetukset › Yleiset › Kieli ja alue › Apit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot suit la langue de votre appareil. Choisissez une autre langue dans Réglages Système › Général › Langue et région › Applications."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot משתמש בשפת המכשיר שלך. ניתן לבחור שפה אחרת ב״הגדרות המערכת״ › ״כללי״ › ״שפה ואזור״ › ״אפליקציות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot आपके डिवाइस की भाषा का पालन करता है। सिस्टम सेटिंग्ज़ › सामान्य › भाषा और क्षेत्र › ऐप्लिकेशन में कोई दूसरी भाषा चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot prati jezik vašeg uređaja. Drugi jezik odaberite u Postavkama sustava › Općenito › Jezik i regija › Aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Weekdot az eszköze nyelvét használja. Másik nyelvet a Rendszerbeállítások › Általános › Nyelv és régió › Alkalmazások menüpontban választhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot mengikuti bahasa perangkat Anda. Pilih bahasa lain di Pengaturan Sistem › Umum › Bahasa & Wilayah › Aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot segue la lingua del tuo dispositivo. Scegli un’altra lingua in Impostazioni di Sistema › Generali › Lingua e Zona › Applicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdotはデバイスの言語に従います。ほかの言語は「システム設定」›「一般」›「言語と地域」›「アプリケーション」で選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot은 기기의 언어를 따릅니다. 시스템 설정 › 일반 › 언어 및 지역 › 응용 프로그램에서 다른 언어를 선택하십시오."
