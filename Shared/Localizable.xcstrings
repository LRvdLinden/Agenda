    "Seven days at a glance.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبعة أيام في لمحة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Set dies d’un cop d’ull."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedm dní na první pohled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Syv dage på ét blik."
          }
        },
        "de": {
