    "Type what and when. Weekdot recognises dates and times.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب ماذا ومتى. يتعرف Weekdot على التواريخ والأوقات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriu què i quan. El Weekdot reconeix dates i hores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište co a kdy. Weekdot rozpozná data a časy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv hvad og hvornår. Weekdot genkender datoer og tidspunkter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein, was und wann. Weekdot erkennt Datum und Uhrzeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολογήστε τι και πότε. Το Weekdot αναγνωρίζει ημερομηνίες και ώρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe qué y cuándo. Weekdot reconoce fechas y horas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita mitä ja milloin. Weekdot tunnistaa päivämäärät ja kellonajat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez quoi et quand. Weekdot reconnaît les dates et les heures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלד מה ומתי. Weekdot מזהה תאריכים ושעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या और कब टाइप करें। Weekdot तारीख और समय पहचान लेता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upišite što i kada. Weekdot prepoznaje datume i vremena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írja be, mit és mikor. A Weekdot felismeri a dátumokat és időpontokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik apa dan kapan. Weekdot mengenali tanggal dan waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi cosa e quando. Weekdot riconosce date e orari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容と日時を入力してください。Weekdotが日付と時刻を認識します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용과 시간을 입력하십시오. Weekdot이 날짜와 시간을 인식합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip apa dan bila. Weekdot mengenal pasti tarikh dan masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv hva og når. Weekdot gjenkjenner datoer og klokkeslett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ wat en wanneer. Weekdot herkent datums en tijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz, co i kiedy. Weekdot rozpoznaje daty i godziny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o quê e quando. O Weekdot reconhece datas e horários."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva o quê e quando. O Weekdot reconhece datas e horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrie ce și când. Weekdot recunoaște datele și orele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите, что и когда. Weekdot распознает даты и время."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíšte čo a kedy. Weekdot rozpozná dátumy a časy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv vad och när. Weekdot känner igen datum och tider."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ว่าอะไรและเมื่อไร Weekdot จะจดจำวันที่และเวลาได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne ve ne zaman olduğunu yazın. Weekdot tarihleri ve saatleri tanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть, що і коли. Weekdot розпізнає дати й час."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập nội dung và thời gian. Weekdot nhận biết ngày và giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入内容和时间。Weekdot会识别日期和时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入內容和時間。Weekdot會辨識日期和時間。"
          }
        }
      }
    },
