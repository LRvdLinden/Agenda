    },
    "Weekdot updates Homey when your events change, when you open the app and now and then in the background.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّث Weekdot جهاز Homey عند تغيّر مواعيدك وعند فتح التطبيق ومن حين لآخر في الخلفية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot actualitza Homey quan canvien els esdeveniments, quan obres l'app i de tant en tant en segon pla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot aktualizuje Homey, když se události změní, když otevřeš aplikaci a občas na pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot opdaterer Homey, når dine begivenheder ændres, når du åbner appen og en gang imellem i baggrunden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot aktualisiert Homey, wenn sich Termine ändern, wenn du die App öffnest und ab und zu im Hintergrund."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Weekdot ενημερώνει το Homey όταν αλλάζουν τα γεγονότα σου, όταν ανοίγεις την εφαρμογή και περιστασιακά στο παρασκήνιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot actualiza Homey cuando cambian tus eventos, cuando abres la app y de vez en cuando en segundo plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot päivittää Homeyn, kun tapahtumasi muuttuvat, kun avaat apin ja ajoittain taustalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot met Homey à jour quand vos événements changent, quand vous ouvrez l'app et de temps en temps en arrière-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot מעדכן את Homey כשהאירועים משתנים, כשאתה פותח את האפליקציה ומדי פעם ברקע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इवेंट बदलने पर, ऐप खोलने पर और कभी-कभी बैकग्राउंड में Weekdot Homey को अपडेट करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot ažurira Homey kad se događaji promijene, kad otvoriš aplikaciju i povremeno u pozadini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Weekdot frissíti a Homeyt, amikor az események változnak, amikor megnyitod az alkalmazást és időnként a háttérben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot memperbarui Homey saat acara berubah, saat Anda membuka aplikasi, dan sesekali di latar belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot aggiorna Homey quando i tuoi eventi cambiano, quando apri l'app e ogni tanto in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定が変わったとき、アプリを開いたとき、そして時々バックグラウンドでWeekdotがHomeyを更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정이 바뀔 때, 앱을 열 때, 그리고 가끔 백그라운드에서 Weekdot이 Homey를 업데이트합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot mengemas kini Homey apabila acara berubah, apabila anda membuka apl dan sekali-sekala di latar belakang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot oppdaterer Homey når avtalene endres, når du åpner appen og av og til i bakgrunnen."
