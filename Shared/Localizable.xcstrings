        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada suapan langsung pilihan untuk kategori dan negara ini. Anda masih boleh menambah sebarang pautan ICS atau webcal awam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ennå ingen utvalgte live-feeder for denne kategorien og dette landet. Du kan fortsatt legge til en hvilken som helst publisert ICS- eller webcal-lenke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor dit land en deze categorie zijn nog geen kant-en-klare liveagenda's beschikbaar. Je kunt wel een openbare ICS- of webcal-link toevoegen."
