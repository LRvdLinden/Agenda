    "Sends only the times, with “Busy” as the title, without places or emoji.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل الأوقات فقط، بعنوان «مشغول»، بدون أماكن أو رموز تعبيرية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només envia les hores, amb «Ocupat» com a títol, sense llocs ni emojis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílá jen časy, s názvem „Obsazeno“, bez míst a emoji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender kun tidspunkterne, med “Optaget” som titel, uden steder eller emoji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet nur die Zeiten, mit „Beschäftigt“ als Titel, ohne Orte oder Emojis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέλνει μόνο τις ώρες, με τίτλο «Απασχολημένος», χωρίς τοποθεσίες ή emoji."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo envía las horas, con «Ocupado» como título, sin lugares ni emojis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää vain ajat, otsikkona ”Varattu”, ilman paikkoja tai emojeja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'envoie que les horaires, avec « Occupé » comme titre, sans lieux ni emoji."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח רק את השעות, עם הכותרת „עסוק”, ללא מקומות או אימוג׳י."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ समय भेजता है, शीर्षक “व्यस्त” के साथ, बिना स्थान या इमोजी के।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Šalje samo vremena, s naslovom „Zauzeto”, bez mjesta i emojija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az időpontokat küldi, „Foglalt” címmel, helyek és emojik nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya mengirim waktu, dengan judul “Sibuk”, tanpa tempat atau emoji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia solo gli orari, con «Occupato» come titolo, senza luoghi né emoji."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻のみを送信します（タイトルは「予定あり」、場所や絵文字なし）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목을 “바쁨”으로 하여 시간만 보내며, 장소와 이모지는 보내지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya menghantar masa, dengan tajuk “Sibuk”, tanpa tempat atau emoji."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender bare tidspunktene, med «Opptatt» som tittel, uten steder eller emoji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt alleen de tijden, met „Bezet” als titel, zonder locaties of emoji."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła tylko godziny, z tytułem „Zajęty”, bez miejsc i emoji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia só os horários, com “Ocupado” como título, sem locais nem emojis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia só as horas, com “Ocupado” como título, sem locais nem emojis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite doar orele, cu „Ocupat” ca titlu, fără locuri sau emoji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет только время, с названием «Занят», без мест и эмодзи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odosiela len časy, s názvom „Obsadené“, bez miest a emoji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickar bara tiderna, med ”Upptagen” som titel, utan platser eller emoji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งเฉพาะเวลา โดยใช้ชื่อ “ไม่ว่าง” ไม่มีสถานที่หรืออีโมจิ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca saatleri gönderir; başlık “Meşgul” olur, yer ve emoji olmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає лише час, з назвою «Зайнято», без місць та емодзі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ gửi thời gian, với tiêu đề “Bận”, không có địa điểm hay emoji."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅发送时间，标题为“忙碌”，不含地点或表情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只傳送時間，標題為「忙碌」，不含地點或表情符號。"
          }
        }
      }
    },
