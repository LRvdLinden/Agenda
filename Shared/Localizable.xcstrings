    "Create an event or use one of your own saved templates.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ حدثًا أو استخدم أحد قوالبك المحفوظة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un esdeveniment o fes servir una de les teves plantilles desades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte událost nebo použijte některou ze svých uložených šablon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
