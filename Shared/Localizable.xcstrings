    "Weather is an overlay in the week view, not a subscribed calendar. Weekdot already uses an approximate location and forecasts from Open-Meteo; WeatherKit setup is not required.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het weer wordt in de weekweergave getoond, niet als agenda-abonnement. Weekdot gebruikt je geschatte locatie en Open-Meteo; WeatherKit instellen is niet nodig."
          }
        }
      }
    },
    "Weather location unavailable. Enter your town under Settings → Weather, or allow location access.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موقع الطقس غير متاح. أدخل مدينتك في الإعدادات ← الطقس، أو اسمح بالوصول إلى الموقع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicació per al temps no està disponible. Introdueix la teva població a Configuració → Temps o permet l’accés a la ubicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poloha pro počasí není k dispozici. Zadejte svou obec v Nastavení → Počasí nebo povolte přístup k poloze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vejrlokalitet er ikke tilgængelig. Indtast din by under Indstillinger → Vejr, eller giv adgang til lokalitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wetterstandort nicht verfügbar. Gib deinen Wohnort unter Einstellungen → Wetter ein oder erlaube den Standortzugriff."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τοποθεσία για τον καιρό δεν είναι διαθέσιμη. Εισαγάγετε την πόλη σας στις Ρυθμίσεις → Καιρός ή επιτρέψτε την πρόσβαση στην τοποθεσία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicación del tiempo no disponible. Introduce tu localidad en Ajustes → Tiempo o permite el acceso a la ubicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sään sijainti ei ole käytettävissä. Syötä paikkakuntasi kohdassa Asetukset → Sää tai salli sijainnin käyttö."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position météo indisponible. Saisissez votre ville dans Réglages → Météo ou autorisez l’accès à la position."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מיקום למזג האוויר אינו זמין. הזן את היישוב שלך בהגדרות ← מזג אוויר, או אפשר גישה למיקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौसम का स्थान उपलब्ध नहीं है। सेटिंग्ज़ → मौसम में अपना शहर दर्ज करें, या स्थान का ऐक्सेस दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokacija za vrijeme nije dostupna. Unesite svoje mjesto u Postavke → Vrijeme ili dopustite pristup lokaciji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időjáráshoz nem érhető el helyadat. Adja meg települését a Beállítások → Időjárás menüben, vagy engedélyezze a helyhozzáférést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi cuaca tidak tersedia. Masukkan kota Anda di Pengaturan → Cuaca, atau izinkan akses lokasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posizione meteo non disponibile. Inserisci la tua città in Impostazioni → Meteo oppure consenti l’accesso alla posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気の場所を取得できません。設定 → 天気で市区町村を入力するか、位置情報へのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨 위치를 사용할 수 없습니다. 설정 → 날씨에서 도시를 입력하거나 위치 접근을 허용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi cuaca tidak tersedia. Masukkan bandar anda dalam Seting → Cuaca, atau benarkan akses lokasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Værposisjon er ikke tilgjengelig. Skriv inn stedet ditt under Innstillinger → Vær, eller gi tilgang til posisjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie voor het weer niet beschikbaar. Vul je woonplaats in bij Instellingen → Weer of geef locatietoegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja dla pogody jest niedostępna. Wpisz swoją miejscowość w Ustawienia → Pogoda lub zezwól na dostęp do lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Localização do clima indisponível. Digite sua cidade em Ajustes → Clima ou permita o acesso à localização."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Localização meteorológica indisponível. Introduza a sua localidade em Definições → Meteorologia ou permita o acesso à localização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Localizarea pentru vreme nu este disponibilă. Introduceți localitatea în Configurări → Vreme sau permiteți accesul la localizare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Геопозиция для погоды недоступна. Введите свой город в Настройки → Погода или разрешите доступ к геопозиции."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poloha pre počasie nie je k dispozícii. Zadajte svoju obec v Nastavenia → Počasie alebo povoľte prístup k polohe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väderplatsen är inte tillgänglig. Ange din ort under Inställningar → Väder eller tillåt platsåtkomst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีตำแหน่งสำหรับสภาพอากาศ ป้อนเมืองของคุณในการตั้งค่า → สภาพอากาศ หรืออนุญาตการเข้าถึงตำแหน่งที่ตั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumu konumu kullanılamıyor. Ayarlar → Hava Durumu bölümüne yaşadığınız yeri girin veya konum erişimine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локація для погоди недоступна. Введіть своє місто в Параметри → Погода або дозвольте доступ до локації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có vị trí thời tiết. Nhập thị trấn của bạn trong Cài đặt → Thời tiết hoặc cho phép truy cập vị trí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取天气位置。请在“设置”→“天气”中输入你的城镇，或允许位置访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得天氣位置。請在「設定」→「天氣」中輸入你的城鎮，或允許位置取用權限。"
          }
        }
      }
    },
