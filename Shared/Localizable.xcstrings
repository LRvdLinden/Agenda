          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε ένα συμβάν ή χρησιμοποιήστε ένα από τα αποθηκευμένα πρότυπά σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un evento o usa una de tus plantillas guardadas."
          }
        },
