          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור ב‑iCloud כדי שלוח השנה יהיה בכל המכשירים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सभी डिवाइस पर कैलेंडर पाने के लिए iCloud चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite iCloud kako biste kalendar imali na svim svojim uređajima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza az iCloudot, hogy a naptár minden eszközén elérhető legyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih iCloud agar kalender ada di semua perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli iCloud per avere il calendario su tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudを選択すると、すべてのデバイスでカレンダーを使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 캘린더를 사용하려면 iCloud를 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih iCloud untuk mempunyai kalendar pada semua peranti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg iCloud for å ha kalenderen på alle enhetene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies iCloud om de agenda op al je apparaten te hebben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz iCloud, aby mieć kalendarz na wszystkich swoich urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o iCloud para ter o calendário em todos os seus dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha iCloud para ter o calendário em todos os seus dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți iCloud pentru a avea calendarul pe toate dispozitivele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите iCloud, чтобы календарь был на всех ваших устройствах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte iCloud, aby ste kalendár mali na všetkých svojich zariadeniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj iCloud för att ha kalendern på alla dina enheter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก iCloud เพื่อให้มีปฏิทินนี้บนอุปกรณ์ทั้งหมดของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimin tüm aygıtlarınızda olması için iCloud’u seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть iCloud, щоб календар був на всіх ваших пристроях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn iCloud để có lịch trên tất cả thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 iCloud，即可在你的所有设备上使用此日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 iCloud 即可在你的所有裝置上使用此行事曆。"
          }
        }
      }
    },
