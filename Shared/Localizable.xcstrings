    "You can add any club using its published ICS link.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إضافة أي نادٍ باستخدام رابط ICS المنشور الخاص به."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots afegir qualsevol club amb el seu enllaç ICS públic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Libovolný klub můžete přidat pomocí jeho zveřejněného odkazu ICS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan tilføje enhver klub via dens offentlige ICS-link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jeden Verein über seinen öffentlichen ICS-Link hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να προσθέσετε οποιαδήποτε ομάδα χρησιμοποιώντας τον δημοσιευμένο σύνδεσμο ICS της."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes añadir cualquier club con su enlace ICS público."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit lisätä minkä tahansa seuran sen julkaiseman ICS-linkin avulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez ajouter n’importe quel club grâce à son lien ICS public."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להוסיף כל מועדון באמצעות קישור ה-ICS שפורסם עבורו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किसी भी क्लब को उसके प्रकाशित ICS लिंक से जोड़ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilo koji klub možete dodati pomoću njegove objavljene ICS poveznice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármelyik klubot hozzáadhatja a közzétett ICS-linkjével."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menambahkan klub apa pun menggunakan tautan ICS publiknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi aggiungere qualsiasi club tramite il suo link ICS pubblico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開されているICSリンクを使用して、どのクラブでも追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개된 ICS 링크를 사용하여 어떤 클럽이든 추가할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menambah mana-mana kelab menggunakan pautan ICS awamnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan legge til hvilken som helst klubb med den publiserte ICS-lenken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt elke club toevoegen met een openbare ICS-link."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz dodać dowolny klub za pomocą jego opublikowanego linku ICS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode adicionar qualquer clube usando o link ICS público dele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode adicionar qualquer clube através da respetiva ligação ICS pública."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți adăuga orice club folosind linkul său ICS publicat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой клуб можно добавить по его опубликованной ссылке ICS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ľubovoľný klub môžete pridať pomocou jeho zverejneného odkazu ICS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lägga till vilken klubb som helst med dess publicerade ICS-länk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเพิ่มสโมสรใดก็ได้โดยใช้ลิงก์ ICS สาธารณะของสโมสรนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir kulübü yayımlanmış ICS bağlantısıyla ekleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-який клуб можна додати за його опублікованим посиланням ICS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể thêm bất kỳ câu lạc bộ nào bằng liên kết ICS công khai của câu lạc bộ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以使用俱乐部公开的 ICS 链接添加任何俱乐部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以使用俱樂部公開的 ICS 連結加入任何俱樂部。"
          }
        }
      }
    },
    "You can change this later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تغيير ذلك لاحقًا في الإعدادات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots canviar-ho més endavant a Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Později to můžete změnit v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ændre dette senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
