    "Enter your town to display weather without granting location access. Leave empty to use the device location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مدينتك لعرض الطقس دون منح الوصول إلى الموقع. اتركه فارغًا لاستخدام موقع الجهاز."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix la teva població per mostrar el temps sense donar accés a la ubicació. Deixa-ho en blanc per fer servir la ubicació del dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte svou obec, chcete-li zobrazovat počasí bez přístupu k poloze. Ponechte prázdné, chcete-li použít polohu zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast din by for at vise vejret uden at give adgang til lokalitet. Lad feltet stå tomt for at bruge enhedens lokalitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deinen Wohnort ein, um das Wetter ohne Standortzugriff anzuzeigen. Leer lassen, um den Gerätestandort zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε την πόλη σας για να εμφανίζεται ο καιρός χωρίς πρόσβαση στην τοποθεσία. Αφήστε κενό για χρήση της τοποθεσίας της συσκευής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu localidad para mostrar el tiempo sin conceder acceso a la ubicación. Déjalo en blanco para usar la ubicación del dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä paikkakuntasi, niin sää näytetään ilman sijaintioikeutta. Jätä tyhjäksi, jos haluat käyttää laitteen sijaintia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre ville pour afficher la météo sans autoriser l’accès à la position. Laissez vide pour utiliser la position de l’appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן את היישוב שלך כדי להציג מזג אוויר בלי לתת גישה למיקום. השאר ריק כדי להשתמש במיקום המכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान का ऐक्सेस दिए बिना मौसम दिखाने के लिए अपना शहर दर्ज करें। डिवाइस का स्थान उपयोग करने के लिए खाली छोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite svoje mjesto za prikaz vremena bez pristupa lokaciji. Ostavite prazno za korištenje lokacije uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja meg a települését, hogy az időjárás helyhozzáférés nélkül jelenjen meg. Hagyja üresen az eszköz helyzetének használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kota Anda untuk menampilkan cuaca tanpa memberikan akses lokasi. Biarkan kosong untuk menggunakan lokasi perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la tua città per mostrare il meteo senza concedere l’accesso alla posizione. Lascia vuoto per usare la posizione del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報へのアクセスを許可せずに天気を表示するには、市区町村を入力してください。デバイスの位置情報を使用する場合は空欄のままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 접근을 허용하지 않고 날씨를 표시하려면 도시를 입력하십시오. 기기 위치를 사용하려면 비워 두십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan bandar anda untuk menunjukkan cuaca tanpa memberikan akses lokasi. Biarkan kosong untuk menggunakan lokasi peranti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn stedet ditt for å vise været uten å gi tilgang til posisjon. La feltet stå tomt for å bruke enhetens posisjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer je woonplaats in om het weer te tonen zonder locatietoegang. Laat leeg om je apparaatlocatie te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz swoją miejscowość, aby wyświetlać pogodę bez udzielania dostępu do lokalizacji. Pozostaw puste, aby używać lokalizacji urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite sua cidade para exibir o clima sem permitir o acesso à localização. Deixe em branco para usar a localização do dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza a sua localidade para mostrar a meteorologia sem conceder acesso à localização. Deixe em branco para usar a localização do dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți localitatea pentru a afișa vremea fără acces la localizare. Lăsați gol pentru a folosi localizarea dispozitivului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите свой город, чтобы показывать погоду без доступа к геопозиции. Оставьте пустым, чтобы использовать геопозицию устройства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte svoju obec, ak chcete zobrazovať počasie bez prístupu k polohe. Nechajte prázdne, ak chcete použiť polohu zariadenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange din ort för att visa vädret utan att ge platsåtkomst. Lämna tomt för att använda enhetens plats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนเมืองของคุณเพื่อแสดงสภาพอากาศโดยไม่ต้องอนุญาตการเข้าถึงตำแหน่งที่ตั้ง เว้นว่างไว้เพื่อใช้ตำแหน่งที่ตั้งของอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum erişimi vermeden hava durumunu göstermek için yaşadığınız yeri girin. Aygıt konumunu kullanmak için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть своє місто, щоб показувати погоду без доступу до локації. Залиште порожнім, щоб використовувати локацію пристрою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập thị trấn của bạn để hiển thị thời tiết mà không cần cấp quyền truy cập vị trí. Để trống để dùng vị trí thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入你所在的城镇即可显示天气，无需授予位置访问权限。留空则使用设备位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入你所在的城鎮即可顯示天氣，不需提供位置取用權限。保留空白則使用裝置位置。"
          }
        }
      }
    },
    "Equinoxes & solstices": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Equinoxen en zonnewendes"
          }
        }
      }
    },
    "Er zijn nog geen ophaaldagen opgehaald.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُجلب أيام جمع بعد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no s’ha obtingut cap dia de recollida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nebyly načteny žádné dny svozu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er endnu ikke hentet nogen tømningsdage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden noch keine Abholtermine abgerufen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχουν ληφθεί ακόμη ημέρες αποκομιδής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se han obtenido días de recogida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjennyspäiviä ei ole vielä haettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun jour de collecte n’a encore été récupéré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא נטענו ימי איסוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई संग्रह तारीख प्राप्त नहीं हुई है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nisu dohvaćeni dani odvoza."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincsenek lekért gyűjtési napok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada tanggal pengangkutan yang diambil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono ancora stati recuperati giorni di raccolta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ収集日が取得されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 가져온 수거일이 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada tarikh kutipan yang diambil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tømmedager er hentet ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn nog geen ophaaldagen opgehaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie pobrano jeszcze żadnych dni odbioru."
          }
        },
        "pt-BR": {
          "stringUnit": {
