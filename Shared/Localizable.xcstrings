        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu takvimin adı burada değiştirilemez. Renk Weekdot tarafından saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назву цього календаря не можна змінити тут. Колір зберігає Weekdot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thay đổi tên của lịch này tại đây. Màu được Weekdot giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此处更改此日历的名称。颜色由Weekdot保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在此更改此行事曆的名稱。顏色會由Weekdot保留。"
          }
        }
      }
    },
    "The original calendar is read-only. Weekdot keeps your changed version in the calendar you choose and hides the original.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقويم الأصلي للقراءة فقط. يحتفظ Weekdot بنسختك المعدلة في التقويم الذي تختاره ويخفي الأصلي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendari original és només de lectura. El Weekdot conserva la versió modificada al calendari que triïs i amaga l’original."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Původní kalendář je jen pro čtení. Weekdot uloží upravenou verzi do vybraného kalendáře a originál skryje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den oprindelige kalender er skrivebeskyttet. Weekdot gemmer din ændrede version i den kalender, du vælger, og skjuler originalen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ursprüngliche Kalender ist schreibgeschützt. Weekdot speichert deine geänderte Version im gewählten Kalender und blendet das Original aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχικό ημερολόγιο είναι μόνο για ανάγνωση. Το Weekdot διατηρεί την τροποποιημένη έκδοση στο ημερολόγιο που επιλέγετε και αποκρύπτει το αρχικό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario original es de solo lectura. Weekdot guarda tu versión modificada en el calendario que elijas y oculta el original."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkuperäinen kalenteri on vain luku -tilassa. Weekdot säilyttää muokatun version valitsemassasi kalenterissa ja kätkee alkuperäisen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier d’origine est en lecture seule. Weekdot conserve votre version modifiée dans le calendrier choisi et masque l’original."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוח השנה המקורי הוא לקריאה בלבד. Weekdot שומר את הגרסה ששינית בלוח השנה שתבחר ומסתיר את המקור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल कैलेंडर केवल पढ़ने योग्य है। Weekdot आपके बदले गए संस्करण को आपके चुने गए कैलेंडर में रखता है और मूल को छिपा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvorni kalendar je samo za čitanje. Weekdot čuva vašu izmijenjenu verziju u kalendaru koji odaberete i skriva izvornik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredeti naptár csak olvasható. A Weekdot a módosított verziót a kiválasztott naptárban tárolja, az eredetit pedig elrejti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender asli hanya-baca. Weekdot menyimpan versi yang Anda ubah di kalender pilihan Anda dan menyembunyikan aslinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il calendario originale è di sola lettura. Weekdot conserva la versione modificata nel calendario che scegli e nasconde l’originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のカレンダーは読み出し専用です。Weekdotは変更したバージョンを選択したカレンダーに保存し、元のイベントを非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 캘린더는 읽기 전용입니다. Weekdot은 변경된 버전을 선택한 캘린더에 보관하고 원본은 가립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar asal adalah baca sahaja. Weekdot menyimpan versi yang anda ubah dalam kalendar yang anda pilih dan menyembunyikan yang asal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den opprinnelige kalenderen er skrivebeskyttet. Weekdot beholder den endrede versjonen din i kalenderen du velger, og skjuler originalen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De oorspronkelijke agenda is alleen-lezen. Weekdot bewaart je gewijzigde versie in de agenda die je kiest en verbergt het origineel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginalny kalendarz jest tylko do odczytu. Weekdot zachowuje zmienioną wersję w wybranym kalendarzu i ukrywa oryginał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário original é somente leitura. O Weekdot mantém sua versão alterada no calendário escolhido e oculta o original."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário original é só de leitura. O Weekdot guarda a sua versão alterada no calendário que escolher e oculta o original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendarul original este doar pentru citire. Weekdot păstrează versiunea modificată în calendarul ales și ascunde originalul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный календарь доступен только для чтения. Weekdot сохраняет измененную версию в выбранном календаре и скрывает оригинал."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pôvodný kalendár je iba na čítanie. Weekdot uloží zmenenú verziu do vybraného kalendára a originál skryje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Originalkalendern är skrivskyddad. Weekdot sparar din ändrade version i den kalender du väljer och döljer originalet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินต้นฉบับเป็นแบบอ่านอย่างเดียว Weekdot จะเก็บเวอร์ชันที่คุณเปลี่ยนไว้ในปฏิทินที่คุณเลือกและซ่อนต้นฉบับไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal takvim salt okunur. Weekdot, değiştirdiğiniz sürümü seçtiğiniz takvimde saklar ve orijinali gizler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригінальний календар доступний лише для читання. Weekdot зберігає змінену версію у вибраному календарі та ховає оригінал."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch gốc ở chế độ chỉ đọc. Weekdot giữ phiên bản bạn đã thay đổi trong lịch bạn chọn và ẩn bản gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原日历为只读。Weekdot会将你更改后的版本存储在你选择的日历中，并隐藏原日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
