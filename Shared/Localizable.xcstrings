        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderne som er synlige nå, lagres i dette settet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De agenda's die nu zichtbaar zijn, worden in deze set bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendarze widoczne teraz zostaną zachowane w tym zestawie."
          }
