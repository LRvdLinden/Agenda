          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot מציג כל לוח שנה מהאפליקציה ״לוח שנה״. השינויים נשמרים בחשבונות שלך ומסונכרנים עם iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot कैलेंडर ऐप का हर कैलेंडर दिखाता है। बदलाव आपके अकाउंट में सहेजे जाते हैं और iCloud से सिंक होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot prikazuje sve kalendare iz aplikacije Kalendar. Promjene se spremaju u vaše račune i sinkroniziraju putem iClouda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
