    "Select a calendar to add it to Weekdot.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تقويمًا لإضافته إلى Weekdot."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un calendari per afegir-lo al Weekdot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte kalendář, který chcete přidat do Weekdotu."
          }
