        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Weekdot mostra tots els calendaris de l’app Calendari. Els canvis es desen als teus comptes i se sincronitzen amb iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot zobrazuje všechny kalendáře z aplikace Kalendář. Změny se ukládají do vašich účtů a synchronizují přes iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot viser alle kalendere fra appen Kalender. Ændringer gemmes på dine konti og synkroniseres med iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot zeigt jeden Kalender aus der App „Kalender“. Änderungen werden in deinen Accounts gesichert und mit iCloud synchronisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Weekdot εμφανίζει όλα τα ημερολόγια από την εφαρμογή Ημερολόγιο. Οι αλλαγές αποθηκεύονται στους λογαριασμούς σας και συγχρονίζονται μέσω iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot muestra todos los calendarios de la app Calendario. Los cambios se guardan en tus cuentas y se sincronizan con iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot näyttää kaikki Kalenteri-apin kalenterit. Muutokset tallennetaan tileillesi ja synkronoidaan iCloudin kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
