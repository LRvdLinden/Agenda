    "Deze aanbieder is opgenomen in de catalogus. Een live koppeling is voor deze aanbieder nog niet beschikbaar.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المزوّد مُدرج في الكتالوج. لا يتوفر له اتصال مباشر بعد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest proveïdor és al catàleg. Encara no hi ha cap connexió en directe disponible per a aquest proveïdor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento poskytovatel je v katalogu. Živé propojení pro tohoto poskytovatele zatím není k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne udbyder er med i kataloget. Der er endnu ingen live-forbindelse til denne udbyder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anbieter ist im Katalog enthalten. Eine Live-Verbindung ist für diesen Anbieter noch nicht verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο πάροχος περιλαμβάνεται στον κατάλογο. Δεν υπάρχει ακόμη διαθέσιμη ζωντανή σύνδεση για αυτόν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proveedor está incluido en el catálogo. Todavía no hay una conexión en directo disponible para este proveedor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä palveluntarjoaja on luettelossa. Live-yhteys ei ole vielä saatavilla tälle palveluntarjoajalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur figure dans le catalogue. Aucune connexion en direct n’est encore disponible pour ce fournisseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספק זה כלול בקטלוג. חיבור חי עבורו עדיין אינו זמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्रदाता कैटलॉग में शामिल है। इस प्रदाता के लिए लाइव कनेक्शन अभी उपलब्ध नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj pružatelj nalazi se u katalogu. Živa veza za njega još nije dostupna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szolgáltató szerepel a katalógusban. Élő kapcsolat ehhez a szolgáltatóhoz még nem érhető el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyedia ini ada di katalog. Koneksi langsung untuk penyedia ini belum tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo fornitore è incluso nel catalogo. Per questo fornitore non è ancora disponibile un collegamento in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この提供元はカタログに含まれていますが、ライブ接続はまだ利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제공업체는 카탈로그에 포함되어 있지만 아직 실시간 연결을 사용할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyedia ini ada dalam katalog. Sambungan langsung untuk penyedia ini belum tersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne leverandøren er med i katalogen. Det finnes ennå ingen live-tilkobling for denne leverandøren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze aanbieder is opgenomen in de catalogus. Een live koppeling is voor deze aanbieder nog niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dostawca jest w katalogu. Połączenie na żywo dla tego dostawcy nie jest jeszcze dostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este provedor está incluído no catálogo. Uma conexão ao vivo ainda não está disponível para este provedor."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este fornecedor está incluído no catálogo. Ainda não está disponível uma ligação em direto para este fornecedor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest furnizor este inclus în catalog. O conexiune live nu este încă disponibilă pentru el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот поставщик есть в каталоге. Живое подключение для него пока недоступно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento poskytovateľ je v katalógu. Živé prepojenie pre tohto poskytovateľa zatiaľ nie je k dispozícii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här leverantören finns i katalogen. Det finns ännu ingen live-koppling för den här leverantören."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการนี้อยู่ในแคตตาล็อก แต่ยังไม่มีการเชื่อมต่อแบบสดสำหรับผู้ให้บริการนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sağlayıcı katalogda yer alıyor. Bu sağlayıcı için henüz canlı bağlantı yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей постачальник є в каталозі. Живе підключення для нього поки недоступне."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp này có trong danh mục nhưng chưa hỗ trợ kết nối trực tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此提供商已收录在目录中，但尚不支持实时连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此提供者已收錄在目錄中，但尚不支援即時連線。"
          }
        }
      }
    },
    "Deze afvalophaler staat in de catalogus, maar heeft nog geen werkende directe koppeling in Weekdot.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة جمع النفايات هذه مُدرجة في الكتالوج، لكن ليس لها بعد اتصال مباشر يعمل في Weekdot."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest servei de recollida és al catàleg, però encara no té cap connexió directa operativa al Weekdot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato svozová společnost je v katalogu, ale ve Weekdotu zatím nemá funkční přímé propojení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne affaldsindsamler er med i kataloget, men har endnu ingen fungerende direkte forbindelse i Weekdot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Entsorger ist im Katalog enthalten, hat in Weekdot aber noch keine funktionierende direkte Verbindung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η υπηρεσία αποκομιδής είναι στον κατάλογο, αλλά δεν έχει ακόμη λειτουργική άμεση σύνδεση στο Weekdot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servicio de recogida está en el catálogo, pero todavía no tiene una conexión directa operativa en Weekdot."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä jätehuoltoyhtiö on luettelossa, mutta sillä ei ole vielä toimivaa suoraa yhteyttä Weekdotissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce collecteur de déchets figure dans le catalogue, mais n’a pas encore de connexion directe fonctionnelle dans Weekdot."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות פינוי אשפה זה נמצא בקטלוג, אך עדיין אין לו חיבור ישיר פעיל ב-Weekdot."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कचरा संग्रहकर्ता कैटलॉग में है, लेकिन Weekdot में अभी इसका कोई काम करने वाला सीधा कनेक्शन नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova služba za odvoz otpada nalazi se u katalogu, ali još nema funkcionalnu izravnu vezu u Weekdotu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a hulladékszállító szerepel a katalógusban, de a Weekdotban még nincs működő közvetlen kapcsolata."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengangkut sampah ini ada di katalog, tetapi belum memiliki koneksi langsung yang berfungsi di Weekdot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gestore rifiuti è nel catalogo, ma non ha ancora un collegamento diretto funzionante in Weekdot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このごみ収集業者はカタログに含まれていますが、Weekdotではまだ直接接続が機能していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 쓰레기 수거 업체는 카탈로그에 있지만 Weekdot에서 아직 직접 연결이 작동하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengutip sampah ini ada dalam katalog, tetapi belum mempunyai sambungan terus yang berfungsi dalam Weekdot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne renovatøren er med i katalogen, men har ennå ingen fungerende direkte tilkobling i Weekdot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze afvalophaler staat in de catalogus, maar heeft nog geen werkende directe koppeling in Weekdot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta firma odbierająca odpady jest w katalogu, ale nie ma jeszcze działającego bezpośredniego połączenia w Weekdot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta empresa de coleta está no catálogo, mas ainda não tem uma conexão direta funcionando no Weekdot."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta entidade de recolha está no catálogo, mas ainda não tem uma ligação direta funcional no Weekdot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest serviciu de colectare este în catalog, dar nu are încă o conexiune directă funcțională în Weekdot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта служба вывоза мусора есть в каталоге, но у нее пока нет работающего прямого подключения в Weekdot."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto zberová spoločnosť je v katalógu, ale vo Weekdote zatiaľ nemá funkčné priame prepojenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här sophämtaren finns i katalogen men har ännu ingen fungerande direktkoppling i Weekdot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการเก็บขยะนี้อยู่ในแคตตาล็อก แต่ยังไม่มีการเชื่อมต่อโดยตรงที่ใช้งานได้ใน Weekdot"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu atık toplama hizmeti katalogda yer alıyor ancak Weekdot’ta henüz çalışan doğrudan bir bağlantısı yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця служба вивезення сміття є в каталозі, але поки не має робочого прямого підключення в Weekdot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đơn vị thu gom rác này có trong danh mục nhưng chưa có kết nối trực tiếp hoạt động trong Weekdot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此垃圾收集商已收录在目录中，但在 Weekdot 中尚无可用的直接连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此垃圾收運業者已收錄在目錄中，但在 Weekdot 中尚無可用的直接連線。"
          }
        }
      }
    },
