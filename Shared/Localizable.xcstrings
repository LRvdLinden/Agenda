    "Weather is an overlay in the week view, not a subscribed calendar. Weekdot already uses an approximate location and forecasts from Open-Meteo; WeatherKit setup is not required.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het weer wordt in de weekweergave getoond, niet als agenda-abonnement. Weekdot gebruikt je geschatte locatie en Open-Meteo; WeatherKit instellen is niet nodig."
          }
        }
      }
    },
    "Weather location unavailable. Enter your town under Settings → Weather, or allow location access.": {
