    "Add a live address-based waste calendar to keep collection dates updated. One-time ICS imports remain available.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف تقويم نفايات مباشرًا حسب العنوان لتبقى مواعيد الجمع محدّثة. يظل استيراد ICS لمرة واحدة متاحًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix un calendari de residus en directe vinculat a la teva adreça per mantenir actualitzades les dates de recollida. Les importacions ICS puntuals continuen disponibles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte živý kalendář svozu odpadu podle adresy, aby termíny svozu zůstaly aktuální. Jednorázový import ICS je nadále k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en live adressebaseret affaldskalender, så tømningsdatoerne holdes opdateret. Engangsimport af ICS er stadig tilgængelig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen live Abfallkalender für deine Adresse hinzu, damit die Abholtermine aktuell bleiben. Einmalige ICS-Importe sind weiterhin möglich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα ζωντανό ημερολόγιο αποκομιδής απορριμμάτων βάσει διεύθυνσης, ώστε οι ημερομηνίες αποκομιδής να παραμένουν ενημερωμένες. Οι εφάπαξ εισαγωγές ICS παραμένουν διαθέσιμες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un calendario de residuos en directo según tu dirección para mantener actualizadas las fechas de recogida. Las importaciones ICS puntuales siguen disponibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää osoitekohtainen live-jätekalenteri, jotta tyhjennyspäivät pysyvät ajan tasalla. Kertaluonteinen ICS-tuonti on edelleen käytettävissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un calendrier des déchets en direct lié à votre adresse pour garder les dates de collecte à jour. Les imports ICS ponctuels restent disponibles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף לוח פינוי אשפה חי לפי כתובת כדי שמועדי האיסוף יישארו מעודכנים. ייבוא ICS חד־פעמי נשאר זמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रह की तारीखें अपडेट रखने के लिए पते पर आधारित लाइव कचरा संग्रह कैलेंडर जोड़ें। एक बार का ICS इंपोर्ट अब भी उपलब्ध है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte živi kalendar odvoza otpada prema adresi kako bi datumi odvoza ostali ažurni. Jednokratni ICS uvozi i dalje su dostupni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon hozzá egy címalapú élő hulladéknaptárt, hogy a gyűjtési napok naprakészek maradjanak. Az egyszeri ICS-importálás továbbra is elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan kalender sampah langsung berdasarkan alamat agar tanggal pengangkutan selalu terbaru. Impor ICS sekali tetap tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un calendario rifiuti in tempo reale legato al tuo indirizzo per mantenere aggiornate le date di raccolta. Le importazioni ICS una tantum restano disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "住所ベースのライブごみ収集カレンダーを追加すると、収集日が常に最新の状態に保たれます。1回限りのICS読み込みも引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소 기반 실시간 쓰레기 수거 캘린더를 추가하여 수거일을 최신 상태로 유지하십시오. 일회성 ICS 가져오기도 계속 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah kalendar sampah langsung berdasarkan alamat supaya tarikh kutipan sentiasa dikemas kini. Import ICS sekali sahaja masih tersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en live adressebasert avfallskalender slik at tømmedatoene holdes oppdatert. Engangsimport av ICS er fortsatt tilgjengelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een live afvalkalender voor je adres toe om ophaaldata actueel te houden. Eenmalige ICS-imports blijven beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj kalendarz odbioru odpadów na żywo dla swojego adresu, aby terminy odbioru były zawsze aktualne. Jednorazowy import ICS nadal jest dostępny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um calendário de coleta de lixo ao vivo vinculado ao seu endereço para manter as datas de coleta atualizadas. Importações ICS únicas continuam disponíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um calendário de recolha de resíduos em direto associado à sua morada para manter as datas de recolha atualizadas. As importações ICS únicas continuam disponíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați un calendar live pentru deșeuri, pe baza adresei, ca datele de colectare să rămână actualizate. Importurile ICS unice rămân disponibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте живой календарь вывоза мусора по адресу, чтобы даты вывоза всегда были актуальны. Разовый импорт ICS по-прежнему доступен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte živý kalendár odvozu odpadu podľa adresy, aby termíny odvozu zostali aktuálne. Jednorazový import ICS je naďalej k dispozícii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en live-sophämtningskalender baserad på adress så att hämtningsdatumen hålls uppdaterade. Engångsimport av ICS finns fortfarande kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มปฏิทินเก็บขยะแบบสดตามที่อยู่เพื่อให้วันเก็บขยะเป็นปัจจุบันอยู่เสมอ ยังคงนำเข้า ICS แบบครั้งเดียวได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplama tarihlerinin güncel kalması için adrese dayalı canlı bir atık takvimi ekleyin. Tek seferlik ICS içe aktarmaları kullanılabilir olmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте живий календар вивезення сміття за адресою, щоб дати вивезення завжди були актуальні. Разовий імпорт ICS залишається доступним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm lịch thu gom rác trực tiếp theo địa chỉ để luôn cập nhật ngày thu gom. Bạn vẫn có thể nhập ICS một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加基于地址的实时垃圾收集日历，让收集日期保持最新。仍可使用一次性 ICS 导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入依地址提供的即時垃圾收運行事曆，讓收運日期保持最新。仍可使用一次性 ICS 匯入。"
          }
        }
      }
    },
