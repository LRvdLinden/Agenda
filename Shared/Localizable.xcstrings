    "Calendars are mirrored to Apple Calendar without opening its app. Live feeds refresh while Weekdot is active.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنسخ التقويمات إلى تقويم Apple دون فتح تطبيقه. تُحدَّث الموجزات المباشرة أثناء نشاط Weekdot."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els calendaris es repliquen al Calendari d’Apple sense obrir l’app. Els feeds en directe s’actualitzen mentre el Weekdot està actiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendáře se zrcadlí do Kalendáře Apple, aniž by se otevírala jeho aplikace. Živé kanály se obnovují, když je Weekdot aktivní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendere spejles til Apple Kalender uden at åbne appen. Live-feeds opdateres, mens Weekdot er aktiv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender werden in Apple Kalender gespiegelt, ohne die App zu öffnen. Live-Feeds werden aktualisiert, während Weekdot aktiv ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ημερολόγια αντιγράφονται στο Ημερολόγιο Apple χωρίς να ανοίξει η εφαρμογή του. Οι ζωντανές ροές ανανεώνονται όσο το Weekdot είναι ενεργό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los calendarios se copian en Calendario de Apple sin abrir la app. Los feeds en directo se actualizan mientras Weekdot está activo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenterit peilataan Applen Kalenteriin avaamatta sen appia. Live-syötteet päivittyvät, kun Weekdot on aktiivinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calendriers sont copiés dans Calendrier d’Apple sans ouvrir l’app. Les flux en direct sont actualisés tant que Weekdot est actif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוחות השנה משתקפים ללוח השנה של Apple בלי לפתוח את האפליקציה שלו. מקורות חיים מתרעננים כל עוד Weekdot פעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर ऐप खोले बिना ही कैलेंडर Apple कैलेंडर में मिरर हो जाते हैं। Weekdot सक्रिय रहने पर लाइव फ़ीड रीफ़्रेश होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendari se preslikavaju u Apple Kalendar bez otvaranja te aplikacije. Živi izvori osvježavaju se dok je Weekdot aktivan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A naptárak az app megnyitása nélkül tükröződnek az Apple Naptárba. Az élő hírcsatornák akkor frissülnek, amikor a Weekdot aktív."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender disalin ke Kalender Apple tanpa membuka appnya. Feed langsung disegarkan saat Weekdot aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I calendari vengono copiati in Calendario di Apple senza aprire l’app. I feed in tempo reale si aggiornano mentre Weekdot è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーはAppを開かずにAppleカレンダーにミラーリングされます。ライブフィードはWeekdotの使用中に更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 앱을 열지 않고도 Apple 캘린더에 미러링됩니다. 실시간 피드는 Weekdot이 활성 상태일 때 새로 고쳐집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar disalin ke Kalendar Apple tanpa membuka appnya. Suapan langsung disegarkan semasa Weekdot aktif."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendere speiles til Apple Kalender uten å åpne appen. Live-feeder oppdateres mens Weekdot er aktiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kan afspraken naar Apple Agenda kopiëren. Live-abonnementen worden bijgewerkt tijdens gebruik en wanneer iOS achtergrondtijd toestaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendarze są odzwierciedlane w Kalendarzu Apple bez otwierania jego aplikacji. Kanały na żywo odświeżają się, gdy Weekdot jest aktywny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os calendários são espelhados no Calendário da Apple sem abrir o app. Os feeds ao vivo são atualizados enquanto o Weekdot está ativo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os calendários são espelhados no Calendário da Apple sem abrir a app. Os feeds em direto são atualizados enquanto o Weekdot está ativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendarele sunt copiate în Calendarul Apple fără a-i deschide aplicația. Fluxurile live se reîmprospătează cât timp Weekdot este activ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Календари копируются в Календарь Apple без открытия приложения. Живые источники обновляются, пока Weekdot активен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendáre sa zrkadlia do Kalendára Apple bez otvárania jeho aplikácie. Živé kanály sa obnovujú, keď je Weekdot aktívny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendrar speglas till Apple Kalender utan att appen öppnas. Live-flöden uppdateras medan Weekdot är aktivt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินจะถูกคัดลอกไปยังปฏิทิน Apple โดยไม่ต้องเปิดแอป ฟีดแบบสดจะรีเฟรชขณะที่ Weekdot ทำงานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimler, uygulaması açılmadan Apple Takvim’e yansıtılır. Canlı akışlar Weekdot etkinken yenilenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Календарі копіюються в Календар Apple без відкриття програми. Живі джерела оновлюються, поки Weekdot активний."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch được sao chép sang Lịch Apple mà không cần mở ứng dụng. Nguồn cấp trực tiếp được làm mới khi Weekdot đang hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需打开“日历”App，日历即可同步到 Apple 日历。实时订阅源会在 Weekdot 处于活跃状态时刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不需打開「行事曆」App，行事曆即可同步到 Apple 行事曆。即時訂閱來源會在 Weekdot 使用中時重新整理。"
          }
        }
      }
    },
