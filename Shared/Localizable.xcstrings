    "Choose a country to subscribe to its public holidays. Subscribed calendars are managed by Apple Calendar and also appear in Weekdot when calendar access is enabled.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een land om je op de feestdagen te abonneren. Apple Agenda beheert de abonnementen; ze verschijnen ook in Weekdot als agendatoegang is toegestaan."
          }
        }
      }
    },
    "Choose iCloud to have the calendar on all your devices.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر iCloud ليكون التقويم على جميع أجهزتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria iCloud per tenir el calendari a tots els teus dispositius."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte iCloud, abyste kalendář měli na všech svých zařízeních."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg iCloud for at have kalenderen på alle dine enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle iCloud, um den Kalender auf all deinen Geräten zu haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε το iCloud για να έχετε το ημερολόγιο σε όλες τις συσκευές σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige iCloud para tener el calendario en todos tus dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse iCloud, niin kalenteri on kaikilla laitteillasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez iCloud pour avoir le calendrier sur tous vos appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור ב‑iCloud כדי שלוח השנה יהיה בכל המכשירים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सभी डिवाइस पर कैलेंडर पाने के लिए iCloud चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite iCloud kako biste kalendar imali na svim svojim uređajima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza az iCloudot, hogy a naptár minden eszközén elérhető legyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih iCloud agar kalender ada di semua perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli iCloud per avere il calendario su tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudを選択すると、すべてのデバイスでカレンダーを使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 캘린더를 사용하려면 iCloud를 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih iCloud untuk mempunyai kalendar pada semua peranti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg iCloud for å ha kalenderen på alle enhetene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies iCloud om de agenda op al je apparaten te hebben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz iCloud, aby mieć kalendarz na wszystkich swoich urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o iCloud para ter o calendário em todos os seus dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha iCloud para ter o calendário em todos os seus dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți iCloud pentru a avea calendarul pe toate dispozitivele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите iCloud, чтобы календарь был на всех ваших устройствах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte iCloud, aby ste kalendár mali na všetkých svojich zariadeniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj iCloud för att ha kalendern på alla dina enheter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก iCloud เพื่อให้มีปฏิทินนี้บนอุปกรณ์ทั้งหมดของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
