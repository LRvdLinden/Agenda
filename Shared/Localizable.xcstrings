        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit muuttaa tätä myöhemmin Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez modifier ce choix plus tard dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לשנות זאת מאוחר יותר ב״הגדרות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इसे बाद में सेटिंग्ज़ में बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
