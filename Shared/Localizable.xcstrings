    "KNVB Beker": {
      "extractionState": "manual"
    },
    "Kies je afvalophaler en voer je postcode en huisnummer in. Weekdot haalt de ophaaldagen op en controleert automatisch op wijzigingen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر خدمة جمع النفايات وأدخل الرمز البريدي ورقم المنزل. يجلب Weekdot أيام الجمع ويتحقق من التغييرات تلقائيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria el teu servei de recollida i introdueix el codi postal i el número. El Weekdot obté els dies de recollida i comprova automàticament si hi ha canvis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte svozovou společnost a zadejte PSČ a číslo domu. Weekdot načte dny svozu a automaticky kontroluje změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg din affaldsindsamler, og indtast dit postnummer og husnummer. Weekdot henter tømningsdagene og tjekker automatisk for ændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deinen Entsorger und gib Postleitzahl und Hausnummer ein. Weekdot ruft die Abholtermine ab und prüft automatisch auf Änderungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε την υπηρεσία αποκομιδής και εισαγάγετε ταχυδρομικό κώδικα και αριθμό. Το Weekdot λαμβάνει τις ημέρες αποκομιδής και ελέγχει αυτόματα για αλλαγές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu servicio de recogida e introduce tu código postal y número. Weekdot obtiene los días de recogida y comprueba automáticamente si hay cambios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse jätehuoltoyhtiö ja syötä postinumero ja talonumero. Weekdot hakee tyhjennyspäivät ja tarkistaa muutokset automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre collecteur de déchets et saisissez votre code postal et votre numéro. Weekdot récupère les jours de collecte et vérifie automatiquement les changements."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר את שירות פינוי האשפה והזן מיקוד ומספר בית. Weekdot טוען את ימי האיסוף ובודק שינויים אוטומטית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना कचरा संग्रहकर्ता चुनें और अपना पिन कोड और मकान नंबर दर्ज करें। Weekdot संग्रह की तारीखें प्राप्त करता है और बदलावों की अपने आप जाँच करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite službu za odvoz otpada i unesite poštanski i kućni broj. Weekdot dohvaća dane odvoza i automatski provjerava promjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki a hulladékszállítót, és adja meg az irányítószámot és a házszámot. A Weekdot lekéri a gyűjtési napokat, és automatikusan ellenőrzi a változásokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih pengangkut sampah Anda dan masukkan kode pos serta nomor rumah. Weekdot mengambil tanggal pengangkutan dan memeriksa perubahan secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il tuo gestore rifiuti e inserisci CAP e numero civico. Weekdot recupera i giorni di raccolta e controlla automaticamente eventuali modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ごみ収集業者を選び、郵便番号と番地を入力してください。Weekdotが収集日を取得し、変更を自動的に確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰레기 수거 업체를 선택하고 우편번호와 번지를 입력하십시오. Weekdot이 수거일을 가져오고 변경 사항을 자동으로 확인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih pengutip sampah anda dan masukkan poskod serta nombor rumah. Weekdot mengambil tarikh kutipan dan menyemak perubahan secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg renovatøren din, og skriv inn postnummer og husnummer. Weekdot henter tømmedagene og ser automatisk etter endringer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je afvalophaler en voer je postcode en huisnummer in. Weekdot haalt de ophaaldagen op en controleert automatisch op wijzigingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz firmę odbierającą odpady i wpisz kod pocztowy oraz numer domu. Weekdot pobierze dni odbioru i automatycznie sprawdzi zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha sua empresa de coleta e digite seu CEP e número. O Weekdot obtém os dias de coleta e verifica alterações automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a sua entidade de recolha e introduza o código postal e o número de porta. O Weekdot obtém os dias de recolha e verifica automaticamente se há alterações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți serviciul de colectare și introduceți codul poștal și numărul casei. Weekdot preia zilele de colectare și verifică automat modificările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите службу вывоза мусора и введите индекс и номер дома. Weekdot получит дни вывоза и будет автоматически проверять изменения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte zberovú spoločnosť a zadajte PSČ a číslo domu. Weekdot načíta dni odvozu a automaticky kontroluje zmeny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj din sophämtare och ange postnummer och husnummer. Weekdot hämtar hämtningsdagarna och söker automatiskt efter ändringar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกผู้ให้บริการเก็บขยะของคุณและป้อนรหัสไปรษณีย์และบ้านเลขที่ Weekdot จะดึงวันเก็บขยะและตรวจสอบการเปลี่ยนแปลงโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atık toplama hizmetinizi seçin ve posta kodunuzu ve kapı numaranızı girin. Weekdot toplama günlerini alır ve değişiklikleri otomatik olarak denetler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть службу вивезення сміття та введіть поштовий індекс і номер будинку. Weekdot отримає дні вивезення й автоматично перевірятиме зміни."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn đơn vị thu gom rác và nhập mã bưu chính cùng số nhà. Weekdot sẽ tải ngày thu gom và tự động kiểm tra thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你的垃圾收集商，然后输入邮政编码和门牌号。Weekdot 会获取收集日期并自动检查更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你的垃圾收運業者，然後輸入郵遞區號和門牌號碼。Weekdot 會取得收運日期並自動檢查變更。"
          }
        }
      }
    },
