    "After saving, open the event and tap Send Invitation to send it by mail or chat.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الحفظ، افتح الحدث واضغط على \"إرسال دعوة\" لإرسالها عبر البريد أو الدردشة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després de desar, obre l’esdeveniment i toca “Envia la invitació” per enviar-la per correu o per missatge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po uložení otevřete událost a klepněte na Odeslat pozvánku, abyste ji poslali e-mailem nebo zprávou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har gemt, skal du åbne begivenheden og trykke på “Send invitation” for at sende den via mail eller chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne nach dem Sichern das Ereignis und tippe auf „Einladung senden“, um sie per Mail oder Chat zu senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά την αποθήκευση, ανοίξτε το συμβάν και αγγίξτε «Αποστολή πρόσκλησης» για να τη στείλετε με email ή μήνυμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de guardar, abre el evento y toca “Enviar invitación” para enviarla por correo o chat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennuksen jälkeen avaa tapahtuma ja napauta ”Lähetä kutsu” lähettääksesi sen sähköpostilla tai chatissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’enregistrement, ouvrez l’événement et touchez « Envoyer l’invitation » pour l’envoyer par e-mail ou message."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר השמירה, פתח את האירוע והקש על ״שלח הזמנה״ כדי לשלוח אותה בדואר או בצ׳אט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने के बाद, इवेंट खोलें और मेल या चैट से भेजने के लिए \"आमंत्रण भेजें\" पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon spremanja otvorite događaj i dodirnite Pošalji pozivnicu kako biste je poslali e-poštom ili porukom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentés után nyissa meg az eseményt, és koppintson a Meghívó küldése gombra, hogy e-mailben vagy üzenetben elküldje."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah menyimpan, buka acara dan ketuk Kirim Undangan untuk mengirimnya melalui email atau chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver salvato, apri l’evento e tocca “Invia invito” per inviarlo via e-mail o chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存後、イベントを開いて「招待を送信」をタップすると、メールやメッセージで送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 후 이벤트를 열고 초대 보내기를 탭하여 메일이나 채팅으로 보내십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas menyimpan, buka acara dan ketik Hantar Jemputan untuk menghantarnya melalui mel atau sembang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har arkivert, åpner du hendelsen og trykker på «Send invitasjon» for å sende den via e-post eller chat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open na het bewaren de activiteit en tik op 'Verstuur uitnodiging' om deze per mail of chat te versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zachowaniu otwórz wydarzenie i stuknij Wyślij zaproszenie, aby wysłać je e-mailem lub w wiadomości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de salvar, abra o evento e toque em “Enviar convite” para enviá-lo por e-mail ou chat."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de guardar, abra o evento e toque em “Enviar convite” para o enviar por e-mail ou chat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După salvare, deschide evenimentul și apasă Trimite invitația pentru a o trimite prin e-mail sau mesaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После сохранения откройте событие и коснитесь «Отправить приглашение», чтобы отправить его по почте или в сообщении."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po uložení otvorte udalosť a klepnite na Odoslať pozvánku, aby ste ju poslali e-mailom alebo správou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du har sparat öppnar du händelsen och trycker på ”Skicka inbjudan” för att skicka den via mejl eller chatt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากบันทึก ให้เปิดเหตุการณ์แล้วแตะ ส่งคำเชิญ เพื่อส่งทางเมลหรือแชท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettikten sonra etkinliği açın ve e-postayla veya mesajla göndermek için Davet Gönder’e dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після збереження відкрийте подію й торкніться «Надіслати запрошення», щоб надіслати його поштою або в повідомленні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi lưu, hãy mở sự kiện và chạm vào Gửi lời mời để gửi qua mail hoặc tin nhắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储后，打开日程并轻点“发送邀请”，即可通过邮件或聊天发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存後，打開行程並點一下「傳送邀請」，即可透過郵件或聊天傳送。"
          }
        }
      }
    },
