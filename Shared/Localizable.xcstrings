    "First choose a country. Then explore holidays, sport, school breaks and more.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بلدًا أولًا. ثم استكشف العطلات والرياضة والعطلات المدرسية والمزيد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer tria un país. Després explora festius, esports, vacances escolars i més."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve vyberte zemi. Pak objevujte svátky, sport, školní prázdniny a další."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg først et land. Udforsk derefter helligdage, sport, skoleferier og meget mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zuerst ein Land. Entdecke dann Feiertage, Sport, Schulferien und mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε πρώτα μια χώρα. Στη συνέχεια εξερευνήστε αργίες, αθλήματα, σχολικές διακοπές και άλλα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero elige un país. Después explora festivos, deportes, vacaciones escolares y más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse ensin maa. Tutki sitten pyhäpäiviä, urheilua, koulujen lomia ja paljon muuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d’abord un pays. Explorez ensuite les jours fériés, le sport, les vacances scolaires et plus encore."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר תחילה מדינה. לאחר מכן גלה חגים, ספורט, חופשות מבית הספר ועוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले एक देश चुनें। फिर छुट्टियाँ, खेल, स्कूल की छुट्टियाँ और बहुत कुछ एक्सप्लोर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije odaberite zemlju. Zatim istražite praznike, sport, školske praznike i više."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először válasszon országot. Ezután fedezze fel az ünnepeket, a sportot, az iskolai szüneteket és még sok mást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih negara terlebih dahulu. Lalu jelajahi hari libur, olahraga, libur sekolah, dan lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli prima un paese. Poi esplora festività, sport, vacanze scolastiche e altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず国を選択してください。その後、祝日、スポーツ、学校の休みなどを探せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 국가를 선택하십시오. 그런 다음 공휴일, 스포츠, 방학 등을 탐색할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih negara dahulu. Kemudian teroka cuti umum, sukan, cuti sekolah dan banyak lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg først et land. Utforsk deretter helligdager, sport, skoleferier og mye mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies eerst een land. Ontdek daarna feestdagen, sport, schoolvakanties en meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw wybierz kraj. Potem odkrywaj święta, sport, ferie szkolne i nie tylko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha primeiro um país. Depois explore feriados, esportes, férias escolares e muito mais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha primeiro um país. Depois explore feriados, desporto, férias escolares e muito mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți mai întâi o țară. Apoi explorați sărbători, sport, vacanțe școlare și altele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите страну. Затем смотрите праздники, спорт, школьные каникулы и многое другое."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv vyberte krajinu. Potom objavujte sviatky, šport, školské prázdniny a ďalšie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj först ett land. Utforska sedan helgdagar, sport, skollov och mycket mer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกประเทศก่อน จากนั้นสำรวจวันหยุด กีฬา วันหยุดโรงเรียน และอื่นๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir ülke seçin. Ardından tatilleri, sporu, okul tatillerini ve daha fazlasını keşfedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу виберіть країну. Потім переглядайте свята, спорт, шкільні канікули й багато іншого."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước tiên hãy chọn quốc gia. Sau đó khám phá ngày lễ, thể thao, kỳ nghỉ học và nhiều hơn nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择国家/地区，然后探索节假日、体育、学校假期等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先選擇國家或地區，然後探索節日、運動、學校假期等。"
          }
        }
      }
    },
