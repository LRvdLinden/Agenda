    "Templates appear under the + button and at the top of a new event.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر القوالب أسفل الزر + وفي أعلى الحدث الجديد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantilles apareixen sota el botó + i a la part superior d’un esdeveniment nou."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šablony najdete pod tlačítkem + a v horní části nové události."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skabeloner vises under knappen + og øverst i en ny begivenhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlagen erscheinen unter der Taste „+“ und oben in einem neuen Ereignis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πρότυπα εμφανίζονται κάτω από το κουμπί + και στο πάνω μέρος ενός νέου συμβάντος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas aparecen bajo el botón + y en la parte superior de un nuevo evento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohjat näkyvät +-painikkeen alla ja uuden tapahtuman yläosassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles apparaissent sous le bouton + et en haut d’un nouvel événement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התבניות מופיעות מתחת לכפתור + ובראש אירוע חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेम्पलेट + बटन के नीचे और नए इवेंट के शीर्ष पर दिखाई देते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predlošci se pojavljuju ispod tipke + i na vrhu novog događaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sablonok a + gomb alatt és az új esemény tetején jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat muncul di bawah tombol + dan di bagian atas acara baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli appaiono sotto il pulsante + e in cima a un nuovo evento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートは＋ボタンの下と新規イベントの上部に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿은 + 버튼 아래와 새로운 이벤트 상단에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat muncul di bawah butang + dan di bahagian atas acara baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maler vises under +-knappen og øverst i en ny hendelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjablonen verschijnen onder de +-knop en bovenaan een nieuwe activiteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szablony pojawiają się pod przyciskiem + i na górze nowego wydarzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos aparecem no botão + e no topo de um novo evento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos aparecem sob o botão + e no topo de um novo evento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șabloanele apar sub butonul + și în partea de sus a unui eveniment nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны появляются под кнопкой + и вверху нового события."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Šablóny nájdete pod tlačidlom + a v hornej časti novej udalosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mallar visas under knappen + och högst upp i en ny händelse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม่แบบจะแสดงใต้ปุ่ม + และที่ด้านบนของเหตุการณ์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablonlar + düğmesinin altında ve yeni bir etkinliğin en üstünde görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони з’являються під кнопкою + і вгорі нової події."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu xuất hiện dưới nút + và ở đầu sự kiện mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板会显示在“+”按钮下方以及新日程的顶部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本會顯示在「+」按鈕下方及新行程的頂部。"
          }
        }
      }
    },
    "Templates, copy & paste and drag & drop": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
