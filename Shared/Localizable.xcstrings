    "Switch quickly between groups of calendars, for example Work and Family.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدّل بسرعة بين مجموعات التقويمات، مثل العمل والعائلة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvia ràpidament entre grups de calendaris, per exemple Feina i Família."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychle přepínejte mezi skupinami kalendářů, například Práce a Rodina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift hurtigt mellem grupper af kalendere, f.eks. Arbejde og Familie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle schnell zwischen Kalendergruppen, zum Beispiel Arbeit und Familie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εναλλαγή γρήγορα μεταξύ ομάδων ημερολογίων, για παράδειγμα Εργασία και Οικογένεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia rápidamente entre grupos de calendarios, por ejemplo Trabajo y Familia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda nopeasti kalenteriryhmien välillä, esimerkiksi Työ ja Perhe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez rapidement d’un groupe de calendriers à l’autre, par exemple Travail et Famille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעבר מהיר בין קבוצות של לוחות שנה, למשל עבודה ומשפחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर के समूहों के बीच तेज़ी से स्विच करें, जैसे काम और परिवार।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brzo se prebacujte između grupa kalendara, na primjer Posao i Obitelj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Váltson gyorsan naptárcsoportok között, például Munka és Család."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih dengan cepat antara grup kalender, misalnya Kerja dan Keluarga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa rapidamente da un gruppo di calendari all’altro, ad esempio Lavoro e Famiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕事や家族など、カレンダーのグループをすばやく切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업무, 가족 등 캘린더 그룹 간에 빠르게 전환합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar dengan pantas antara kumpulan kalendar, contohnya Kerja dan Keluarga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt raskt mellom grupper av kalendere, for eksempel Jobb og Familie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel snel tussen groepen agenda's, bijvoorbeeld Werk en Gezin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybko przełączaj się między grupami kalendarzy, na przykład Praca i Rodzina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne rapidamente entre grupos de calendários, por exemplo Trabalho e Família."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne rapidamente entre grupos de calendários, por exemplo Trabalho e Família."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comutați rapid între grupuri de calendare, de exemplu Serviciu și Familie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро переключайтесь между группами календарей, например «Работа» и «Семья»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýchlo prepínajte medzi skupinami kalendárov, napríklad Práca a Rodina."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växla snabbt mellan grupper av kalendrar, till exempel Arbete och Familj."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับระหว่างกลุ่มปฏิทินได้อย่างรวดเร็ว เช่น งานและครอบครัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim grupları arasında hızla geçiş yapın; örneğin İş ve Aile."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидко перемикайтеся між групами календарів, наприклад «Робота» і «Сім’я»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển nhanh giữa các nhóm lịch, ví dụ Công việc và Gia đình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在日历组之间快速切换，例如工作和家庭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在行事曆組合之間快速切換，例如工作和家庭。"
          }
        }
      }
