    "Dit adres is niet gevonden bij de gekozen afvalophaler.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على هذا العنوان لدى خدمة جمع النفايات المختارة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha trobat aquesta adreça al servei de recollida escollit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato adresa nebyla u vybrané svozové společnosti nalezena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen blev ikke fundet hos den valgte affaldsindsamler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse wurde beim gewählten Entsorger nicht gefunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διεύθυνση δεν βρέθηκε στην επιλεγμένη υπηρεσία αποκομιδής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado esta dirección en el servicio de recogida elegido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoitetta ei löytynyt valitulta jätehuoltoyhtiöltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse est introuvable chez le collecteur de déchets choisi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתובת לא נמצאה אצל שירות פינוי האשפה שנבחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए कचरा संग्रहकर्ता के पास यह पता नहीं मिला।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova adresa nije pronađena kod odabrane službe za odvoz otpada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a cím nem található a kiválasztott hulladékszállítónál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat ini tidak ditemukan pada pengangkut sampah yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo indirizzo non è stato trovato presso il gestore rifiuti scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したごみ収集業者でこの住所が見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 쓰레기 수거 업체에서 이 주소를 찾을 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat ini tidak ditemui pada pengutip sampah yang dipilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen ble ikke funnet hos den valgte renovatøren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit adres is niet gevonden bij de gekozen afvalophaler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono tego adresu u wybranej firmy odbierającej odpady."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endereço não foi encontrado na empresa de coleta escolhida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta morada não foi encontrada na entidade de recolha escolhida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această adresă nu a fost găsită la serviciul de colectare ales."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот адрес не найден у выбранной службы вывоза мусора."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto adresa sa u vybranej zberovej spoločnosti nenašla."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen hittades inte hos den valda sophämtaren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบที่อยู่นี้ที่ผู้ให้บริการเก็บขยะที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adres seçilen atık toplama hizmetinde bulunamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю адресу не знайдено в обраній службі вивезення сміття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy địa chỉ này ở đơn vị thu gom rác đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
