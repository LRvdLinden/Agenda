    "Allow access to your calendars to see your events.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى التقويمات لرؤية أحداثك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet l’accés als calendaris per veure els teus esdeveniments."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup ke kalendářům, abyste viděli své události."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv adgang til dine kalendere for at se dine begivenheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf deine Kalender, um deine Ereignisse zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε την πρόσβαση στα ημερολόγιά σας για να βλέπετε τα συμβάντα σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a tus calendarios para ver tus eventos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli kalentereiden käyttö, jotta näet tapahtumasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à vos calendriers pour voir vos événements."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאפשר גישה ללוחות השנה כדי לראות את האירועים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने इवेंट देखने के लिए अपने कैलेंडर तक ऐक्सेस की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite pristup kalendarima kako biste vidjeli svoje događaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a hozzáférést a naptáraihoz az események megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses ke kalender Anda untuk melihat acara Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso ai tuoi calendari per vedere i tuoi eventi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントを表示するには、カレンダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트를 보려면 캘린더에 대한 접근을 허용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan akses kepada kalendar anda untuk melihat acara anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi tilgang til kalenderne dine for å se hendelsene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang tot je agenda's om je activiteiten te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do kalendarzy, aby widzieć swoje wydarzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos seus calendários para ver seus eventos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso aos seus calendários para ver os seus eventos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți accesul la calendare pentru a vă vedea evenimentele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к календарям, чтобы видеть свои события."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte prístup ku kalendárom, aby ste videli svoje udalosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt åtkomst till dina kalendrar för att se dina händelser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้เข้าถึงปฏิทินของคุณเพื่อดูเหตุการณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinliklerinizi görmek için takvimlerinize erişime izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте доступ до календарів, щоб бачити свої події."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập lịch để xem các sự kiện của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问你的日历以查看日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許取用你的行事曆以查看行程。"
          }
        }
      }
    },
