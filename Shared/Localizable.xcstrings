        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot používa účty aplikácie Kalendár. Pridajte raz Google, Outlook, Exchange, Yahoo alebo CalDAV a všetky ich kalendáre sa v Weekdot zobrazia automaticky."
          }
