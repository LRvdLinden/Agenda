    "Go to Date": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانتقال إلى تاريخ"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ves a una data"
          }
