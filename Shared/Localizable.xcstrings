    "Could not open Apple Calendar. Use Share Subscription Link instead.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر فتح تقويم Apple. استخدم «مشاركة رابط الاشتراك» بدلًا من ذلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut obrir el Calendari d’Apple. Fes servir “Comparteix l’enllaç de subscripció”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendář Apple se nepodařilo otevřít. Použijte místo toho Sdílet odkaz na odběr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke åbne Apple Kalender. Brug Del abonnementslink i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Kalender konnte nicht geöffnet werden. Verwende stattdessen „Abo-Link teilen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατό το άνοιγμα του Ημερολογίου Apple. Χρησιμοποιήστε την Κοινή χρήση συνδέσμου συνδρομής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir Calendario de Apple. Usa “Compartir enlace de suscripción”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Applen Kalenteria ei voitu avata. Käytä sen sijaan toimintoa Jaa tilauslinkki."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir Calendrier d’Apple. Utilisez plutôt « Partager le lien d’abonnement »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לפתוח את לוח השנה של Apple. השתמש במקום זאת ב״שתף קישור למינוי״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple कैलेंडर नहीं खुल सका। इसके बजाय \"सब्सक्रिप्शन लिंक शेयर करें\" का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Kalendar nije moguće otvoriti. Umjesto toga upotrijebite Podijeli poveznicu pretplate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Naptár nem nyitható meg. Használja helyette az Előfizetési link megosztása lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membuka Kalender Apple. Gunakan Bagikan Tautan Langganan sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire Calendario di Apple. Usa invece “Condividi link di iscrizione”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleカレンダーを開けませんでした。代わりに「照会リンクを共有」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 캘린더를 열 수 없습니다. 대신 구독 링크 공유를 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membuka Kalendar Apple. Gunakan Kongsi Pautan Langganan sebaliknya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke åpne Apple Kalender. Bruk Del abonnementslenke i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Agenda kon niet worden geopend. Gebruik 'Abonnementslink delen' om de link over te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć Kalendarza Apple. Zamiast tego użyj opcji Udostępnij link subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o Calendário da Apple. Use “Compartilhar Link da Assinatura”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o Calendário da Apple. Utilize “Partilhar ligação da subscrição”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendarul Apple nu a putut fi deschis. Folosiți în schimb Partajează linkul abonamentului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть Календарь Apple. Используйте «Поделиться ссылкой на подписку»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendár Apple sa nepodarilo otvoriť. Použite namiesto toho Zdieľať odkaz na odber."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att öppna Apple Kalender. Använd Dela prenumerationslänk i stället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปิดปฏิทิน Apple ได้ ให้ใช้ แชร์ลิงก์การสมัครรับ แทน"
          }
        },
        "tr": {
