    "Logos and crests are trademarks of their respective owners and are shown for identification only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشعارات علامات تجارية لمالكيها وتُعرض لأغراض التعريف فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els logotips i escuts són marques comercials dels seus respectius propietaris i es mostren només per identificar-los."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Loga a znaky jsou ochranné známky příslušných vlastníků a zobrazují se pouze pro identifikaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Logoer og klubmærker er varemærker tilhørende deres respektive ejere og vises kun til identifikation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Logos und Wappen sind Marken ihrer jeweiligen Inhaber und werden nur zur Identifizierung angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα λογότυπα και τα εμβλήματα είναι εμπορικά σήματα των αντίστοιχων κατόχων τους και εμφανίζονται μόνο για αναγνώριση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los logotipos y escudos son marcas comerciales de sus respectivos propietarios y se muestran solo a efectos de identificación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Logot ja tunnukset ovat omistajiensa tavaramerkkejä, ja ne näytetään vain tunnistamista varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les logos et écussons sont des marques de leurs propriétaires respectifs et ne sont affichés qu’à des fins d’identification."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הלוגואים והסמלים הם סימנים מסחריים של בעליהם ומוצגים לצורכי זיהוי בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोगो और क्रेस्ट उनके संबंधित स्वामियों के ट्रेडमार्क हैं और केवल पहचान के लिए दिखाए गए हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logotipi i grbovi zaštitni su znakovi njihovih vlasnika i prikazani su samo radi identifikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A logók és címerek a tulajdonosaik védjegyei, és csak azonosítás céljából jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo dan lambang adalah merek dagang dari pemiliknya masing-masing dan ditampilkan hanya untuk identifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Loghi e stemmi sono marchi dei rispettivi proprietari e sono mostrati solo a scopo identificativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロゴとエンブレムは各所有者の商標であり、識別の目的でのみ表示されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로고와 엠블럼은 각 소유자의 상표이며 식별 목적으로만 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo dan lambang ialah tanda dagangan pemilik masing-masing dan dipaparkan untuk pengenalan sahaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logoer og klubbmerker er varemerker som tilhører sine respektive eiere, og vises kun for identifikasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo's en clubwapens zijn handelsmerken van hun respectieve eigenaren en worden alleen ter herkenning getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo i herby są znakami towarowymi ich właścicieli i są pokazywane wyłącznie w celach identyfikacyjnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Logotipos e escudos são marcas registradas de seus respectivos proprietários e são exibidos apenas para identificação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os logótipos e emblemas são marcas comerciais dos respetivos proprietários e são apresentados apenas para identificação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Siglele și emblemele sunt mărci comerciale ale proprietarilor lor și sunt afișate doar pentru identificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Логотипы и эмблемы являются товарными знаками соответствующих владельцев и показаны только для идентификации."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Logá a erby sú ochranné známky príslušných vlastníkov a zobrazujú sa iba na identifikáciu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logotyper och klubbmärken är varumärken som tillhör respektive ägare och visas endast i identifieringssyfte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โลโก้และตราสัญลักษณ์เป็นเครื่องหมายการค้าของเจ้าของแต่ละราย และแสดงเพื่อการระบุเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logolar ve armalar ilgili sahiplerinin ticari markalarıdır ve yalnızca tanımlama amacıyla gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Логотипи й емблеми є торговельними марками відповідних власників і показані лише для ідентифікації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo và huy hiệu là nhãn hiệu của chủ sở hữu tương ứng và chỉ được hiển thị để nhận diện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标志和队徽是其各自所有者的商标，仅用于识别目的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標誌和隊徽是其各自擁有者的商標，僅供識別之用。"
          }
        }
      }
    },
