    "This feed is already copied by Weekdot. Remove its direct copy after adding it to Apple Calendar to avoid duplicate events.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم Weekdot بنسخ هذا الموجز بالفعل. أزل النسخة المباشرة بعد إضافته إلى تقويم Apple لتجنب تكرار الأحداث."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Weekdot ja copia aquest feed. Elimina’n la còpia directa després d’afegir-lo al Calendari d’Apple per evitar esdeveniments duplicats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kanál už Weekdot kopíruje. Po přidání do Kalendáře Apple odstraňte jeho přímou kopii, abyste předešli duplicitním událostem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette feed kopieres allerede af Weekdot. Fjern den direkte kopi, når du har føjet det til Apple Kalender, for at undgå dobbelte begivenheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Feed wird bereits von Weekdot kopiert. Entferne die direkte Kopie, nachdem du ihn zu Apple Kalender hinzugefügt hast, um doppelte Ereignisse zu vermeiden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ροή έχει ήδη αντιγραφεί από το Weekdot. Αφαιρέστε το άμεσο αντίγραφο μετά την προσθήκη στο Ημερολόγιο Apple για να αποφύγετε διπλά συμβάντα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot ya copia este feed. Elimina su copia directa después de añadirlo a Calendario de Apple para evitar eventos duplicados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopioi jo tämän syötteen. Poista sen suora kopio lisättyäsi sen Applen Kalenteriin, jotta tapahtumat eivät näy kahteen kertaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce flux est déjà copié par Weekdot. Supprimez sa copie directe après l’avoir ajouté à Calendrier d’Apple pour éviter les événements en double."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot כבר מעתיק מקור זה. הסר את העותק הישיר לאחר הוספתו ללוח השנה של Apple כדי למנוע אירועים כפולים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ीड पहले से Weekdot द्वारा कॉपी किया जा रहा है। डुप्लिकेट इवेंट से बचने के लिए इसे Apple कैलेंडर में जोड़ने के बाद इसकी सीधी कॉपी हटाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot već kopira ovaj izvor. Nakon dodavanja u Apple Kalendar uklonite izravnu kopiju kako biste izbjegli dvostruke događaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a hírcsatornát a Weekdot már másolja. Miután hozzáadta az Apple Naptárhoz, távolítsa el a közvetlen másolatot, hogy elkerülje a duplikált eseményeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed ini sudah disalin oleh Weekdot. Hapus salinan langsungnya setelah menambahkannya ke Kalender Apple untuk menghindari acara ganda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo feed è già copiato da Weekdot. Rimuovi la copia diretta dopo averlo aggiunto a Calendario di Apple per evitare eventi duplicati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィードはすでにWeekdotによってコピーされています。イベントの重複を避けるため、Appleカレンダーに追加したあとで直接コピーを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 피드는 이미 Weekdot에서 복사하고 있습니다. 중복 이벤트를 방지하려면 Apple 캘린더에 추가한 후 직접 사본을 제거하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suapan ini sudah disalin oleh Weekdot. Alih keluar salinan terusnya selepas menambahkannya ke Kalendar Apple untuk mengelakkan acara berganda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne feeden kopieres allerede av Weekdot. Fjern den direkte kopien etter at du har lagt den til i Apple Kalender, for å unngå doble hendelser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze agenda wordt al door Weekdot gekopieerd. Verwijder na het toevoegen aan Apple Agenda de directe kopie om dubbele afspraken te voorkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kanał jest już kopiowany przez Weekdot. Po dodaniu go do Kalendarza Apple usuń jego bezpośrednią kopię, aby uniknąć zduplikowanych wydarzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este feed já é copiado pelo Weekdot. Remova a cópia direta depois de adicioná-lo ao Calendário da Apple para evitar eventos duplicados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este feed já é copiado pelo Weekdot. Remova a cópia direta depois de o adicionar ao Calendário da Apple para evitar eventos duplicados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest flux este deja copiat de Weekdot. Eliminați copia directă după ce îl adăugați în Calendarul Apple, pentru a evita evenimentele duplicate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot уже копирует этот источник. После добавления в Календарь Apple удалите прямую копию, чтобы избежать повторяющихся событий."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kanál už Weekdot kopíruje. Po pridaní do Kalendára Apple odstráňte jeho priamu kópiu, aby ste predišli duplicitným udalostiam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här flödet kopieras redan av Weekdot. Ta bort den direkta kopian när du har lagt till det i Apple Kalender för att undvika dubbletter av händelser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟีดนี้ถูกคัดลอกโดย Weekdot อยู่แล้ว ให้เอาสำเนาโดยตรงออกหลังจากเพิ่มไปยังปฏิทิน Apple เพื่อหลีกเลี่ยงเหตุการณ์ซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu akış Weekdot tarafından zaten kopyalanıyor. Yinelenen etkinlikleri önlemek için Apple Takvim’e ekledikten sonra doğrudan kopyasını kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot уже копіює це джерело. Після додавання в Календар Apple вилучіть пряму копію, щоб уникнути повторюваних подій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn cấp này đã được Weekdot sao chép. Hãy xóa bản sao trực tiếp sau khi thêm vào Lịch Apple để tránh sự kiện trùng lặp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此订阅源已由 Weekdot 复制。将其添加到 Apple 日历后，请移除直接副本以避免日程重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此訂閱來源已由 Weekdot 拷貝。將其加入 Apple 行事曆後，請移除直接副本以避免行程重複。"
          }
        }
      }
    },
