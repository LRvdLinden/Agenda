        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğiniz şablonlar burada görünür. Weekdot önceden yüklenmiş şablon içermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являться ваші збережені шаблони. Weekdot не містить попередньо встановлених шаблонів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mẫu bạn đã lưu sẽ xuất hiện ở đây. Weekdot không có mẫu dựng sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你存储的模板将显示在这里。Weekdot 不包含预载模板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你儲存的範本會顯示在這裡。Weekdot 不含預先載入的範本。"
          }
        }
      }
    },
