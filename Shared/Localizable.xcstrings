    "Seven days at a glance.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبعة أيام في لمحة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Set dies d’un cop d’ull."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedm dní na první pohled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Syv dage på ét blik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieben Tage auf einen Blick."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επτά ημέρες με μια ματιά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siete días de un vistazo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitsemän päivää yhdellä silmäyksellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sept jours en un coup d’œil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שבעה ימים במבט אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नज़र में सात दिन।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedam dana na prvi pogled."
          }
        },
        "hu": {
          "stringUnit": {
