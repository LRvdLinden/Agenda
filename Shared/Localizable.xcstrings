    "De afvalkalender is momenteel niet bereikbaar. Probeer later opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقويم النفايات غير متاح حاليًا. حاول مرة أخرى لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendari de residus no està disponible ara mateix. Torna-ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendář svozu odpadu je momentálně nedostupný. Zkuste to později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Affaldskalenderen kan ikke nås i øjeblikket. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abfallkalender ist derzeit nicht erreichbar. Versuche es später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ημερολόγιο αποκομιδής δεν είναι διαθέσιμο αυτή τη στιγμή. Δοκιμάστε ξανά αργότερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario de residuos no está disponible en este momento. Inténtalo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätekalenteri ei ole juuri nyt tavoitettavissa. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier des déchets est actuellement inaccessible. Réessayez plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוח פינוי האשפה אינו זמין כרגע. נסה שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कचरा संग्रह कैलेंडर अभी उपलब्ध नहीं है। बाद में फिर से कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar odvoza otpada trenutačno nije dostupan. Pokušajte ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hulladéknaptár jelenleg nem érhető el. Próbálja újra később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender sampah saat ini tidak dapat dijangkau. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il calendario rifiuti al momento non è raggiungibile. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ごみ収集カレンダーに現在アクセスできません。あとでもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰레기 수거 캘린더에 현재 접근할 수 없습니다. 나중에 다시 시도하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar sampah tidak dapat dicapai pada masa ini. Cuba lagi kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avfallskalenderen kan ikke nås for øyeblikket. Prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afvalkalender is momenteel niet bereikbaar. Probeer later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendarz odpadów jest obecnie niedostępny. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário de coleta não está acessível no momento. Tente novamente mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário de resíduos não está acessível de momento. Tente novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendarul pentru deșeuri nu este disponibil momentan. Încercați din nou mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Календарь вывоза мусора сейчас недоступен. Повторите попытку позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendár odvozu odpadu je momentálne nedostupný. Skúste to neskôr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sophämtningskalendern går inte att nå just nu. Försök igen senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเข้าถึงปฏิทินเก็บขยะได้ในขณะนี้ โปรดลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atık takvimine şu anda ulaşılamıyor. Daha sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Календар вивезення сміття зараз недоступний. Спробуйте пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện không thể truy cập lịch thu gom rác. Vui lòng thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾收集日历当前无法访问。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法連線至垃圾收運行事曆。請稍後再試一次。"
          }
        }
      }
    },
    "De afvalophaler gaf HTTP-fout \\(code). Controleer het adres of probeer opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرجعت خدمة جمع النفايات خطأ HTTP \\(code). تحقق من العنوان أو حاول مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servei de recollida ha retornat l’error HTTP \\(code). Comprova l’adreça o torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svozová společnost vrátila chybu HTTP \\(code). Zkontrolujte adresu nebo to zkuste znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Affaldsindsamleren returnerede HTTP-fejl \\(code). Kontroller adressen, eller prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entsorger meldete HTTP-Fehler \\(code). Prüfe die Adresse oder versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπηρεσία αποκομιδής επέστρεψε σφάλμα HTTP \\(code). Ελέγξτε τη διεύθυνση ή δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de recogida devolvió el error HTTP \\(code). Comprueba la dirección o inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätehuoltoyhtiö palautti HTTP-virheen \\(code). Tarkista osoite tai yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le collecteur de déchets a renvoyé l’erreur HTTP \\(code). Vérifiez l’adresse ou réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות פינוי האשפה החזיר שגיאת HTTP \\(code). בדוק את הכתובת או נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कचरा संग्रहकर्ता ने HTTP त्रुटि \\(code) लौटाई। पता जाँचें या फिर से कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Služba za odvoz otpada vratila je HTTP pogrešku \\(code). Provjerite adresu ili pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hulladékszállító HTTP-hibát adott vissza (\\(code)). Ellenőrizze a címet, vagy próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
