    "Weekdot shows every calendar from the Calendar app. Changes are saved in your accounts and synced with iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض Weekdot كل التقويمات من تطبيق التقويم. تُحفظ التغييرات في حساباتك وتتم مزامنتها مع iCloud."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Weekdot mostra tots els calendaris de l’app Calendari. Els canvis es desen als teus comptes i se sincronitzen amb iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot zobrazuje všechny kalendáře z aplikace Kalendář. Změny se ukládají do vašich účtů a synchronizují přes iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot viser alle kalendere fra appen Kalender. Ændringer gemmes på dine konti og synkroniseres med iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot zeigt jeden Kalender aus der App „Kalender“. Änderungen werden in deinen Accounts gesichert und mit iCloud synchronisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Weekdot εμφανίζει όλα τα ημερολόγια από την εφαρμογή Ημερολόγιο. Οι αλλαγές αποθηκεύονται στους λογαριασμούς σας και συγχρονίζονται μέσω iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot muestra todos los calendarios de la app Calendario. Los cambios se guardan en tus cuentas y se sincronizan con iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot näyttää kaikki Kalenteri-apin kalenterit. Muutokset tallennetaan tileillesi ja synkronoidaan iCloudin kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot affiche tous les calendriers de l’app Calendrier. Les modifications sont enregistrées dans vos comptes et synchronisées avec iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot מציג כל לוח שנה מהאפליקציה ״לוח שנה״. השינויים נשמרים בחשבונות שלך ומסונכרנים עם iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot कैलेंडर ऐप का हर कैलेंडर दिखाता है। बदलाव आपके अकाउंट में सहेजे जाते हैं और iCloud से सिंक होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot prikazuje sve kalendare iz aplikacije Kalendar. Promjene se spremaju u vaše račune i sinkroniziraju putem iClouda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Weekdot a Naptár app összes naptárát megjeleníti. A módosítások a fiókjaiba mentődnek, és az iCloudon keresztül szinkronizálódnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot menampilkan setiap kalender dari app Kalender. Perubahan disimpan di akun Anda dan diselaraskan dengan iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot mostra tutti i calendari dell’app Calendario. Le modifiche vengono salvate nei tuoi account e sincronizzate con iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekdotはカレンダーAppのすべてのカレンダーを表示します。変更はアカウントに保存され、iCloudで同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot은 캘린더 앱의 모든 캘린더를 표시합니다. 변경 사항은 계정에 저장되고 iCloud와 동기화됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot menunjukkan setiap kalendar daripada app Kalendar. Perubahan disimpan dalam akaun anda dan diselaraskan dengan iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot viser alle kalendere fra Kalender-appen. Endringer lagres i kontoene dine og synkroniseres med iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
