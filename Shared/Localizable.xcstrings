    "Also show your iCloud, Google, Outlook and Exchange calendars from the Calendar app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض تقويمات iCloud وGoogle وOutlook وExchange من تطبيق التقويم أيضًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra també els calendaris d’iCloud, Google, Outlook i Exchange de l’app Calendari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazovat také kalendáře iCloud, Google, Outlook a Exchange z aplikace Kalendář."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis også dine iCloud-, Google-, Outlook- og Exchange-kalendere fra Kalender-appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige auch deine iCloud-, Google-, Outlook- und Exchange-Kalender aus der Kalender-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση και των ημερολογίων iCloud, Google, Outlook και Exchange από την εφαρμογή Ημερολόγιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar también tus calendarios de iCloud, Google, Outlook y Exchange de la app Calendario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä myös iCloud-, Google-, Outlook- ja Exchange-kalenterisi Kalenteri-apista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher aussi vos calendriers iCloud, Google, Outlook et Exchange de l’app Calendrier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג גם את לוחות השנה של iCloud,‏ Google,‏ Outlook ו-Exchange מהיישום ״לוח שנה״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर ऐप से अपने iCloud, Google, Outlook और Exchange कैलेंडर भी दिखाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži i svoje iCloud, Google, Outlook i Exchange kalendare iz aplikacije Kalendar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud-, Google-, Outlook- és Exchange-naptárak megjelenítése is a Naptár appból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan juga kalender iCloud, Google, Outlook, dan Exchange Anda dari app Kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra anche i tuoi calendari iCloud, Google, Outlook ed Exchange dall’app Calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーAppのiCloud、Google、Outlook、Exchangeのカレンダーも表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 앱의 iCloud, Google, Outlook 및 Exchange 캘린더도 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan juga kalendar iCloud, Google, Outlook dan Exchange anda daripada app Kalendar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis også iCloud-, Google-, Outlook- og Exchange-kalenderne dine fra Kalender-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon ook je iCloud-, Google-, Outlook- en Exchange-agenda's uit de Agenda-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj także swoje kalendarze iCloud, Google, Outlook i Exchange z aplikacji Kalendarz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar também seus calendários do iCloud, Google, Outlook e Exchange do app Calendário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar também os seus calendários iCloud, Google, Outlook e Exchange da app Calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează și calendarele iCloud, Google, Outlook și Exchange din aplicația Calendar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать также календари iCloud, Google, Outlook и Exchange из приложения «Календарь»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazovať aj kalendáre iCloud, Google, Outlook a Exchange z aplikácie Kalendár."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa även dina iCloud-, Google-, Outlook- och Exchange-kalendrar från appen Kalender."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงปฏิทิน iCloud, Google, Outlook และ Exchange ของคุณจากแอปปฏิทินด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim uygulamasındaki iCloud, Google, Outlook ve Exchange takvimlerinizi de gösterin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також показувати календарі iCloud, Google, Outlook і Exchange із програми «Календар»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị cả các lịch iCloud, Google, Outlook và Exchange của bạn từ ứng dụng Lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时显示“日历”App中的iCloud、Google、Outlook和Exchange日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
