        }
      }
    },
    "Sevn has no access to your calendars. Allow full access in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لدى Sevn وصول إلى تقويماتك. اسمح بالوصول الكامل في الإعدادات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Sevn no té accés als teus calendaris. Permet l’accés complet a Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn nemá přístup k vašim kalendářům. Povolte plný přístup v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn har ikke adgang til dine kalendere. Giv fuld adgang i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn hat keinen Zugriff auf deine Kalender. Erlaube den vollen Zugriff in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sevn δεν έχει πρόσβαση στα ημερολόγιά σας. Επιτρέψτε πλήρη πρόσβαση στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn no tiene acceso a tus calendarios. Permite el acceso total en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevnillä ei ole pääsyä kalentereihisi. Salli täysi pääsy Asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn n’a pas accès à vos calendriers. Autorisez l’accès complet dans Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל‑Sevn אין גישה ללוחות השנה שלך. יש לאפשר גישה מלאה ב״הגדרות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn के पास आपके कैलेंडर का ऐक्सेस नहीं है। सेटिंग्ज़ में पूर्ण ऐक्सेस की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn nema pristup vašim kalendarima. Dopustite potpuni pristup u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sevn nem fér hozzá a naptáraihoz. Engedélyezze a teljes hozzáférést a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn tidak memiliki akses ke kalender Anda. Izinkan akses penuh di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn non ha accesso ai tuoi calendari. Consenti l’accesso completo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevnはカレンダーにアクセスできません。「設定」でフルアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn이 캘린더에 접근할 수 없습니다. 설정에서 전체 접근을 허용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn tiada akses kepada kalendar anda. Benarkan akses penuh dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn har ikke tilgang til kalenderne dine. Gi full tilgang i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn heeft geen toegang tot je agenda's. Geef volledige toegang in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn nie ma dostępu do Twoich kalendarzy. Zezwól na pełny dostęp w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sevn não tem acesso aos seus calendários. Permita o acesso total em Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sevn não tem acesso aos seus calendários. Permita o acesso total nas Definições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn nu are acces la calendarele dvs. Permiteți accesul complet în Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Sevn нет доступа к вашим календарям. Разрешите полный доступ в Настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn nemá prístup k vašim kalendárom. Povoľte úplný prístup v Nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn har ingen åtkomst till dina kalendrar. Tillåt full åtkomst i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn ไม่มีสิทธิ์เข้าถึงปฏิทินของคุณ อนุญาตการเข้าถึงเต็มรูปแบบในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn’in takvimlerinize erişimi yok. Ayarlar’da tam erişime izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn не має доступу до ваших календарів. Дозвольте повний доступ у Параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn không có quyền truy cập lịch của bạn. Hãy cho phép truy cập toàn bộ trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn 无法访问你的日历。请在“设置”中允许完全访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn 無法取用你的行事曆。請在「設定」中允許完整取用權限。"
          }
        }
      }
    },
    "Sevn shows every calendar from the Calendar app. Changes are saved in your accounts and synced with iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض Sevn كل التقويمات من تطبيق التقويم. تُحفظ التغييرات في حساباتك وتتم مزامنتها مع iCloud."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Sevn mostra tots els calendaris de l’app Calendari. Els canvis es desen als teus comptes i se sincronitzen amb iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn zobrazuje všechny kalendáře z aplikace Kalendář. Změny se ukládají do vašich účtů a synchronizují přes iCloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn viser alle kalendere fra appen Kalender. Ændringer gemmes på dine konti og synkroniseres med iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn zeigt jeden Kalender aus der App „Kalender“. Änderungen werden in deinen Accounts gesichert und mit iCloud synchronisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sevn εμφανίζει όλα τα ημερολόγια από την εφαρμογή Ημερολόγιο. Οι αλλαγές αποθηκεύονται στους λογαριασμούς σας και συγχρονίζονται μέσω iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn muestra todos los calendarios de la app Calendario. Los cambios se guardan en tus cuentas y se sincronizan con iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn näyttää kaikki Kalenteri-apin kalenterit. Muutokset tallennetaan tileillesi ja synkronoidaan iCloudin kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn affiche tous les calendriers de l’app Calendrier. Les modifications sont enregistrées dans vos comptes et synchronisées avec iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn מציג כל לוח שנה מהאפליקציה ״לוח שנה״. השינויים נשמרים בחשבונות שלך ומסונכרנים עם iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn कैलेंडर ऐप का हर कैलेंडर दिखाता है। बदलाव आपके अकाउंट में सहेजे जाते हैं और iCloud से सिंक होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn prikazuje sve kalendare iz aplikacije Kalendar. Promjene se spremaju u vaše račune i sinkroniziraju putem iClouda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sevn a Naptár app összes naptárát megjeleníti. A módosítások a fiókjaiba mentődnek, és az iCloudon keresztül szinkronizálódnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn menampilkan setiap kalender dari app Kalender. Perubahan disimpan di akun Anda dan diselaraskan dengan iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn mostra tutti i calendari dell’app Calendario. Le modifiche vengono salvate nei tuoi account e sincronizzate con iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SevnはカレンダーAppのすべてのカレンダーを表示します。変更はアカウントに保存され、iCloudで同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn은 캘린더 앱의 모든 캘린더를 표시합니다. 변경 사항은 계정에 저장되고 iCloud와 동기화됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn menunjukkan setiap kalendar daripada app Kalendar. Perubahan disimpan dalam akaun anda dan diselaraskan dengan iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn viser alle kalendere fra Kalender-appen. Endringer lagres i kontoene dine og synkroniseres med iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn toont elke agenda uit de Agenda-app. Wijzigingen worden bewaard in je accounts en gesynchroniseerd met iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn pokazuje wszystkie kalendarze z aplikacji Kalendarz. Zmiany są zachowywane na Twoich kontach i synchronizowane z iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sevn mostra todos os calendários do app Calendário. As alterações são salvas nas suas contas e sincronizadas com o iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sevn mostra todos os calendários da app Calendário. As alterações são guardadas nas suas contas e sincronizadas com a iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn afișează toate calendarele din aplicația Calendar. Modificările sunt salvate în conturile dvs. și sincronizate prin iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn показывает все календари из приложения «Календарь». Изменения сохраняются в ваших учетных записях и синхронизируются с iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
