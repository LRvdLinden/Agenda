    "From local clubs to international championships.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الأندية المحلية إلى البطولات الدولية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dels clubs locals als campionats internacionals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od místních klubů po mezinárodní šampionáty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra lokale klubber til internationale mesterskaber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von lokalen Vereinen bis zu internationalen Meisterschaften."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από τοπικές ομάδες έως διεθνή πρωταθλήματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De los clubes locales a los campeonatos internacionales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallisista seuroista kansainvälisiin mestaruuskisoihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des clubs locaux aux championnats internationaux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממועדונים מקומיים ועד אליפויות בינלאומיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय क्लबों से लेकर अंतरराष्ट्रीय चैंपियनशिप तक।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Od lokalnih klubova do međunarodnih prvenstava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi kluboktól a nemzetközi bajnokságokig."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari klub lokal hingga kejuaraan internasional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai club locali ai campionati internazionali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地元のクラブから国際選手権まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 클럽부터 국제 선수권 대회까지."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daripada kelab tempatan hingga kejohanan antarabangsa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra lokale klubber til internasjonale mesterskap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van lokale clubs tot internationale kampioenschappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od lokalnych klubów po mistrzostwa międzynarodowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De clubes locais a campeonatos internacionais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos clubes locais aos campeonatos internacionais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De la cluburi locale la campionate internaționale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От местных клубов до международных чемпионатов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Od miestnych klubov po medzinárodné šampionáty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från lokala klubbar till internationella mästerskap."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งแต่สโมสรท้องถิ่นไปจนถึงการแข่งขันชิงแชมป์ระดับนานาชาติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel kulüplerden uluslararası şampiyonalara."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від місцевих клубів до міжнародних чемпіонатів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ câu lạc bộ địa phương đến giải vô địch quốc tế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本地俱乐部到国际锦标赛。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從在地俱樂部到國際錦標賽。"
          }
        }
      }
    },
    "Full Apple Calendar access and a writable calendar account are required. An iCloud calendar also appears on other devices signed into that account.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige agendatoegang en een beschrijfbare agenda-account zijn vereist. Een iCloud-agenda wordt ook zichtbaar op andere apparaten met hetzelfde account."
          }
        }
      }
    },
