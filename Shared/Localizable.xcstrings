    "Bekijk ophaaldagen en bewerk tekst": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض أيام الجمع وتعديل النص"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra els dies de recollida i edita el text"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit dny svozu a upravit text"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tømningsdage, og rediger tekst"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abholtermine ansehen und Text bearbeiten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε τις ημέρες αποκομιδής και επεξεργαστείτε το κείμενο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver días de recogida y editar texto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä tyhjennyspäivät ja muokkaa tekstiä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir les jours de collecte et modifier le texte"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג ימי איסוף וערוך טקסט"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रह की तारीखें देखें और टेक्स्ट संपादित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledaj dane odvoza i uredi tekst"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyűjtési napok megtekintése és szöveg szerkesztése"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat tanggal pengangkutan dan edit teks"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi i giorni di raccolta e modifica il testo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収集日を表示してテキストを編集"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수거일 보기 및 텍스트 편집"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat tarikh kutipan dan edit teks"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tømmedager og rediger tekst"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk ophaaldagen en bewerk tekst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz dni odbioru i edytuj tekst"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver dias de coleta e editar texto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver dias de recolha e editar texto"
          }
        },
        "ro": {
          "stringUnit": {
