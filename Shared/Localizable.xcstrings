          "stringUnit": {
            "state": "translated",
            "value": "Prihlás sa znova do Homey."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på Homey igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้า Homey อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homey'ye yeniden giriş yap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть у Homey знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng nhập lại Homey."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新登录 Homey。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新登入 Homey。"
          }
        }
      }
    },
    "Sign in with your Homey account and choose your Homey. Weekdot then sends your events of the coming 8 days to the Weekdot app on your Homey.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول بحساب Homey واختر جهازك. يرسل Weekdot بعد ذلك مواعيد الأيام الثمانية القادمة إلى تطبيق Weekdot على جهاز Homey."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la sessió amb el teu compte de Homey i tria el teu Homey. Weekdot enviarà els esdeveniments dels pròxims 8 dies a l'app Weekdot del teu Homey."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlas se účtem Homey a vyber svůj Homey. Weekdot pak odešle události na příštích 8 dní do aplikace Weekdot ve tvém Homey."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med din Homey-konto, og vælg din Homey. Weekdot sender så dine begivenheder for de næste 8 dage til Weekdot-appen på din Homey."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit deinem Homey-Konto an und wähle deinen Homey. Weekdot sendet dann deine Termine der nächsten 8 Tage an die Weekdot-App auf deinem Homey."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέσου με τον λογαριασμό Homey και επίλεξε το Homey σου. Το Weekdot στέλνει τα γεγονότα των επόμενων 8 ημερών στην εφαρμογή Weekdot του Homey σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con tu cuenta de Homey y elige tu Homey. Weekdot enviará tus eventos de los próximos 8 días a la app Weekdot de tu Homey."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu Homey-tililläsi ja valitse Homey. Weekdot lähettää sitten seuraavien 8 päivän tapahtumat Homeysi Weekdot-appiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec votre compte Homey et choisissez votre Homey. Weekdot envoie alors vos événements des 8 prochains jours à l'app Weekdot sur votre Homey."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחבר עם חשבון Homey ובחר את ה-Homey שלך. Weekdot ישלח את האירועים של 8 הימים הבאים לאפליקציית Weekdot ב-Homey שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Homey खाते से साइन इन करें और अपना Homey चुनें। Weekdot फिर अगले 8 दिनों के इवेंट आपके Homey पर Weekdot ऐप को भेजता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavi se Homey računom i odaberi svoj Homey. Weekdot zatim šalje događaje za sljedećih 8 dana aplikaciji Weekdot na tvom Homeyju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezz be a Homey-fiókoddal, és válaszd ki a Homeyt. A Weekdot ezután elküldi a következő 8 nap eseményeit a Homeyn lévő Weekdot alkalmazásnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk dengan akun Homey dan pilih Homey Anda. Weekdot lalu mengirim acara 8 hari ke depan ke aplikasi Weekdot di Homey Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con il tuo account Homey e scegli il tuo Homey. Weekdot invierà gli eventi dei prossimi 8 giorni all'app Weekdot sul tuo Homey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homeyアカウントでサインインし、Homeyを選択してください。Weekdotが今後8日間の予定をHomeyのWeekdotアプリに送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homey 계정으로 로그인하고 Homey를 선택하세요. Weekdot이 다음 8일의 일정을 Homey의 Weekdot 앱으로 보냅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar masuk dengan akaun Homey dan pilih Homey anda. Weekdot kemudian menghantar acara 8 hari akan datang ke apl Weekdot pada Homey anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på med Homey-kontoen din og velg Homey-en din. Weekdot sender da avtalene for de neste 8 dagene til Weekdot-appen på Homey-en din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in met je Homey-account en kies je Homey. Weekdot stuurt dan je afspraken van de komende 8 dagen naar de Weekdot-app op je Homey."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się kontem Homey i wybierz swój Homey. Weekdot wyśle wtedy wydarzenia z najbliższych 8 dni do aplikacji Weekdot na Twoim Homey."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre com sua conta Homey e escolha seu Homey. O Weekdot envia seus eventos dos próximos 8 dias para o app Weekdot no seu Homey."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão com a sua conta Homey e escolha o seu Homey. O Weekdot envia os eventos dos próximos 8 dias para a app Weekdot no seu Homey."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te cu contul Homey și alege Homey-ul tău. Weekdot trimite apoi evenimentele din următoarele 8 zile către aplicația Weekdot de pe Homey."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в аккаунт Homey и выберите свой Homey. Weekdot будет отправлять события на 8 дней вперёд в приложение Weekdot на вашем Homey."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlás sa účtom Homey a vyber svoj Homey. Weekdot potom odošle udalosti na nasledujúcich 8 dní do aplikácie Weekdot v tvojom Homey."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med ditt Homey-konto och välj din Homey. Weekdot skickar sedan dina händelser för de kommande 8 dagarna till Weekdot-appen på din Homey."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าด้วยบัญชี Homey และเลือก Homey ของคุณ จากนั้น Weekdot จะส่งกิจกรรม 8 วันข้างหน้าไปยังแอป Weekdot บน Homey ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homey hesabınla giriş yap ve Homey'ini seç. Weekdot sonraki 8 günün etkinliklerini Homey'indeki Weekdot uygulamasına gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть в акаунт Homey і виберіть свій Homey. Weekdot надсилатиме події на 8 днів наперед у застосунок Weekdot на вашому Homey."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng tài khoản Homey và chọn Homey của bạn. Weekdot sẽ gửi sự kiện của 8 ngày tới đến ứng dụng Weekdot trên Homey."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的 Homey 账户登录并选择你的 Homey。随后 Weekdot 会将未来 8 天的日程发送到你 Homey 上的 Weekdot 应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的 Homey 帳號登入並選擇你的 Homey。Weekdot 會將未來 8 天的行程傳送到你 Homey 上的 Weekdot App。"
          }
        }
      }
    },
