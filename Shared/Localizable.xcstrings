    "Town not found. Check the spelling or use your device location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على المدينة. تحقق من الإملاء أو استخدم موقع الجهاز."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha trobat la població. Comprova l’ortografia o fes servir la ubicació del dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obec nebyla nalezena. Zkontrolujte pravopis nebo použijte polohu zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Byen blev ikke fundet. Kontroller stavningen, eller brug enhedens lokalitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ort nicht gefunden. Prüfe die Schreibweise oder verwende den Gerätestandort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πόλη δεν βρέθηκε. Ελέγξτε την ορθογραφία ή χρησιμοποιήστε την τοποθεσία της συσκευής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado la localidad. Comprueba la ortografía o usa la ubicación del dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikkakuntaa ei löytynyt. Tarkista kirjoitusasu tai käytä laitteen sijaintia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ville introuvable. Vérifiez l’orthographe ou utilisez la position de votre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישוב לא נמצא. בדוק את האיות או השתמש במיקום המכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शहर नहीं मिला। वर्तनी जाँचें या अपने डिवाइस का स्थान उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjesto nije pronađeno. Provjerite pravopis ili upotrijebite lokaciju uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A település nem található. Ellenőrizze a helyesírást, vagy használja az eszköz helyzetét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kota tidak ditemukan. Periksa ejaan atau gunakan lokasi perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Località non trovata. Controlla l’ortografia o usa la posizione del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "市区町村が見つかりません。綴りを確認するか、デバイスの位置情報を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도시를 찾을 수 없습니다. 철자를 확인하거나 기기 위치를 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandar tidak ditemui. Semak ejaan atau gunakan lokasi peranti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ikke stedet. Kontroller stavemåten, eller bruk enhetens posisjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaats niet gevonden. Controleer de spelling of gebruik de locatie van je apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono miejscowości. Sprawdź pisownię lub użyj lokalizacji urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cidade não encontrada. Verifique a ortografia ou use a localização do dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Localidade não encontrada. Verifique a ortografia ou use a localização do dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Localitatea nu a fost găsită. Verificați ortografia sau folosiți localizarea dispozitivului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Город не найден. Проверьте написание или используйте геопозицию устройства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obec sa nenašla. Skontrolujte pravopis alebo použite polohu zariadenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Orten hittades inte. Kontrollera stavningen eller använd enhetens plats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบเมือง ตรวจสอบการสะกดหรือใช้ตำแหน่งที่ตั้งของอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yer bulunamadı. Yazımı denetleyin veya aygıt konumunu kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місто не знайдено. Перевірте написання або використайте локацію пристрою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy thị trấn. Hãy kiểm tra chính tả hoặc dùng vị trí thiết bị."
          }
        },
        "zh-Hans": {
