    "Other ICS / webcal Feed": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere ICS-/webcal-agenda"
          }
        }
      }
    },
    "Other useful calendars, such as week numbers, day numbers or any public ICS feed you choose.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقويمات مفيدة أخرى، مثل أرقام الأسابيع أو أرقام الأيام أو أي موجز ICS عام تختاره."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Altres calendaris útils, com ara números de setmana, números de dia o qualsevol feed ICS públic que triïs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další užitečné kalendáře, například čísla týdnů, čísla dnů nebo libovolný veřejný kanál ICS podle vašeho výběru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre nyttige kalendere, f.eks. ugenumre, dagnumre eller et hvilket som helst offentligt ICS-feed, du vælger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere nützliche Kalender, etwa Kalenderwochen, Tagesnummern oder ein beliebiger öffentlicher ICS-Feed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλα χρήσιμα ημερολόγια, όπως αριθμοί εβδομάδων, αριθμοί ημερών ή οποιαδήποτε δημόσια ροή ICS επιλέξετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros calendarios útiles, como números de semana, números de día o cualquier feed ICS público que elijas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muita hyödyllisiä kalentereita, kuten viikkonumerot, päivänumerot tai mikä tahansa valitsemasi julkinen ICS-syöte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres calendriers utiles, comme les numéros de semaine, les numéros de jour ou tout flux ICS public de votre choix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוחות שנה שימושיים נוספים, כמו מספרי שבועות, מספרי ימים או כל מקור ICS ציבורי שתבחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य उपयोगी कैलेंडर, जैसे सप्ताह संख्या, दिन संख्या या आपकी पसंद का कोई भी सार्वजनिक ICS फ़ीड।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostali korisni kalendari, poput brojeva tjedana, brojeva dana ili bilo kojeg javnog ICS izvora po vašem izboru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyéb hasznos naptárak, például hetek száma, napok száma vagy bármilyen választott nyilvános ICS-hírcsatorna."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender berguna lainnya, seperti nomor minggu, nomor hari, atau feed ICS publik apa pun pilihan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altri calendari utili, come numeri delle settimane, numeri dei giorni o qualsiasi feed ICS pubblico a tua scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週番号、日番号、任意の公開ICSフィードなど、その他の便利なカレンダー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 번호, 일 번호 또는 원하는 공개 ICS 피드 등 기타 유용한 캘린더."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar berguna lain, seperti nombor minggu, nombor hari atau sebarang suapan ICS awam pilihan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Andre nyttige kalendere, for eksempel ukenumre, dagnumre eller en hvilken som helst offentlig ICS-feed du velger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere handige agenda's, zoals weeknummers, dagnummers of elke openbare ICS-agenda die je kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne przydatne kalendarze, np. numery tygodni, numery dni lub dowolny wybrany publiczny kanał ICS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outros calendários úteis, como números das semanas, números dos dias ou qualquer feed ICS público que você escolher."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outros calendários úteis, como números das semanas, números dos dias ou qualquer feed ICS público à sua escolha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte calendare utile, precum numerele săptămânilor, numerele zilelor sau orice flux ICS public ales de dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие полезные календари, например номера недель, номера дней или любой открытый источник ICS на ваш выбор."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ďalšie užitočné kalendáre, napríklad čísla týždňov, čísla dní alebo ľubovoľný verejný kanál ICS podľa vášho výberu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Andra användbara kalendrar, till exempel veckonummer, dagnummer eller valfritt offentligt ICS-flöde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินที่มีประโยชน์อื่นๆ เช่น หมายเลขสัปดาห์ หมายเลขวัน หรือฟีด ICS สาธารณะใดก็ได้ที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta numaraları, gün numaraları veya seçtiğiniz herhangi bir genel ICS akışı gibi diğer kullanışlı takvimler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші корисні календарі, як-от номери тижнів, номери днів або будь-яке відкрите джерело ICS на ваш вибір."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lịch hữu ích khác, như số tuần, số ngày hoặc bất kỳ nguồn cấp ICS công khai nào bạn chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他实用日历，例如周数、日数或你选择的任何公开 ICS 订阅源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他實用的行事曆，例如週數、日數或你選擇的任何公開 ICS 訂閱來源。"
          }
        }
      }
    },
