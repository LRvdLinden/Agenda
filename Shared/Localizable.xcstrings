        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot werkt Homey bij als je afspraken veranderen, als je de app opent en af en toe op de achtergrond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot aktualizuje Homey, gdy zmieniają się wydarzenia, gdy otwierasz aplikację i od czasu do czasu w tle."
