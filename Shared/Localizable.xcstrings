      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ Sevn الإيموجي واللون ويزامنهما عبر iCloud. تعرض تطبيقات التقويم الأخرى لون التقويم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Sevn desa l’emoji i el color i els sincronitza amb iCloud. Les altres apps de calendari mostren el color del calendari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji a barvu ukládá Sevn a synchronizuje je přes iCloud. Ostatní kalendářové aplikace zobrazují barvu kalendáře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji og farve gemmes af Sevn og synkroniseres via iCloud. Andre kalenderapps viser kalenderens farve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji und Farbe werden von Sevn gesichert und über iCloud synchronisiert. Andere Kalender-Apps zeigen die Kalenderfarbe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το emoji και το χρώμα αποθηκεύονται από το Sevn και συγχρονίζονται μέσω iCloud. Άλλες εφαρμογές ημερολογίου εμφανίζουν το χρώμα του ημερολογίου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn guarda el emoji y el color, y los sincroniza mediante iCloud. Otras apps de calendario muestran el color del calendario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn tallentaa emojin ja värin ja synkronoi ne iCloudin kautta. Muut kalenteriapit näyttävät kalenterin värin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emoji et la couleur sont enregistrés par Sevn et synchronisés via iCloud. Les autres apps de calendrier affichent la couleur du calendrier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האמוג׳י והצבע נשמרים על ידי Sevn ומסונכרנים דרך iCloud. אפליקציות לוח שנה אחרות מציגות את צבע לוח השנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इमोजी और रंग Sevn द्वारा सहेजे जाते हैं और iCloud से सिंक होते हैं। अन्य कैलेंडर ऐप कैलेंडर का रंग दिखाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji i boju sprema Sevn i sinkronizira ih putem iClouda. Ostale aplikacije kalendara prikazuju boju kalendara."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emojit és a színt a Sevn menti, és az iCloudon keresztül szinkronizálja. Más naptárappok a naptár színét mutatják."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji dan warna disimpan oleh Sevn dan diselaraskan melalui iCloud. App kalender lain menampilkan warna kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji e colore vengono salvati da Sevn e sincronizzati tramite iCloud. Le altre app di calendario mostrano il colore del calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵文字と色はSevnによって保存され、iCloudで同期されます。ほかのカレンダーAppではカレンダーの色が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이모지와 색상은 Sevn에 저장되고 iCloud를 통해 동기화됩니다. 다른 캘린더 앱에서는 캘린더 색상이 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji dan warna disimpan oleh Sevn dan diselaraskan melalui iCloud. App kalendar lain menunjukkan warna kalendar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji og farge lagres av Sevn og synkroniseres via iCloud. Andre kalenderapper viser kalenderens farge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji en kleur worden door Sevn bewaard en via iCloud gesynchroniseerd. Andere agenda-apps tonen de agendakleur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji i kolor są zachowywane przez Sevn i synchronizowane przez iCloud. Inne aplikacje kalendarza pokazują kolor kalendarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O emoji e a cor são salvos pelo Sevn e sincronizados pelo iCloud. Outros apps de calendário mostram a cor do calendário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O emoji e a cor são guardados pelo Sevn e sincronizados através da iCloud. Outras apps de calendário mostram a cor do calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji-ul și culoarea sunt salvate de Sevn și sincronizate prin iCloud. Alte aplicații de calendar afișează culoarea calendarului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эмодзи и цвет сохраняются в Sevn и синхронизируются через iCloud. Другие приложения календаря показывают цвет календаря."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji a farbu ukladá Sevn a synchronizuje ich cez iCloud. Ostatné kalendárové aplikácie zobrazujú farbu kalendára."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji och färg sparas av Sevn och synkroniseras via iCloud. Andra kalenderappar visar kalenderns färg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีโมจิและสีจะถูกบันทึกโดย Sevn และซิงค์ผ่าน iCloud แอปปฏิทินอื่นจะแสดงสีของปฏิทิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji ve renk Sevn tarafından kaydedilir ve iCloud ile eşzamanlanır. Diğer takvim uygulamaları takvim rengini gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Емодзі й колір зберігаються в Sevn і синхронізуються через iCloud. Інші програми календаря показують колір календаря."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emoji và màu được Sevn lưu và đồng bộ hóa qua iCloud. Các ứng dụng lịch khác hiển thị màu của lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表情符号和颜色由 Sevn 存储并通过 iCloud 同步。其他日历 App 显示日历颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表情符號和顏色由 Sevn 儲存並透過 iCloud 同步。其他行事曆 App 會顯示行事曆顏色。"
          }
        }
      }
    },
