    "This calendar is read-only. Open the event and tap Edit to keep a changed copy in Weekdot.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التقويم للقراءة فقط. افتح الحدث واضغط على \"تعديل\" للاحتفاظ بنسخة معدلة في Weekdot."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest calendari és només de lectura. Obre l’esdeveniment i toca “Edita” per conservar una còpia modificada al Weekdot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kalendář je jen pro čtení. Otevřete událost a klepněte na Upravit, chcete-li si uložit upravenou kopii ve Weekdotu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kalender er skrivebeskyttet. Åbn begivenheden, og tryk på “Rediger” for at gemme en ændret kopi i Weekdot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kalender ist schreibgeschützt. Öffne das Ereignis und tippe auf „Bearbeiten“, um eine geänderte Kopie in Weekdot zu speichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το ημερολόγιο είναι μόνο για ανάγνωση. Ανοίξτε το συμβάν και αγγίξτε «Επεξεργασία» για να κρατήσετε ένα τροποποιημένο αντίγραφο στο Weekdot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este calendario es de solo lectura. Abre el evento y toca “Editar” para guardar una copia modificada en Weekdot."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kalenteri on vain luku -tilassa. Avaa tapahtuma ja napauta ”Muokkaa” säilyttääksesi muokatun kopion Weekdotissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce calendrier est en lecture seule. Ouvrez l’événement et touchez « Modifier » pour conserver une copie modifiée dans Weekdot."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוח שנה זה הוא לקריאה בלבד. פתח את האירוע והקש על ״ערוך״ כדי לשמור עותק ששונה ב-Weekdot."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कैलेंडर केवल पढ़ने योग्य है। Weekdot में बदली गई कॉपी रखने के लिए इवेंट खोलें और \"संपादित करें\" पर टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj kalendar je samo za čitanje. Otvorite događaj i dodirnite Uredi kako biste zadržali izmijenjenu kopiju u Weekdotu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a naptár csak olvasható. Nyissa meg az eseményt, és koppintson a Szerkesztés gombra, hogy egy módosított másolatot tartson meg a Weekdotban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender ini hanya-baca. Buka acara dan ketuk Edit untuk menyimpan salinan yang diubah di Weekdot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo calendario è di sola lettura. Apri l’evento e tocca “Modifica” per conservare una copia modificata in Weekdot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカレンダーは読み出し専用です。イベントを開いて「編集」をタップすると、変更したコピーがWeekdotに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 캘린더는 읽기 전용입니다. 이벤트를 열고 편집을 탭하면 변경된 사본이 Weekdot에 보관됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar ini adalah baca sahaja. Buka acara dan ketik Edit untuk menyimpan salinan yang diubah dalam Weekdot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kalenderen er skrivebeskyttet. Åpne hendelsen og trykk på «Rediger» for å beholde en endret kopi i Weekdot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze agenda is alleen-lezen. Open de activiteit en tik op 'Wijzig' om een gewijzigde kopie in Weekdot te bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kalendarz jest tylko do odczytu. Otwórz wydarzenie i stuknij Edycja, aby zachować zmienioną kopię w Weekdot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este calendário é somente leitura. Abra o evento e toque em “Editar” para manter uma cópia alterada no Weekdot."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este calendário é só de leitura. Abra o evento e toque em “Editar” para guardar uma cópia alterada no Weekdot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest calendar este doar pentru citire. Deschide evenimentul și apasă Editează pentru a păstra o copie modificată în Weekdot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот календарь доступен только для чтения. Откройте событие и коснитесь «Изменить», чтобы сохранить измененную копию в Weekdot."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kalendár je iba na čítanie. Otvorte udalosť a klepnite na Upraviť, ak si chcete ponechať zmenenú kópiu vo Weekdote."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här kalendern är skrivskyddad. Öppna händelsen och tryck på ”Redigera” för att spara en ändrad kopia i Weekdot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินนี้เป็นแบบอ่านอย่างเดียว เปิดเหตุการณ์แล้วแตะ แก้ไข เพื่อเก็บสำเนาที่เปลี่ยนแล้วไว้ใน Weekdot"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu takvim salt okunur. Değiştirilmiş bir kopyayı Weekdot’ta saklamak için etkinliği açın ve Düzenle’ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей календар доступний лише для читання. Відкрийте подію й торкніться «Редагувати», щоб зберегти змінену копію у Weekdot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch này ở chế độ chỉ đọc. Hãy mở sự kiện và chạm vào Sửa để giữ một bản sao đã thay đổi trong Weekdot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此日历为只读。打开日程并轻点“编辑”，即可在Weekdot中保留一份更改后的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此行事曆為唯讀。打開行程並點一下「編輯」，即可在Weekdot中保留一份更改後的拷貝。"
          }
        }
      }
    },
