    "Time until your next event, with a ring that fills up in the last hour.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوقت حتى الحدث التالي، مع حلقة تمتلئ في الساعة الأخيرة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps fins al proper esdeveniment, amb un anell que s’omple l’última hora."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas do další události, s kruhem, který se plní poslední hodinu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid til næste begivenhed med en ring, der fyldes den sidste time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit bis zum nächsten Termin, mit einem Ring, der sich in der letzten Stunde füllt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρόνος έως το επόμενο συμβάν, με δακτύλιο που γεμίζει την τελευταία ώρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo hasta tu próximo evento, con un anillo que se llena en la última hora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aika seuraavaan tapahtumaan, rengas täyttyy viimeisen tunnin aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps avant le prochain événement, avec un anneau qui se remplit la dernière heure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמן עד האירוע הבא, עם טבעת שמתמלאת בשעה האחרונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले इवेंट तक का समय, आखिरी घंटे में भरने वाली रिंग के साथ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijeme do sljedećeg događaja, s prstenom koji se puni u zadnjem satu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Idő a következő eseményig, az utolsó órában telő gyűrűvel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu sampai acara berikutnya, dengan cincin yang terisi di jam terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo al prossimo evento, con un anello che si riempie nell’ultima ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のイベントまでの時間。最後の1時間でリングが満ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 이벤트까지 남은 시간, 마지막 1시간 동안 링이 채워집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa hingga acara seterusnya, dengan cincin yang penuh dalam jam terakhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid til neste hendelse, med en ring som fylles den siste timen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd tot je volgende afspraak, met een ring die zich het laatste uur vult."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas do następnego wydarzenia, z pierścieniem wypełniającym się w ostatniej godzinie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo até o próximo evento, com um anel que enche na última hora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo até ao próximo evento, com um anel que enche na última hora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Timpul până la următorul eveniment, cu un inel care se umple în ultima oră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время до следующего события с кольцом, заполняющимся в последний час."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas do ďalšej udalosti, s kruhom, ktorý sa plní poslednú hodinu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid till nästa händelse, med en ring som fylls den sista timmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาจนถึงกิจกรรมถัดไป พร้อมวงแหวนที่เต็มขึ้นในชั่วโมงสุดท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki etkinliğe kalan süre; son saatte dolan bir halka ile."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час до наступної події з кільцем, що заповнюється в останню годину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian đến sự kiện tiếp theo, với vòng đầy dần trong giờ cuối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离下一个日程的时间，最后一小时内圆环逐渐填满。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "距離下一個行程的時間，最後一小時內圓環逐漸填滿。"
          }
        }
      }
    },
