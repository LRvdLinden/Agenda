          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt később módosíthatja a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat mengubahnya nanti di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi modificare questa scelta in seguito in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定はあとで「設定」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 설정에서 변경할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menukar ini kemudian dalam Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan endre dette senere i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit later wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz to później zmienić w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
