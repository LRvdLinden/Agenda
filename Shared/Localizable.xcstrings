    "No Apple Calendar account can create a calendar. Enable iCloud Calendar or add a writable account.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لأي حساب في تقويم Apple إنشاء تقويم. فعّل تقويم iCloud أو أضف حسابًا قابلًا للكتابة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap compte del Calendari d’Apple pot crear un calendari. Activa el Calendari d’iCloud o afegeix un compte amb permís d’escriptura."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný účet v Kalendáři Apple nemůže vytvořit kalendář. Zapněte kalendář iCloud nebo přidejte účet s možností zápisu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto i Apple Kalender kan oprette en kalender. Slå iCloud-kalender til, eller tilføj en konto med skriveadgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Apple Kalender-Account kann einen Kalender erstellen. Aktiviere iCloud-Kalender oder füge einen beschreibbaren Account hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανένας λογαριασμός του Ημερολογίου Apple δεν μπορεί να δημιουργήσει ημερολόγιο. Ενεργοποιήστε το Ημερολόγιο iCloud ή προσθέστε λογαριασμό με δικαίωμα εγγραφής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna cuenta de Calendario de Apple puede crear un calendario. Activa Calendario de iCloud o añade una cuenta con permisos de escritura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään Applen Kalenterin tili ei voi luoda kalenteria. Ota iCloud-kalenteri käyttöön tai lisää tili, jolla on kirjoitusoikeus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte de Calendrier d’Apple ne peut créer de calendrier. Activez Calendrier iCloud ou ajoutez un compte modifiable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף חשבון בלוח השנה של Apple אינו יכול ליצור לוח שנה. הפעל את לוח השנה של iCloud או הוסף חשבון עם הרשאת כתיבה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी Apple कैलेंडर खाता कैलेंडर नहीं बना सकता। iCloud कैलेंडर चालू करें या लिखने योग्य खाता जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedan račun Apple Kalendara ne može izraditi kalendar. Uključite iCloud Kalendar ili dodajte račun s mogućnošću pisanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyik Apple Naptár-fiók sem tud naptárt létrehozni. Kapcsolja be az iCloud-naptárt, vagy adjon hozzá írható fiókot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada akun Kalender Apple yang dapat membuat kalender. Aktifkan Kalender iCloud atau tambahkan akun yang dapat ditulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account di Calendario di Apple può creare un calendario. Attiva Calendario di iCloud o aggiungi un account scrivibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーを作成できるAppleカレンダーのアカウントがありません。iCloudカレンダーを有効にするか、書き込み可能なアカウントを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더를 생성할 수 있는 Apple 캘린더 계정이 없습니다. iCloud 캘린더를 활성화하거나 쓰기 가능한 계정을 추가하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada akaun Kalendar Apple yang boleh mencipta kalendar. Dayakan Kalendar iCloud atau tambah akaun yang boleh ditulis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto i Apple Kalender kan opprette en kalender. Slå på iCloud-kalender, eller legg til en konto med skrivetilgang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkel Apple Agenda-account kan een agenda aanmaken. Schakel iCloud-agenda in of voeg een beschrijfbaar account toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne konto w Kalendarzu Apple nie może utworzyć kalendarza. Włącz kalendarz iCloud lub dodaj konto z prawem zapisu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta do Calendário da Apple pode criar um calendário. Ative o Calendário do iCloud ou adicione uma conta com permissão de escrita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta do Calendário da Apple pode criar um calendário. Ative o Calendário iCloud ou adicione uma conta com permissão de escrita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun cont din Calendarul Apple nu poate crea un calendar. Activați Calendar iCloud sau adăugați un cont cu drept de scriere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна учетная запись Календаря Apple не может создать календарь. Включите Календарь iCloud или добавьте учетную запись с правом записи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadny účet v Kalendári Apple nemôže vytvoriť kalendár. Zapnite kalendár iCloud alebo pridajte účet s možnosťou zápisu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget konto i Apple Kalender kan skapa en kalender. Aktivera iCloud-kalendern eller lägg till ett konto med skrivbehörighet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีบัญชีปฏิทิน Apple ที่สามารถสร้างปฏิทินได้ เปิดใช้ปฏิทิน iCloud หรือเพิ่มบัญชีที่เขียนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir Apple Takvim hesabı takvim oluşturamıyor. iCloud Takvim’i açın veya yazılabilir bir hesap ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден обліковий запис Календаря Apple не може створити календар. Увімкніть Календар iCloud або додайте обліковий запис із правом запису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có tài khoản Lịch Apple nào có thể tạo lịch. Hãy bật Lịch iCloud hoặc thêm tài khoản có thể ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可创建日历的 Apple 日历账户。请启用 iCloud 日历或添加可写入的账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可製作行事曆的 Apple 行事曆帳號。請啟用 iCloud 行事曆或加入可寫入的帳號。"
          }
        }
      }
    },
