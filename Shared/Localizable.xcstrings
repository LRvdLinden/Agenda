        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn följer språket på din enhet. Du kan välja ett annat språk enbart för Sevn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevn ใช้ภาษาตามอุปกรณ์ของคุณ คุณสามารถเลือกภาษาอื่นสำหรับ Sevn เท่านั้นได้"
