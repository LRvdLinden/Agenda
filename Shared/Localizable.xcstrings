        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ตำแหน่งที่ตั้งโดยประมาณของคุณ ข้อมูลสภาพอากาศให้บริการโดย Apple WeatherKit เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık konumunuzu kullanır. Hava durumu verileri yalnızca Apple WeatherKit tarafından sağlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується ваша приблизна локація. Дані про погоду надає лише Apple WeatherKit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng vị trí gần đúng của bạn. Dữ liệu thời tiết chỉ do Apple WeatherKit cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的大致位置。天气数据仅由 Apple WeatherKit 提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的大略位置。天氣資料僅由 Apple WeatherKit 提供。"
          }
        }
      }
    },
