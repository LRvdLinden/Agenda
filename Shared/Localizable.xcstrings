    "Weekdot calendars sync through iCloud on all your devices with Weekdot.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة تقويمات Weekdot عبر iCloud على جميع أجهزتك التي عليها Weekdot."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els calendaris del Weekdot se sincronitzen amb l’iCloud a tots els teus dispositius amb el Weekdot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendáře Weekdot se synchronizují přes iCloud na všech vašich zařízeních s Weekdotem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot-kalendere synkroniseres via iCloud på alle dine enheder med Weekdot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot-Kalender werden über iCloud auf all deinen Geräten mit Weekdot synchronisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ημερολόγια Weekdot συγχρονίζονται μέσω iCloud σε όλες τις συσκευές σας με το Weekdot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los calendarios de Weekdot se sincronizan mediante iCloud en todos tus dispositivos con Weekdot."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot-kalenterit synkronoituvat iCloudin kautta kaikilla laitteillasi, joilla on Weekdot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calendriers Weekdot se synchronisent via iCloud sur tous vos appareils dotés de Weekdot."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוחות השנה של Weekdot מסתנכרנים דרך iCloud בכל המכשירים שלך שבהם מותקן Weekdot."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot कैलेंडर iCloud के ज़रिए आपके उन सभी डिवाइस पर सिंक होते हैं जिनमें Weekdot है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kalendari sinkroniziraju se putem iCloud-a na svim vašim uređajima s Weekdotom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Weekdot-naptárak az iCloudon keresztül szinkronizálódnak minden olyan eszközén, amelyen a Weekdot fut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender Weekdot diselaraskan melalui iCloud di semua perangkat Anda yang memiliki Weekdot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I calendari Weekdot si sincronizzano tramite iCloud su tutti i tuoi dispositivi con Weekdot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekdotのカレンダーはiCloud経由で、Weekdotを使用しているすべてのデバイスと同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot 캘린더는 iCloud를 통해 Weekdot을 사용하는 모든 기기에서 동기화됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar Weekdot diselaraskan melalui iCloud pada semua peranti anda yang mempunyai Weekdot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot-kalendere synkroniseres via iCloud på alle enhetene dine med Weekdot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot-agenda's synchroniseren via iCloud op al je apparaten met Weekdot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendarze Weekdot są synchronizowane przez iCloud na wszystkich Twoich urządzeniach z Weekdot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os calendários do Weekdot são sincronizados pelo iCloud em todos os seus dispositivos com o Weekdot."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os calendários Weekdot sincronizam através da iCloud em todos os seus dispositivos com o Weekdot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
