    "Please wait for the current subscription to finish.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرجى الانتظار حتى ينتهي الاشتراك الحالي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera que acabi la subscripció actual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počkejte, až se dokončí aktuální odběr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent, til det aktuelle abonnement er færdigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte warte, bis das aktuelle Abo abgeschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιμένετε να ολοκληρωθεί η τρέχουσα συνδρομή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine la suscripción actual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odota, kunnes nykyinen tilaus on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez patienter jusqu’à la fin de l’abonnement en cours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המתן לסיום המינוי הנוכחי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया मौजूदा सब्सक्रिप्शन पूरा होने तक प्रतीक्षा करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pričekajte da se trenutačna pretplata dovrši."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Várjon, amíg a jelenlegi előfizetés befejeződik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harap tunggu hingga langganan saat ini selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi il completamento dell’iscrizione in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の照会が完了するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 구독이 완료될 때까지 기다리십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila tunggu langganan semasa selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent til det gjeldende abonnementet er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot het huidige abonnement is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na zakończenie bieżącej subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a conclusão da assinatura atual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a conclusão da subscrição atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așteptați finalizarea abonamentului curent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь завершения текущей подписки."
          }
        },
        "sk": {
