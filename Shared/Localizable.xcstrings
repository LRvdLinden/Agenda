    "The calendars that are visible now are saved in this set.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ التقويمات الظاهرة الآن في هذه المجموعة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els calendaris visibles ara es desen en aquest conjunt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendáře, které jsou teď viditelné, se uloží do této sady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De kalendere, der er synlige nu, gemmes i dette sæt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuell sichtbaren Kalender werden in diesem Set gesichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ημερολόγια που είναι ορατά τώρα αποθηκεύονται σε αυτό το σύνολο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los calendarios visibles ahora se guardan en este grupo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyt näkyvät kalenterit tallennetaan tähän joukkoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calendriers actuellement visibles sont enregistrés dans cet ensemble."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוחות השנה שמוצגים כעת נשמרים בקבוצה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी दिखाई दे रहे कैलेंडर इस सेट में सहेजे जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendari koji su sada vidljivi spremaju se u ovaj skup."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelenleg látható naptárak ebbe a csoportba mentődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender yang terlihat sekarang disimpan di set ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I calendari visibili ora vengono salvati in questo set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在表示されているカレンダーがこのセットに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 보이는 캘린더가 이 세트에 저장됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar yang kelihatan sekarang disimpan dalam set ini."
          }
