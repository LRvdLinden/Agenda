    "De afvalophaler heeft de gegevens gewijzigd; automatisch verversen lukt tijdelijk niet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّرت خدمة جمع النفايات بياناتها؛ التحديث التلقائي متوقف مؤقتًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servei de recollida ha canviat les dades; l’actualització automàtica no és possible temporalment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svozová společnost změnila svá data; automatické obnovení dočasně nefunguje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Affaldsindsamleren har ændret sine data; automatisk opdatering er midlertidigt ikke mulig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entsorger hat seine Daten geändert; die automatische Aktualisierung ist vorübergehend nicht möglich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η υπηρεσία αποκομιδής άλλαξε τα δεδομένα της· η αυτόματη ανανέωση δεν λειτουργεί προσωρινά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de recogida ha cambiado sus datos; la actualización automática no es posible temporalmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätehuoltoyhtiö on muuttanut tietojaan; automaattinen päivitys ei tilapäisesti onnistu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le collecteur de déchets a modifié ses données ; l’actualisation automatique est temporairement impossible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות פינוי האשפה שינה את הנתונים שלו; הרענון האוטומטי אינו פועל זמנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कचरा संग्रहकर्ता ने अपना डेटा बदल दिया है; स्वचालित रीफ़्रेश अस्थायी रूप से काम नहीं कर रहा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Služba za odvoz otpada promijenila je podatke; automatsko osvježavanje privremeno ne radi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hulladékszállító módosította az adatait; az automatikus frissítés átmenetileg nem lehetséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengangkut sampah telah mengubah datanya; penyegaran otomatis untuk sementara tidak berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gestore rifiuti ha modificato i dati; l’aggiornamento automatico è temporaneamente impossibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ごみ収集業者のデータが変更されたため、一時的に自動更新できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰레기 수거 업체의 데이터가 변경되어 일시적으로 자동 새로 고침을 할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengutip sampah telah menukar datanya; penyegaran automatik tidak berfungsi buat sementara waktu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Renovatøren har endret dataene sine; automatisk oppdatering fungerer midlertidig ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afvalophaler heeft de gegevens gewijzigd; automatisch verversen lukt tijdelijk niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Firma odbierająca odpady zmieniła swoje dane; automatyczne odświeżanie jest tymczasowo niemożliwe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A empresa de coleta alterou os dados; a atualização automática está temporariamente indisponível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A entidade de recolha alterou os dados; a atualização automática não é possível temporariamente."
          }
        },
        "ro": {
