    "This week and the next two, darker on busier days.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الأسبوع والأسبوعان التاليان، أغمق في الأيام المزدحمة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta setmana i les dues següents, més fosc els dies plens."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento týden a dva další, tmavší v rušných dnech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne uge og de næste to, mørkere på travle dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese und die nächsten zwei Wochen, dunkler an vollen Tagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η εβδομάδα και οι δύο επόμενες, πιο σκούρο τις γεμάτες μέρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana y las dos siguientes, más oscuro los días ocupados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä viikko ja kaksi seuraavaa, tummempi kiireisinä päivinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette semaine et les deux suivantes, plus foncé les jours chargés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השבוע ושני השבועות הבאים, כהה יותר בימים עמוסים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सप्ताह और अगले दो, व्यस्त दिनों में गहरा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj tjedan i sljedeća dva, tamnije u zauzetim danima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a hét és a következő kettő, sötétebb a zsúfolt napokon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minggu ini dan dua minggu berikutnya, lebih gelap di hari sibuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa settimana e le due successive, più scuro nei giorni pieni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週と次の2週間。予定が多い日ほど濃く表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주와 다음 2주, 바쁜 날일수록 진하게"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minggu ini dan dua minggu seterusnya, lebih gelap pada hari sibuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne uken og de to neste, mørkere på travle dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze week en de twee volgende, donkerder op drukke dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tydzień i dwa kolejne, ciemniej w pracowite dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana e as próximas duas, mais escuro nos dias cheios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana e as duas seguintes, mais escuro nos dias cheios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Săptămâna aceasta și următoarele două, mai închis în zilele aglomerate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта неделя и две следующие, темнее в загруженные дни."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento týždeň a dva ďalšie, tmavšie v rušných dňoch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här veckan och de två nästa, mörkare på fullbokade dagar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัปดาห์นี้และอีกสองสัปดาห์ถัดไป สีเข้มขึ้นในวันที่ยุ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta ve sonraki iki hafta, yoğun günlerde daha koyu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей тиждень і два наступні, темніше в зайняті дні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuần này và hai tuần tới, đậm hơn vào ngày bận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周及之后两周，越忙的日子颜色越深。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週及之後兩週，越忙的日子顏色越深。"
          }
        }
      }
    },
