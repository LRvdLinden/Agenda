    "Uses your approximate location. Forecast by Open-Meteo.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم موقعك التقريبي. التوقعات من Open-Meteo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza la teva ubicació aproximada. Previsió d’Open-Meteo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá vaši přibližnou polohu. Předpověď od Open-Meteo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger din omtrentlige placering. Vejrudsigt fra Open-Meteo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet deinen ungefähren Standort. Vorhersage von Open-Meteo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιεί την κατά προσέγγιση τοποθεσία σας. Πρόγνωση από Open-Meteo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu ubicación aproximada. Previsión de Open-Meteo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttää likimääräistä sijaintiasi. Ennuste: Open-Meteo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise votre position approximative. Prévisions par Open-Meteo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש במיקום המשוער שלך. התחזית מ‑Open-Meteo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके अनुमानित स्थान का उपयोग करता है। पूर्वानुमान Open-Meteo द्वारा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi vašu približnu lokaciju. Prognoza: Open-Meteo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hozzávetőleges helyzetét használja. Előrejelzés: Open-Meteo."
