        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot 使用“日历”App 中的账户。只需添加一次 Google、Outlook、Exchange、Yahoo 或 CalDAV，其所有日历都会自动出现在 Weekdot 中。"
          }
