    "The linked Apple Calendar calendar no longer exists. Remove and subscribe again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقويم المرتبط في تقويم Apple لم يعد موجودًا. أزله واشترك مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendari vinculat del Calendari d’Apple ja no existeix. Elimina’l i torna-t’hi a subscriure."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Propojený kalendář v Kalendáři Apple už neexistuje. Odstraňte ho a začněte ho znovu odebírat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den tilknyttede kalender i Apple Kalender findes ikke længere. Fjern den, og abonner igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verknüpfte Kalender in Apple Kalender existiert nicht mehr. Entferne das Abo und abonniere erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το συνδεδεμένο ημερολόγιο στο Ημερολόγιο Apple δεν υπάρχει πλέον. Αφαιρέστε το και εγγραφείτε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario vinculado de Calendario de Apple ya no existe. Elimínalo y vuelve a suscribirte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkitettyä kalenteria ei enää ole Applen Kalenterissa. Poista ja tilaa uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier lié dans Calendrier d’Apple n’existe plus. Supprimez l’abonnement et abonnez-vous à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוח השנה המקושר בלוח השנה של Apple כבר לא קיים. הסר והירשם מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक किया गया Apple कैलेंडर अब मौजूद नहीं है। हटाएँ और फिर से सब्सक्राइब करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezani kalendar u Apple Kalendaru više ne postoji. Uklonite ga i ponovno se pretplatite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolt Apple Naptár-naptár már nem létezik. Távolítsa el, és fizessen elő újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender tertaut di Kalender Apple sudah tidak ada. Hapus dan berlangganan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il calendario collegato in Calendario di Apple non esiste più. Rimuovilo e iscriviti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクされたAppleカレンダーのカレンダーが存在しません。削除してからもう一度照会してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 Apple 캘린더가 더 이상 존재하지 않습니다. 제거한 후 다시 구독하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar yang dipautkan dalam Kalendar Apple tidak lagi wujud. Alih keluar dan langgan semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den koblede kalenderen i Apple Kalender finnes ikke lenger. Fjern og abonner på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gekoppelde Apple-agenda bestaat niet meer. Verwijder het abonnement en abonneer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiązany kalendarz w Kalendarzu Apple już nie istnieje. Usuń go i subskrybuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário vinculado no Calendário da Apple não existe mais. Remova e assine novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário associado no Calendário da Apple já não existe. Remova-o e subscreva novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendarul asociat din Calendarul Apple nu mai există. Eliminați-l și abonați-vă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связанный календарь в Календаре Apple больше не существует. Удалите подписку и оформите ее снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepojený kalendár v Kalendári Apple už neexistuje. Odstráňte ho a začnite ho znova odoberať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den länkade kalendern i Apple Kalender finns inte längre. Ta bort och prenumerera igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินที่ลิงก์ไว้ในปฏิทิน Apple ไม่มีอยู่แล้ว ให้เอาออกแล้วสมัครรับอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantılı Apple Takvim takvimi artık mevcut değil. Kaldırıp yeniden abone olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пов’язаного календаря в Календарі Apple більше не існує. Вилучіть підписку й оформіть її знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch được liên kết trong Lịch Apple không còn tồn tại. Hãy xóa và đăng ký lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联的 Apple 日历已不存在。请移除后重新订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結的 Apple 行事曆已不存在。請移除後重新訂閱。"
          }
        }
      }
    },
    "The live directory is unavailable right now. The featured calendars remain available.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدليل المباشر غير متاح حاليًا. تظل التقويمات المميزة متاحة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El directori en directe no està disponible ara mateix. Els calendaris destacats continuen disponibles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živý katalog je momentálně nedostupný. Doporučené kalendáře zůstávají k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-kataloget er ikke tilgængeligt lige nu. De udvalgte kalendere er stadig tilgængelige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Live-Verzeichnis ist gerade nicht verfügbar. Die empfohlenen Kalender bleiben verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ζωντανός κατάλογος δεν είναι διαθέσιμος αυτή τη στιγμή. Τα προτεινόμενα ημερολόγια παραμένουν διαθέσιμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El directorio en directo no está disponible ahora mismo. Los calendarios destacados siguen disponibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-hakemisto ei ole juuri nyt käytettävissä. Esittelyssä olevat kalenterit ovat edelleen saatavilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’annuaire en direct est indisponible pour le moment. Les calendriers à la une restent disponibles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המדריך החי אינו זמין כרגע. לוחות השנה המומלצים נשארים זמינים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव डायरेक्टरी अभी उपलब्ध नहीं है। फ़ीचर्ड कैलेंडर उपलब्ध रहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Živi imenik trenutačno nije dostupan. Istaknuti kalendari i dalje su dostupni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az élő katalógus jelenleg nem érhető el. A kiemelt naptárak továbbra is elérhetők."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktori langsung saat ini tidak tersedia. Kalender unggulan tetap tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La directory in tempo reale non è disponibile al momento. I calendari in evidenza restano disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブディレクトリは現在利用できません。注目のカレンダーは引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 실시간 디렉토리를 사용할 수 없습니다. 추천 캘린더는 계속 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktori langsung tidak tersedia pada masa ini. Kalendar pilihan masih tersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-katalogen er ikke tilgjengelig akkurat nå. De utvalgte kalenderne er fortsatt tilgjengelige."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De live catalogus is momenteel niet beschikbaar. De uitgelichte agenda's blijven beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog na żywo jest teraz niedostępny. Polecane kalendarze pozostają dostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diretório ao vivo não está disponível no momento. Os calendários em destaque continuam disponíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O diretório em direto não está disponível de momento. Os calendários em destaque continuam disponíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Directorul live nu este disponibil momentan. Calendarele recomandate rămân disponibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живой каталог сейчас недоступен. Рекомендуемые календари по-прежнему доступны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Živý katalóg je momentálne nedostupný. Odporúčané kalendáre zostávajú k dispozícii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-katalogen är inte tillgänglig just nu. De utvalda kalendrarna finns fortfarande kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไดเรกทอรีแบบสดไม่พร้อมใช้งานในขณะนี้ ปฏิทินแนะนำยังคงใช้งานได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı dizin şu anda kullanılamıyor. Öne çıkan takvimler kullanılabilir olmaya devam ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Живий каталог зараз недоступний. Рекомендовані календарі й надалі доступні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh bạ trực tiếp hiện không khả dụng. Các lịch nổi bật vẫn có sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时目录当前不可用。精选日历仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法使用即時目錄。精選行事曆仍可使用。"
          }
        }
      }
    },
    "The name of this calendar can't be changed here. The colour is kept by Weekdot.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تغيير اسم هذا التقويم هنا. يحتفظ Weekdot باللون."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El nom d’aquest calendari no es pot canviar aquí. El Weekdot conserva el color."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název tohoto kalendáře zde nelze změnit. Barvu si pamatuje Weekdot."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet på denne kalender kan ikke ændres her. Farven bevares af Weekdot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name dieses Kalenders kann hier nicht geändert werden. Die Farbe wird von Weekdot gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα αυτού του ημερολογίου δεν μπορεί να αλλάξει εδώ. Το χρώμα διατηρείται από το Weekdot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de este calendario no se puede cambiar aquí. Weekdot conserva el color."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän kalenterin nimeä ei voi muuttaa täällä. Weekdot säilyttää värin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de ce calendrier ne peut pas être modifié ici. La couleur est conservée par Weekdot."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשנות כאן את שם לוח השנה הזה. הצבע נשמר ב-Weekdot."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कैलेंडर का नाम यहाँ नहीं बदला जा सकता। रंग Weekdot द्वारा रखा जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naziv ovog kalendara ne može se ovdje promijeniti. Boju čuva Weekdot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A naptár neve itt nem módosítható. A színét a Weekdot megőrzi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama kalender ini tidak dapat diubah di sini. Warnanya disimpan oleh Weekdot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome di questo calendario non può essere modificato qui. Il colore viene mantenuto da Weekdot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカレンダーの名前はここでは変更できません。カラーはWeekdotで保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 캘린더의 이름은 여기에서 변경할 수 없습니다. 색상은 Weekdot에서 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama kalendar ini tidak boleh ditukar di sini. Warnanya disimpan oleh Weekdot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet på denne kalenderen kan ikke endres her. Fargen beholdes av Weekdot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam van deze agenda kan hier niet worden gewijzigd. De kleur wordt door Weekdot bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy tego kalendarza nie można tu zmienić. Kolor jest zachowywany przez Weekdot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome deste calendário não pode ser alterado aqui. A cor é mantida pelo Weekdot."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome deste calendário não pode ser alterado aqui. A cor é mantida pelo Weekdot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele acestui calendar nu poate fi modificat aici. Culoarea este păstrată de Weekdot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название этого календаря нельзя изменить здесь. Цвет сохраняется в Weekdot."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
