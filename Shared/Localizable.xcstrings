    "1. Open Circulus and enter your postcode and house number.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Open Circulus en vul je postcode en huisnummer in."
          }
        }
      }
    },
    "2. In your personal waste calendar, tap Import Waste Calendar to download the .ics file.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Tik in je persoonlijke afvalkalender op Importeer afvalkalender om het .ics-bestand te downloaden."
          }
        }
      }
    },
    "3. Return to Weekdot and import the downloaded file from Files or Downloads.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Ga terug naar Weekdot en importeer het bestand uit Bestanden of Downloads."
          }
        }
      }
    },
    "A live feed stays up to date through Apple Calendar. If a provider only offers a downloaded .ics file, import that file in Apple Calendar instead.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot ververst live-abonnementen tijdens gebruik. Een gedownload .ics-bestand wordt eenmalig geïmporteerd."
          }
        }
      }
    },
