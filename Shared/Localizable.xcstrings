    },
    "Weekdot copies the events to a separate writable Apple calendar. It checks for changes when opened and during background refresh opportunities, which iOS does not guarantee.": {
      "extractionState": "manual",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot kopieert afspraken naar een eigen beschrijfbare Apple-agenda. Updates worden gecontroleerd bij het openen en tijdens toegestane achtergrondmomenten; iOS garandeert die momenten niet."
          }
        }
      }
    },
    "Weekdot follows the language of your device. Choose another language in System Settings › General › Language & Region › Applications.": {
