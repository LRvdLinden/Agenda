    "Start Flows when an event begins or ends, before an appointment, or with today's agenda.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل تدفقات عند بدء موعد أو انتهائه، أو قبل موعد، أو مع جدول اليوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia Flows quan un esdeveniment comença o acaba, abans d'una cita o amb l'agenda del dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spouštěj Flow, když událost začíná nebo končí, před schůzkou nebo s programem dne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Flows, når en begivenhed starter eller slutter, før en aftale eller med dagens program."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Flows, wenn ein Termin beginnt oder endet, vor einem Termin oder mit der Tagesübersicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκίνα Flows όταν ένα γεγονός αρχίζει ή τελειώνει, πριν από ένα ραντεβού ή με το πρόγραμμα της ημέρας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia Flows cuando empieza o termina un evento, antes de una cita o con la agenda del día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistä Flowt, kun tapahtuma alkaa tai päättyy, ennen tapaamista tai päivän ohjelman kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez des Flows quand un événement commence ou se termine, avant un rendez-vous ou avec l'agenda du jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל Flows כשאירוע מתחיל או נגמר, לפני פגישה או עם סדר היום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इवेंट शुरू या खत्म होने पर, किसी अपॉइंटमेंट से पहले या आज के एजेंडा के साथ Flows चलाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreći Flowove kad događaj počne ili završi, prije sastanka ili s dnevnim rasporedom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indíts Flow-kat, amikor egy esemény kezdődik vagy véget ér, egy találkozó előtt vagy a napi programmal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan Flow saat acara dimulai atau berakhir, sebelum janji, atau dengan agenda hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia Flow quando un evento inizia o finisce, prima di un appuntamento o con l'agenda del giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定の開始・終了時、予定の前、または今日の予定でFlowを開始できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정이 시작되거나 끝날 때, 약속 전에, 또는 오늘 일정으로 Flow를 시작하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan Flow apabila acara bermula atau tamat, sebelum temu janji, atau dengan agenda hari ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Flows når en avtale starter eller slutter, før en avtale eller med dagens agenda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Flows als een afspraak begint of eindigt, voor een afspraak, of met je dagagenda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamiaj Flow, gdy wydarzenie się zaczyna lub kończy, przed spotkaniem albo z planem dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie Flows quando um evento começa ou termina, antes de um compromisso ou com a agenda do dia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie Flows quando um evento começa ou termina, antes de um compromisso ou com a agenda do dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește Flow-uri când un eveniment începe sau se termină, înainte de o întâlnire sau cu agenda zilei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте Flow, когда событие начинается или заканчивается, перед встречей или с планом на день."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spúšťaj Flow, keď udalosť začína alebo končí, pred stretnutím alebo s programom dňa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta Flows när en händelse börjar eller slutar, före ett möte eller med dagens agenda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่ม Flow เมื่อกิจกรรมเริ่มหรือสิ้นสุด ก่อนนัดหมาย หรือด้วยกำหนดการวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir etkinlik başladığında veya bittiğinde, bir randevudan önce ya da günün programıyla Flow başlat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте Flow, коли подія починається чи закінчується, перед зустріччю або з планом на день."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy Flow khi sự kiện bắt đầu hoặc kết thúc, trước cuộc hẹn hoặc với lịch trình hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在日程开始或结束时、约会前或根据今日日程启动 Flow。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在行程開始或結束時、約會前或依今日行程啟動 Flow。"
          }
        }
      }
    },
