          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการเก็บขยะได้เปลี่ยนแปลงข้อมูล จึงไม่สามารถรีเฟรชอัตโนมัติได้ชั่วคราว"
