        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當行程變更、開啟 App 時以及偶爾在背景中，Weekdot 會更新 Homey。"
          }
        }
      }
    },
    "Weekdot uses the accounts of the Calendar app. Add Google, Outlook, Exchange, Yahoo or CalDAV once and all its calendars appear in Weekdot automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Weekdot حسابات تطبيق التقويم. أضف Google أو Outlook أو Exchange أو Yahoo أو CalDAV مرة واحدة وستظهر كل تقويماته في Weekdot تلقائيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Weekdot utilitza els comptes de l’app Calendari. Afegeix Google, Outlook, Exchange, Yahoo o CalDAV una vegada i tots els seus calendaris apareixeran automàticament al Weekdot."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot používá účty aplikace Kalendář. Přidejte jednou Google, Outlook, Exchange, Yahoo nebo CalDAV a všechny jejich kalendáře se v Weekdot objeví automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot bruger kontiene fra appen Kalender. Tilføj Google, Outlook, Exchange, Yahoo eller CalDAV én gang, så vises alle kalenderne automatisk i Weekdot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot verwendet die Accounts der App „Kalender“. Füge Google, Outlook, Exchange, Yahoo oder CalDAV einmal hinzu und alle zugehörigen Kalender erscheinen automatisch in Weekdot."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Weekdot χρησιμοποιεί τους λογαριασμούς της εφαρμογής Ημερολόγιο. Προσθέστε μία φορά Google, Outlook, Exchange, Yahoo ή CalDAV και όλα τα ημερολόγιά του εμφανίζονται αυτόματα στο Weekdot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot usa las cuentas de la app Calendario. Añade Google, Outlook, Exchange, Yahoo o CalDAV una vez y todos sus calendarios aparecerán automáticamente en Weekdot."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot käyttää Kalenteri-apin tilejä. Lisää Google, Outlook, Exchange, Yahoo tai CalDAV kerran, niin kaikki sen kalenterit näkyvät Weekdotissä automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot utilise les comptes de l’app Calendrier. Ajoutez Google, Outlook, Exchange, Yahoo ou CalDAV une fois et tous ses calendriers apparaissent automatiquement dans Weekdot."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot משתמש בחשבונות של האפליקציה ״לוח שנה״. הוסף/י את Google,‏ Outlook,‏ Exchange,‏ Yahoo או CalDAV פעם אחת וכל לוחות השנה שלהם יופיעו ב‑Weekdot באופן אוטומטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot कैलेंडर ऐप के अकाउंट का उपयोग करता है। Google, Outlook, Exchange, Yahoo या CalDAV एक बार जोड़ें और उसके सभी कैलेंडर Weekdot में अपने आप दिखाई देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot koristi račune aplikacije Kalendar. Jednom dodajte Google, Outlook, Exchange, Yahoo ili CalDAV i svi njegovi kalendari automatski se pojavljuju u Weekdotu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Weekdot a Naptár app fiókjait használja. Adja hozzá egyszer a Google, Outlook, Exchange, Yahoo vagy CalDAV fiókot, és minden naptára automatikusan megjelenik a Weekdotben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot menggunakan akun dari app Kalender. Tambahkan Google, Outlook, Exchange, Yahoo, atau CalDAV sekali dan semua kalendernya otomatis muncul di Weekdot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot usa gli account dell’app Calendario. Aggiungi Google, Outlook, Exchange, Yahoo o CalDAV una volta e tutti i relativi calendari appaiono automaticamente in Weekdot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WeekdotはカレンダーAppのアカウントを使用します。Google、Outlook、Exchange、Yahoo、CalDAVを一度追加するだけで、そのすべてのカレンダーが自動的にWeekdotに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot은 캘린더 앱의 계정을 사용합니다. Google, Outlook, Exchange, Yahoo 또는 CalDAV를 한 번 추가하면 모든 캘린더가 자동으로 Weekdot에 나타납니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot menggunakan akaun app Kalendar. Tambah Google, Outlook, Exchange, Yahoo atau CalDAV sekali dan semua kalendarnya muncul dalam Weekdot secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot bruker kontoene i Kalender-appen. Legg til Google, Outlook, Exchange, Yahoo eller CalDAV én gang, så vises alle kalenderne automatisk i Weekdot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot gebruikt de accounts van de Agenda-app. Voeg Google, Outlook, Exchange, Yahoo of CalDAV één keer toe en alle bijbehorende agenda's verschijnen automatisch in Weekdot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot korzysta z kont aplikacji Kalendarz. Dodaj raz Google, Outlook, Exchange, Yahoo lub CalDAV, a wszystkie kalendarze pojawią się automatycznie w Weekdot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Weekdot usa as contas do app Calendário. Adicione Google, Outlook, Exchange, Yahoo ou CalDAV uma vez e todos os calendários aparecerão no Weekdot automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Weekdot usa as contas da app Calendário. Adicione Google, Outlook, Exchange, Yahoo ou CalDAV uma vez e todos os respetivos calendários aparecem automaticamente no Weekdot."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot folosește conturile aplicației Calendar. Adăugați o dată Google, Outlook, Exchange, Yahoo sau CalDAV și toate calendarele sale apar automat în Weekdot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdot использует учетные записи приложения «Календарь». Добавьте Google, Outlook, Exchange, Yahoo или CalDAV один раз, и все их календари автоматически появятся в Weekdot."
          }
